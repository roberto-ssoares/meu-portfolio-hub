-w.png 720w, https://miro.medium.com/v2/resize:fit:750/format:webp/1*Q70XIppoaFSSmAKkSTmq-w.png 750w, https://miro.medium.com/v2/resize:fit:786/format:webp/1*Q70XIppoaFSSmAKkSTmq-w.png 786w, https://miro.medium.com/v2/resize:fit:828/format:webp/1*Q70XIppoaFSSmAKkSTmq-w.png 828w, https://miro.medium.com/v2/resize:fit:1100/format:webp/1*Q70XIppoaFSSmAKkSTmq-w.png 1100w, https://miro.medium.com/v2/resize:fit:4320/format:webp/1*Q70XIppoaFSSmAKkSTmq-w.png 4320w" sizes="(min-resolution: 4dppx) and (max-width: 700px) 50vw, (-webkit-min-device-pixel-ratio: 4) and (max-width: 700px) 50vw, (min-resolution: 3dppx) and (max-width: 700px) 67vw, (-webkit-min-device-pixel-ratio: 3) and (max-width: 700px) 65vw, (min-resolution: 2.5dppx) and (max-width: 700px) 80vw, (-webkit-min-device-pixel-ratio: 2.5) and (max-width: 700px) 80vw, (min-resolution: 2dppx) and (max-width: 700px) 100vw, (-webkit-min-device-pixel-ratio: 2) and (max-width: 700px) 100vw, 2160px" type="image/webp"/><source data-testid="og" srcSet="https://miro.medium.com/v2/resize:fit:640/1*Q70XIppoaFSSmAKkSTmq-w.png 640w, https://miro.medium.com/v2/resize:fit:720/1*Q70XIppoaFSSmAKkSTmq-w.png 720w, https://miro.medium.com/v2/resize:fit:750/1*Q70XIppoaFSSmAKkSTmq-w.png 750w, https://miro.medium.com/v2/resize:fit:786/1*Q70XIppoaFSSmAKkSTmq-w.png 786w, https://miro.medium.com/v2/resize:fit:828/1*Q70XIppoaFSSmAKkSTmq-w.png 828w, https://miro.medium.com/v2/resize:fit:1100/1*Q70XIppoaFSSmAKkSTmq-w.png 1100w, https://miro.medium.com/v2/resize:fit:4320/1*Q70XIppoaFSSmAKkSTmq-w.png 4320w" sizes="(min-resolution: 4dppx) and (max-width: 700px) 50vw, (-webkit-min-device-pixel-ratio: 4) and (max-width: 700px) 50vw, (min-resolution: 3dppx) and (max-width: 700px) 67vw, (-webkit-min-device-pixel-ratio: 3) and (max-width: 700px) 65vw, (min-resolution: 2.5dppx) and (max-width: 700px) 80vw, (-webkit-min-device-pixel-ratio: 2.5) and (max-width: 700px) 80vw, (min-resolution: 2dppx) and (max-width: 700px) 100vw, (-webkit-min-device-pixel-ratio: 2) and (max-width: 700px) 100vw, 2160px"/><img alt="" class="bd ln mj c" width="2160" height="1350" loading="eager" role="presentation"/></picture></figure></div><div class="v cf"><div class="cm bd ga gb gc gd"><blockquote class="mk ml mm"><p id="678f" class="mn mo mp mq b mr ms mt mu mv mw mx my mz na nb nc nd ne nf ng nh ni nj nk nl go bg"><strong class="mq gw">Introduction and Overview of the Problem</strong></p></blockquote><p id="b8ec" class="pw-post-body-paragraph mn mo gv mq b mr ms mt mu mv mw mx my mz na nb nc nd ne nf ng nh ni nj nk nl go bg">Web Traffic Forecasting is a problem of forecasting the future page views that we can receive for given Wikipedia articles. The prediction to be carried out based on the available time series data. The data for this problem can be downloaded from <a class="z nm" href="https://www.kaggle.com/c/web-traffic-time-series-forecasting/data" rel="noopener ugc nofollow" target="_blank">here</a>.</p><figure class="nq nr ns nt nu md nn no paragraph-image"><div class="nn no np"><picture><source srcSet="https://miro.medium.com/v2/resize:fit:640/format:webp/1*ZFJjARAbXLKKC7Kjv8q9wQ.jpeg 640w, https://miro.medium.com/v2/resize:fit:720/format:webp/1*ZFJjARAbXLKKC7Kjv8q9wQ.jpeg 720w, https://miro.medium.com/v2/resize:fit:750/format:webp/1*ZFJjARAbXLKKC7Kjv8q9wQ.jpeg 750w, https://miro.medium.com/v2/resize:fit:786/format:webp/1*ZFJjARAbXLKKC7Kjv8q9wQ.jpeg 786w, https://miro.medium.com/v2/resize:fit:828/format:webp/1*ZFJjARAbXLKKC7Kjv8q9wQ.jpeg 828w, https://miro.medium.com/v2/resize:fit:1100/format:webp/1*ZFJjARAbXLKKC7Kjv8q9wQ.jpeg 1100w, https://miro.medium.com/v2/resize:fit:654/format:webp/1*ZFJjARAbXLKKC7Kjv8q9wQ.jpeg 654w" sizes="(min-resolution: 4dppx) and (max-width: 700px) 50vw, (-webkit-min-device-pixel-ratio: 4) and (max-width: 700px) 50vw, (min-resolution: 3dppx) and (max-width: 700px) 67vw, (-webkit-min-device-pixel-ratio: 3) and (max-width: 700px) 65vw, (min-resolution: 2.5dppx) and (max-width: 700px) 80vw, (-webkit-min-device-pixel-ratio: 2.5) and (max-width: 700px) 80vw, (min-resolution: 2dppx) and (max-width: 700px) 100vw, (-webkit-min-device-pixel-ratio: 2) and (max-width: 700px) 100vw, 327px" type="image/webp"/><source data-testid="og" srcSet="https://miro.medium.com/v2/resize:fit:640/1*ZFJjARAbXLKKC7Kjv8q9wQ.jpeg 640w, https://miro.medium.com/v2/resize:fit:720/1*ZFJjARAbXLKKC7Kjv8q9wQ.jpeg 720w, https://miro.medium.com/v2/resize:fit:750/1*ZFJjARAbXLKKC7Kjv8q9wQ.jpeg 750w, https://miro.medium.com/v2/resize:fit:786/1*ZFJjARAbXLKKC7Kjv8q9wQ.jpeg 786w, https://miro.medium.com/v2/resize:fit:828/1*ZFJjARAbXLKKC7Kjv8q9wQ.jpeg 828w, https://miro.medium.com/v2/resize:fit:1100/1*ZFJjARAbXLKKC7Kjv8q9wQ.jpeg 1100w, https://miro.medium.com/v2/resize:fit:654/1*ZFJjARAbXLKKC7Kjv8q9wQ.jpeg 654w" sizes="(min-resolution: 4dppx) and (max-width: 700px) 50vw, (-webkit-min-device-pixel-ratio: 4) and (max-width: 700px) 50vw, (min-resolution: 3dppx) and (max-width: 700px) 67vw, (-webkit-min-device-pixel-ratio: 3) and (max-width: 700px) 65vw, (min-resolution: 2.5dppx) and (max-width: 700px) 80vw, (-webkit-min-device-pixel-ratio: 2.5) and (max-width: 700px) 80vw, (min-resolution: 2dppx) and (max-width: 700px) 100vw, (-webkit-min-device-pixel-ratio: 2) and (max-width: 700px) 100vw, 327px"/><img alt="" class="bd ln mj c" width="327" height="216" loading="lazy" role="presentation"/></picture></div><figcaption class="nv nw nx nn no ny nz bb b bc u eb">Forecasting Page Views of articles</figcaption></figure><p id="0a20" class="pw-post-body-paragraph mn mo gv mq b mr ms mt mu mv mw mx my mz na nb nc nd ne nf ng nh ni nj nk nl go bg">In this problem, we are provided with Page Views of approx. 145k Wikipedia articles. Our goal is to forecast the Page Views for these articles for future timestamps. Let’s understand about the data from Exploratory Data Analysis (EDA).</p></div></div></div><div class="v cf oa ob oc od" role="separator"><span class="oe bu bi of og oh"></span><span class="oe bu bi of og oh"></span><span class="oe bu bi of og"></span></div><div class="go gp gq gr gs"><div class="v cf"><div class="cm bd ga gb gc gd"><blockquote class="mk ml mm"><p id="b869" class="mn mo mp mq b mr ms mt mu mv mw mx my mz na nb nc nd ne nf ng nh ni nj nk nl go bg"><strong class="mq gw"><em class="gv">Exploratory Data Analysis (EDA) :</em></strong></p></blockquote><p id="7335" class="pw-post-body-paragraph mn mo gv mq b mr ms mt mu mv mw mx my mz na nb nc nd ne nf ng nh ni nj nk nl go bg">With <strong class="mq gw"><em class="mp">Train_*.csv</em></strong> being the base file in this problem, we are given information about Page Name and it’s Page View for given dates.</p><figure class="nq nr ns nt nu md nn no paragraph-image"><div class="nn no oi"><picture><source srcSet="https://miro.medium.com/v2/resize:fit:640/format:webp/1*S05PDbGcWJguyW3EGw_mMw.png 640w, https://miro.medium.com/v2/resize:fit:720/format:webp/1*S05PDbGcWJguyW3EGw_mMw.png 720w, https://miro.medium.com/v2/resize:fit:750/format:webp/1*S05PDbGcWJguyW3EGw_mMw.png 750w, https://miro.medium.com/v2/resize:fit:786/format:webp/1*S05PDbGcWJguyW3EGw_mMw.png 786w, https://miro.medium.com/v2/resize:fit:828/format:webp/1*S05PDbGcWJguyW3EGw_mMw.png 828w, https://miro.medium.com/v2/resize:fit:1100/format:webp/1*S05PDbGcWJguyW3EGw_mMw.png 1100w, https://miro.medium.com/v2/resize:fit:1210/format:webp/1*S05PDbGcWJguyW3EGw_mMw.png 1210w" sizes="(min-resolution: 4dppx) and (max-width: 700px) 50vw, (-webkit-min-device-pixel-ratio: 4) and (max-width: 700px) 50vw, (min-resolution: 3dppx) and (max-width: 700px) 67vw, (-webkit-min-device-pixel-ratio: 3) and (max-width: 700px) 65vw, (min-resolution: 2.5dppx) and (max-width: 700px) 80vw, (-webkit-min-device-pixel-ratio: 2.5) and (max-width: 700px) 80vw, (min-resolution: 2dppx) and (max-width: 700px) 100vw, (-webkit-min-device-pixel-ratio: 2) and (max-width: 700px) 100vw, 605px" type="image/webp"/><source data-testid="og" srcSet="https://miro.medium.com/v2/resize:fit:640/1*S05PDbGcWJguyW3EGw_mMw.png 640w, https://miro.medium.com/v2/resize:fit:720/1*S05PDbGcWJguyW3EGw_mMw.png 720w, https://miro.medium.com/v2/resize:fit:750/1*S05PDbGcWJguyW3EGw_mMw.png 750w, https://miro.medium.com/v2/resize:fit:786/1*S05PDbGcWJguyW3EGw_mMw.png 786w, https://miro.medium.com/v2/resize:fit:828/1*S05PDbGcWJguyW3EGw_mMw.png 828w, https://miro.medium.com/v2/resize:fit:1100/1*S05PDbGcWJguyW3EGw_mMw.png 1100w, https://miro.medium.com/v2/resize:fit:1210/1*S05PDbGcWJguyW3EGw_mMw.png 1210w" sizes="(min-resolution: 4dppx) and (max-width: 700px) 50vw, (-webkit-min-device-pixel-ratio: 4) and (max-width: 700px) 50vw, (min-resolution: 3dppx) and (max-width: 700px) 67vw, (-webkit-min-device-pixel-ratio: 3) and (max-width: 700px) 65vw, (min-resolution: 2.5dppx) and (max-width: 700px) 80vw, (-webkit-min-device-pixel-ratio: 2.5) and (max-width: 700px) 80vw, (min-resolution: 2dppx) and (max-width: 700px) 100vw, (-webkit-min-device-pixel-ratio: 2) and (max-width: 700px) 100vw, 605px"/><img alt="" class="bd ln mj c" width="605" height="224" loading="lazy" role="presentation"/></picture></div><figcaption class="nv nw nx nn no ny nz bb b bc u eb">Train data with Page Name and it’s respective page views for mentioned date</figcaption></figure><p id="f462" class="pw-post-body-paragraph mn mo gv mq b mr ms mt mu mv mw mx my mz na nb nc nd ne nf ng nh ni nj nk nl go bg">From above, we can see that the Page Name can become important feature in understanding the data distribution, as page name contains ;</p><ul class=""><li id="d134" class="mn mo gv mq b mr ms mt mu mv mw mx my mz na nb nc nd ne nf ng nh ni nj nk nl oj ok ol bg"><strong class="mq gw">Source Web Site</strong> of that Page along with the <strong class="mq gw">Language</strong> information (<em class="mp">e.g. es.wikipedia.org</em>)</li><li id="adf4" class="mn mo gv mq b mr om mt mu mv on mx my mz oo nb nc nd op nf ng nh oq nj nk nl oj ok ol bg"><strong class="mq gw">Access</strong> <strong class="mq gw">type </strong>through which the articles was accessed</li><li id="3afe" class="mn mo gv mq b mr om mt mu mv on mx my mz oo nb nc nd op nf ng nh oq nj nk nl oj ok ol bg"><strong class="mq gw">Agent</strong> through which the articles are accessed.</li></ul><p id="a3ee" class="pw-post-body-paragraph mn mo gv mq b mr ms mt mu mv mw mx my mz na nb nc nd ne nf ng nh ni nj nk nl go bg">We can create new features for that page by extracting above mentioned information from page name.</p><figure class="nq nr ns nt nu md nn no paragraph-image"><div class="nn no or"><picture><source srcSet="https://miro.medium.com/v2/resize:fit:640/format:webp/1*J6D6WqWeThpXrIlpLtbJPA.png 640w, https://miro.medium.com/v2/resize:fit:720/format:webp/1*J6D6WqWeThpXrIlpLtbJPA.png 720w, https://miro.medium.com/v2/resize:fit:750/format:webp/1*J6D6WqWeThpXrIlpLtbJPA.png 750w, https://miro.medium.com/v2/resize:fit:786/format:webp/1*J6D6WqWeThpXrIlpLtbJPA.png 786w, https://miro.medium.com/v2/resize:fit:828/format:webp/1*J6D6WqWeThpXrIlpLtbJPA.png 828w, https://miro.medium.com/v2/resize:fit:1100/format:webp/1*J6D6WqWeThpXrIlpLtbJPA.png 1100w, https://miro.medium.com/v2/resize:fit:1216/format:webp/1*J6D6WqWeThpXrIlpLtbJPA.png 1216w" sizes="(min-resolution: 4dppx) and (max-width: 700px) 50vw, (-webkit-min-device-pixel-ratio: 4) and (max-width: 700px) 50vw, (min-resolution: 3dppx) and (max-width: 700px) 67vw, (-webkit-min-device-pixel-ratio: 3) and (max-width: 700px) 65vw, (min-resolution: 2.5dppx) and (max-width: 700px) 80vw, (-webkit-min-device-pixel-ratio: 2.5) and (max-width: 700px) 80vw, (min-resolution: 2dppx) and (max-width: 700px) 100vw, (-webkit-min-device-pixel-ratio: 2) and (max-width: 700px) 100vw, 608px" type="image/webp"/><source data-testid="og" srcSet="https://miro.medium.com/v2/resize:fit:640/1*J6D6WqWeThpXrIlpLtbJPA.png 640w, https://miro.medium.com/v2/resize:fit:720/1*J6D6WqWeThpXrIlpLtbJPA.png 720w, https://miro.medium.com/v2/resize:fit:750/1*J6D6WqWeThpXrIlpLtbJPA.png 750w, https://miro.medium.com/v2/resize:fit:786/1*J6D6WqWeThpXrIlpLtbJPA.png 786w, https://miro.medium.com/v2/resize:fit:828/1*J6D6WqWeThpXrIlpLtbJPA.png 828w, https://miro.medium.com/v2/resize:fit:1100/1*J6D6WqWeThpXrIlpLtbJPA.png 1100w, https://miro.medium.com/v2/resize:fit:1216/1*J6D6WqWeThpXrIlpLtbJPA.png 1216w" sizes="(min-resolution: 4dppx) and (max-width: 700px) 50vw, (-webkit-min-device-pixel-ratio: 4) and (max-width: 700px) 50vw, (min-resolution: 3dppx) and (max-width: 700px) 67vw, (-webkit-min-device-pixel-ratio: 3) and (max-width: 700px) 65vw, (min-resolution: 2.5dppx) and (max-width: 700px) 80vw, (-webkit-min-device-pixel-ratio: 2.5) and (max-width: 700px) 80vw, (min-resolution: 2dppx) and (max-width: 700px) 100vw, (-webkit-min-device-pixel-ratio: 2) and (max-width: 700px) 100vw, 608px"/><img alt="" class="bd ln mj c" width="608" height="228" loading="lazy" role="presentation"/></picture></div><figcaption class="nv nw nx nn no ny nz bb b bc u eb">Extra Features for each page, driven from its Page Name</figcaption></figure><p id="7ade" class="pw-post-body-paragraph mn mo gv mq b mr ms mt mu mv mw mx my mz na nb nc nd ne nf ng nh ni nj nk nl go bg"><strong class="mq gw"><em class="mp">Web Traffic : Site Name Feature</em></strong></p><pre class="nq nr ns nt nu os ot ou ov ae ow bg"><span id="842e" class="ox oy gv ot b oz pa pb e pc pd">data_counts  = pageData[&#x27;Site_Name&#x27;].value_counts()</span></pre><figure class="nq nr ns nt nu md nn no paragraph-image"><div role="button" tabindex="0" class="pf pg ek ph bd pi"><span class="eo ep eq ai er es et eu ev speechify-ignore">Press enter or click to view image in full size</span><div class="nn no pe"><picture><source srcSet="https://miro.medium.com/v2/resize:fit:640/format:webp/1*hBTheUdJt35e0ApzZ9ktIA.png 640w, https://miro.medium.com/v2/resize:fit:720/format:webp/1*hBTheUdJt35e0ApzZ9ktIA.png 720w, https://miro.medium.com/v2/resize:fit:750/format:webp/1*hBTheUdJt35e0ApzZ9ktIA.png 750w, https://miro.medium.com/v2/resize:fit:786/format:webp/1*hBTheUdJt35e0ApzZ9ktIA.png 786w, https://miro.medium.com/v2/resize:fit:828/format:webp/1*hBTheUdJt35e0ApzZ9ktIA.png 828w, https://miro.medium.com/v2/resize:fit:1100/format:webp/1*hBTheUdJt35e0ApzZ9ktIA.png 1100w, https://miro.medium.com/v2/resize:fit:1400/format:webp/1*hBTheUdJt35e0ApzZ9ktIA.png 1400w" sizes="(min-resolution: 4dppx) and (max-width: 700px) 50vw, (-webkit-min-device-pixel-ratio: 4) and (max-width: 700px) 50vw, (min-resolution: 3dppx) and (max-width: 700px) 67vw, (-webkit-min-device-pixel-ratio: 3) and (max-width: 700px) 65vw, (min-resolution: 2.5dppx) and (max-width: 700px) 80vw, (-webkit-min-device-pixel-ratio: 2.5) and (max-width: 700px) 80vw, (min-resolution: 2dppx) and (max-width: 700px) 100vw, (-webkit-min-device-pixel-ratio: 2) and (max-width: 700px) 100vw, 700px" type="image/webp"/><source data-testid="og" srcSet="https://miro.medium.com/v2/resize:fit:640/1*hBTheUdJt35e0ApzZ9ktIA.png 640w, https://miro.medium.com/v2/resize:fit:720/1*hBTheUdJt35e0ApzZ9ktIA.png 720w, https://miro.medium.com/v2/resize:fit:750/1*hBTheUdJt35e0ApzZ9ktIA.png 750w, https://miro.medium.com/v2/resize:fit:786/1*hBTheUdJt35e0ApzZ9ktIA.png 786w, https://miro.medium.com/v2/resize:fit:828/1*hBTheUdJt35e0ApzZ9ktIA.png 828w, https://miro.medium.com/v2/resize:fit:1100/1*hBTheUdJt35e0ApzZ9ktIA.png 1100w, https://miro.medium.com/v2/resize:fit:1400/1*hBTheUdJt35e0ApzZ9ktIA.png 1400w" sizes="(min-resolution: 4dppx) and (max-width: 700px) 50vw, (-webkit-min-device-pixel-ratio: 4) and (max-width: 700px) 50vw, (min-resolution: 3dppx) and (max-width: 700px) 67vw, (-webkit-min-device-pixel-ratio: 3) and (max-width: 700px) 65vw, (min-resolution: 2.5dppx) and (max-width: 700px) 80vw, (-webkit-min-device-pixel-ratio: 2.5) and (max-width: 700px) 80vw, (min-resolution: 2dppx) and (max-width: 700px) 100vw, (-webkit-min-device-pixel-ratio: 2) and (max-width: 700px) 100vw, 700px"/><img alt="" class="bd ln mj c" width="700" height="260" loading="lazy" role="presentation"/></picture></div></div></figure><p id="1282" class="pw-post-body-paragraph mn mo gv mq b mr ms mt mu mv mw mx my mz na nb nc nd ne nf ng nh ni nj nk nl go bg">More traffic was observed from Wikipedia website. Lower traffic was observed from WikiMedia and MediaWiki pages.</p><p id="7e9f" class="pw-post-body-paragraph mn mo gv mq b mr ms mt mu mv mw mx my mz na nb nc nd ne nf ng nh ni nj nk nl go bg"><strong class="mq gw"><em class="mp">Web Traffic : Site Language Feature</em></strong></p><pre class="nq nr ns nt nu os ot ou ov ae ow bg"><span id="64ff" class="ox oy gv ot b oz pa pb e pc pd">data_counts  = pageData[&#x27;Language&#x27;].value_counts()</span></pre><figure class="nq nr ns nt nu md nn no paragraph-image"><div role="button" tabindex="0" class="pf pg ek ph bd pi"><span class="eo ep eq ai er es et eu ev speechify-ignore">Press enter or click to view image in full size</span><div class="nn no pj"><picture><source srcSet="https://miro.medium.com/v2/resize:fit:640/format:webp/1*HZGnujxIDrtJkO0eM6U2_g.png 640w, https://miro.medium.com/v2/resize:fit:720/format:webp/1*HZGnujxIDrtJkO0eM6U2_g.png 720w, https://miro.medium.com/v2/resize:fit:750/format:webp/1*HZGnujxIDrtJkO0eM6U2_g.png 750w, https://miro.medium.com/v2/resize:fit:786/format:webp/1*HZGnujxIDrtJkO0eM6U2_g.png 786w, https://miro.medium.com/v2/resize:fit:828/format:webp/1*HZGnujxIDrtJkO0eM6U2_g.png 828w, https://miro.medium.com/v2/resize:fit:1100/format:webp/1*HZGnujxIDrtJkO0eM6U2_g.png 1100w, https://miro.medium.com/v2/resize:fit:1400/format:webp/1*HZGnujxIDrtJkO0eM6U2_g.png 1400w" sizes="(min-resolution: 4dppx) and (max-width: 700px) 50vw, (-webkit-min-device-pixel-ratio: 4) and (max-width: 700px) 50vw, (min-resolution: 3dppx) and (max-width: 700px) 67vw, (-webkit-min-device-pixel-ratio: 3) and (max-width: 700px) 65vw, (min-resolution: 2.5dppx) and (max-width: 700px) 80vw, (-webkit-min-device-pixel-ratio: 2.5) and (max-width: 700px) 80vw, (min-resolution: 2dppx) and (max-width: 700px) 100vw, (-webkit-min-device-pixel-ratio: 2) and (max-width: 700px) 100vw, 700px" type="image/webp"/><source data-testid="og" srcSet="https://miro.medium.com/v2/resize:fit:640/1*HZGnujxIDrtJkO0eM6U2_g.png 640w, https://miro.medium.com/v2/resize:fit:720/1*HZGnujxIDrtJkO0eM6U2_g.png 720w, https://miro.medium.com/v2/resize:fit:750/1*HZGnujxIDrtJkO0eM6U2_g.png 750w, https://miro.medium.com/v2/resize:fit:786/1*HZGnujxIDrtJkO0eM6U2_g.png 786w, https://miro.medium.com/v2/resize:fit:828/1*HZGnujxIDrtJkO0eM6U2_g.png 828w, https://miro.medium.com/v2/resize:fit:1100/1*HZGnujxIDrtJkO0eM6U2_g.png 1100w, https://miro.medium.com/v2/resize:fit:1400/1*HZGnujxIDrtJkO0eM6U2_g.png 1400w" sizes="(min-resolution: 4dppx) and (max-width: 700px) 50vw, (-webkit-min-device-pixel-ratio: 4) and (max-width: 700px) 50vw, (min-resolution: 3dppx) and (max-width: 700px) 67vw, (-webkit-min-device-pixel-ratio: 3) and (max-width: 700px) 65vw, (min-resolution: 2.5dppx) and (max-width: 700px) 80vw, (-webkit-min-device-pixel-ratio: 2.5) and (max-width: 700px) 80vw, (min-resolution: 2dppx) and (max-width: 700px) 100vw, (-webkit-min-device-pixel-ratio: 2) and (max-width: 700px) 100vw, 700px"/><img alt="" class="bd ln mj c" width="700" height="269" loading="lazy" role="presentation"/></picture></div></div></figure><p id="d19d" class="pw-post-body-paragraph mn mo gv mq b mr ms mt mu mv mw mx my mz na nb nc nd ne nf ng nh ni nj nk nl go bg">More Traffic was observed with pages having <strong class="mq gw">“English”</strong> language which is commonly spoken language. “www” and “commons” recorded least amount of traffic for these pages.</p><p id="2872" class="pw-post-body-paragraph mn mo gv mq b mr ms mt mu mv mw mx my mz na nb nc nd ne nf ng nh ni nj nk nl go bg"><strong class="mq gw"><em class="mp">Web Traffic : Page Access Feature</em></strong></p><pre class="nq nr ns nt nu os ot ou ov ae ow bg"><span id="22bc" class="ox oy gv ot b oz pa pb e pc pd">data_counts  = pageData[&#x27;Access&#x27;].value_counts()</span></pre><figure class="nq nr ns nt nu md nn no paragraph-image"><div role="button" tabindex="0" class="pf pg ek ph bd pi"><span class="eo ep eq ai er es et eu ev speechify-ignore">Press enter or click to view image in full size</span><div class="nn no pk"><picture><source srcSet="https://miro.medium.com/v2/resize:fit:640/format:webp/1*nBDhJQwfV9qPDW7wt4Ojtw.png 640w, https://miro.medium.com/v2/resize:fit:720/format:webp/1*nBDhJQwfV9qPDW7wt4Ojtw.png 720w, https://miro.medium.com/v2/resize:fit:750/format:webp/1*nBDhJQwfV9qPDW7wt4Ojtw.png 750w, https://miro.medium.com/v2/resize:fit:786/format:webp/1*nBDhJQwfV9qPDW7wt4Ojtw.png 786w, https://miro.medium.com/v2/resize:fit:828/format:webp/1*nBDhJQwfV9qPDW7wt4Ojtw.png 828w, https://miro.medium.com/v2/resize:fit:1100/format:webp/1*nBDhJQwfV9qPDW7wt4Ojtw.png 1100w, https://miro.medium.com/v2/resize:fit:1400/format:webp/1*nBDhJQwfV9qPDW7wt4Ojtw.png 1400w" sizes="(min-resolution: 4dppx) and (max-width: 700px) 50vw, (-webkit-min-device-pixel-ratio: 4) and (max-width: 700px) 50vw, (min-resolution: 3dppx) and (max-width: 700px) 67vw, (-webkit-min-device-pixel-ratio: 3) and (max-width: 700px) 65vw, (min-resolution: 2.5dppx) and (max-width: 700px) 80vw, (-webkit-min-device-pixel-ratio: 2.5) and (max-width: 700px) 80vw, (min-resolution: 2dppx) and (max-width: 700px) 100vw, (-webkit-min-device-pixel-ratio: 2) and (max-width: 700px) 100vw, 700px" type="image/webp"/><source data-testid="og" srcSet="https://miro.medium.com/v2/resize:fit:640/1*nBDhJQwfV9qPDW7wt4Ojtw.png 640w, https://miro.medium.com/v2/resize:fit:720/1*nBDhJQwfV9qPDW7wt4Ojtw.png 720w, https://miro.medium.com/v2/resize:fit:750/1*nBDhJQwfV9qPDW7wt4Ojtw.png 750w, https://miro.medium.com/v2/resize:fit:786/1*nBDhJQwfV9qPDW7wt4Ojtw.png 786w, https://miro.medium.com/v2/resize:fit:828/1*nBDhJQwfV9qPDW7wt4Ojtw.png 828w, https://miro.medium.com/v2/resize:fit:1100/1*nBDhJQwfV9qPDW7wt4Ojtw.png 1100w, https://miro.medium.com/v2/resize:fit:1400/1*nBDhJQwfV9qPDW7wt4Ojtw.png 1400w" sizes="(min-resolution: 4dppx) and (max-width: 700px) 50vw, (-webkit-min-device-pixel-ratio: 4) and (max-width: 700px) 50vw, (min-resolution: 3dppx) and (max-width: 700px) 67vw, (-webkit-min-device-pixel-ratio: 3) and (max-width: 700px) 65vw, (min-resolution: 2.5dppx) and (max-width: 700px) 80vw, (-webkit-min-device-pixel-ratio: 2.5) and (max-width: 700px) 80vw, (min-resolution: 2dppx) and (max-width: 700px) 100vw, (-webkit-min-device-pixel-ratio: 2) and (max-width: 700px) 100vw, 700px"/><img alt="" class="bd ln mj c" width="700" height="265" loading="lazy" role="presentation"/></picture></div></div></figure><p id="871b" class="pw-post-body-paragraph mn mo gv mq b mr ms mt mu mv mw mx my mz na nb nc nd ne nf ng nh ni nj nk nl go bg">There are three major source from which these web pages are accessed from, viz.</p><ul class=""><li id="e4cd" class="mn mo gv mq b mr ms mt mu mv mw mx my mz na nb nc nd ne nf ng nh ni nj nk nl oj ok ol bg">All Access platform</li><li id="e546" class="mn mo gv mq b mr om mt mu mv on mx my mz oo nb nc nd op nf ng nh oq nj nk nl oj ok ol bg">Mobile-web platform</li><li id="59cc" class="mn mo gv mq b mr om mt mu mv on mx my mz oo nb nc nd op nf ng nh oq nj nk nl oj ok ol bg">Desktop platform</li></ul><p id="56b1" class="pw-post-body-paragraph mn mo gv mq b mr ms mt mu mv mw mx my mz na nb nc nd ne nf ng nh ni nj nk nl go bg">From above Bar plots, we can see that the traffic is more for pages with all-access as access category. The remaining two categories shows comparatively less traffic. Also, Mobile-web traffic is slightly more compared to that of Desktop based traffic.</p><p id="e239" class="pw-post-body-paragraph mn mo gv mq b mr ms mt mu mv mw mx my mz na nb nc nd ne nf ng nh ni nj nk nl go bg"><strong class="mq gw"><em class="mp">Web Traffic : Agent Feature</em></strong></p><pre class="nq nr ns nt nu os ot ou ov ae ow bg"><span id="7cd2" class="ox oy gv ot b oz pa pb e pc pd">data_counts = pageData[&#x27;Agent&#x27;].value_counts()</span></pre><figure class="nq nr ns nt nu md nn no paragraph-image"><div role="button" tabindex="0" class="pf pg ek ph bd pi"><span class="eo ep eq ai er es et eu ev speechify-ignore">Press enter or click to view image in full size</span><div class="nn no pl"><picture><source srcSet="https://miro.medium.com/v2/resize:fit:640/format:webp/1*LUUdPyDYaM0-cvrGR3BFGQ.png 640w, https://miro.medium.com/v2/resize:fit:720/format:webp/1*LUUdPyDYaM0-cvrGR3BFGQ.png 720w, https://miro.medium.com/v2/resize:fit:750/format:webp/1*LUUdPyDYaM0-cvrGR3BFGQ.png 750w, https://miro.medium.com/v2/resize:fit:786/format:webp/1*LUUdPyDYaM0-cvrGR3BFGQ.png 786w, https://miro.medium.com/v2/resize:fit:828/format:webp/1*LUUdPyDYaM0-cvrGR3BFGQ.png 828w, https://miro.medium.com/v2/resize:fit:1100/format:webp/1*LUUdPyDYaM0-cvrGR3BFGQ.png 1100w, https://miro.medium.com/v2/resize:fit:1400/format:webp/1*LUUdPyDYaM0-cvrGR3BFGQ.png 1400w" sizes="(min-resolution: 4dppx) and (max-width: 700px) 50vw, (-webkit-min-device-pixel-ratio: 4) and (max-width: 700px) 50vw, (min-resolution: 3dppx) and (max-width: 700px) 67vw, (-webkit-min-device-pixel-ratio: 3) and (max-width: 700px) 65vw, (min-resolution: 2.5dppx) and (max-width: 700px) 80vw, (-webkit-min-device-pixel-ratio: 2.5) and (max-width: 700px) 80vw, (min-resolution: 2dppx) and (max-width: 700px) 100vw, (-webkit-min-device-pixel-ratio: 2) and (max-width: 700px) 100vw, 700px" type="image/webp"/><source data-testid="og" srcSet="https://miro.medium.com/v2/resize:fit:640/1*LUUdPyDYaM0-cvrGR3BFGQ.png 640w, https://miro.medium.com/v2/resize:fit:720/1*LUUdPyDYaM0-cvrGR3BFGQ.png 720w, https://miro.medium.com/v2/resize:fit:750/1*LUUdPyDYaM0-cvrGR3BFGQ.png 750w, https://miro.medium.com/v2/resize:fit:786/1*LUUdPyDYaM0-cvrGR3BFGQ.png 786w, https://miro.medium.com/v2/resize:fit:828/1*LUUdPyDYaM0-cvrGR3BFGQ.png 828w, https://miro.medium.com/v2/resize:fit:1100/1*LUUdPyDYaM0-cvrGR3BFGQ.png 1100w, https://miro.medium.com/v2/resize:fit:1400/1*LUUdPyDYaM0-cvrGR3BFGQ.png 1400w" sizes="(min-resolution: 4dppx) and (max-width: 700px) 50vw, (-webkit-min-device-pixel-ratio: 4) and (max-width: 700px) 50vw, (min-resolution: 3dppx) and (max-width: 700px) 67vw, (-webkit-min-device-pixel-ratio: 3) and (max-width: 700px) 65vw, (min-resolution: 2.5dppx) and (max-width: 700px) 80vw, (-webkit-min-device-pixel-ratio: 2.5) and (max-width: 700px) 80vw, (min-resolution: 2dppx) and (max-width: 700px) 100vw, (-webkit-min-device-pixel-ratio: 2) and (max-width: 700px) 100vw, 700px"/><img alt="" class="bd ln mj c" width="700" height="265" loading="lazy" role="presentation"/></picture></div></div></figure><p id="3794" class="pw-post-body-paragraph mn mo gv mq b mr ms mt mu mv mw mx my mz na nb nc nd ne nf ng nh ni nj nk nl go bg">For all pages, we are having two agents through which the pages are being accessed. All-agents being the agent through which most of the traffic was observed from compared to Spider agent.</p><p id="b576" class="pw-post-body-paragraph mn mo gv mq b mr ms mt mu mv mw mx my mz na nb nc nd ne nf ng nh ni nj nk nl go bg"><strong class="mq gw"><em class="mp">Time Series : Mean Page Views</em></strong></p><pre class="nq nr ns nt nu os ot ou ov ae ow bg"><span id="51b9" class="ox oy gv ot b oz pa pb e pc pd">mean = timeseries.mean(axis=0)</span></pre><figure class="nq nr ns nt nu md nn no paragraph-image"><div role="button" tabindex="0" class="pf pg ek ph bd pi"><span class="eo ep eq ai er es et eu ev speechify-ignore">Press enter or click to view image in full size</span><div class="nn no pm"><picture><source srcSet="https://miro.medium.com/v2/resize:fit:640/format:webp/1*kRFxQDhLsGSj7ZOvSp4pXQ.png 640w, https://miro.medium.com/v2/resize:fit:720/format:webp/1*kRFxQDhLsGSj7ZOvSp4pXQ.png 720w, https://miro.medium.com/v2/resize:fit:750/format:webp/1*kRFxQDhLsGSj7ZOvSp4pXQ.png 750w, https://miro.medium.com/v2/resize:fit:786/format:webp/1*kRFxQDhLsGSj7ZOvSp4pXQ.png 786w, https://miro.medium.com/v2/resize:fit:828/format:webp/1*kRFxQDhLsGSj7ZOvSp4pXQ.png 828w, https://miro.medium.com/v2/resize:fit:1100/format:webp/1*kRFxQDhLsGSj7ZOvSp4pXQ.png 1100w, https://miro.medium.com/v2/resize:fit:1400/format:webp/1*kRFxQDhLsGSj7ZOvSp4pXQ.png 1400w" sizes="(min-resolution: 4dppx) and (max-width: 700px) 50vw, (-webkit-min-device-pixel-ratio: 4) and (max-width: 700px) 50vw, (min-resolution: 3dppx) and (max-width: 700px) 67vw, (-webkit-min-device-pixel-ratio: 3) and (max-width: 700px) 65vw, (min-resolution: 2.5dppx) and (max-width: 700px) 80vw, (-webkit-min-device-pixel-ratio: 2.5) and (max-width: 700px) 80vw, (min-resolution: 2dppx) and (max-width: 700px) 100vw, (-webkit-min-device-pixel-ratio: 2) and (max-width: 700px) 100vw, 700px" type="image/webp"/><source data-testid="og" srcSet="https://miro.medium.com/v2/resize:fit:640/1*kRFxQDhLsGSj7ZOvSp4pXQ.png 640w, https://miro.medium.com/v2/resize:fit:720/1*kRFxQDhLsGSj7ZOvSp4pXQ.png 720w, https://miro.medium.com/v2/resize:fit:750/1*kRFxQDhLsGSj7ZOvSp4pXQ.png 750w, https://miro.medium.com/v2/resize:fit:786/1*kRFxQDhLsGSj7ZOvSp4pXQ.png 786w, https://miro.medium.com/v2/resize:fit:828/1*kRFxQDhLsGSj7ZOvSp4pXQ.png 828w, https://miro.medium.com/v2/resize:fit:1100/1*kRFxQDhLsGSj7ZOvSp4pXQ.png 1100w, https://miro.medium.com/v2/resize:fit:1400/1*kRFxQDhLsGSj7ZOvSp4pXQ.png 1400w" sizes="(min-resolution: 4dppx) and (max-width: 700px) 50vw, (-webkit-min-device-pixel-ratio: 4) and (max-width: 700px) 50vw, (min-resolution: 3dppx) and (max-width: 700px) 67vw, (-webkit-min-device-pixel-ratio: 3) and (max-width: 700px) 65vw, (min-resolution: 2.5dppx) and (max-width: 700px) 80vw, (-webkit-min-device-pixel-ratio: 2.5) and (max-width: 700px) 80vw, (min-resolution: 2dppx) and (max-width: 700px) 100vw, (-webkit-min-device-pixel-ratio: 2) and (max-width: 700px) 100vw, 700px"/><img alt="" class="bd ln mj c" width="700" height="330" loading="lazy" role="presentation"/></picture></div></div></figure><p id="05de" class="pw-post-body-paragraph mn mo gv mq b mr ms mt mu mv mw mx my mz na nb nc nd ne nf ng nh ni nj nk nl go bg">From this timely distribution of the data, we can see that the data is not stationary over time and also there is no combining effect was observed in the data i.e. strict increase in the page views over the increase in time. There can be sharp spikes seen for the page views for certain days, considering them to be holidays, weekends. Let us understand if the time series nature of data has some correlation with it’s own lag value.</p><p id="a2cd" class="pw-post-body-paragraph mn mo gv mq b mr ms mt mu mv mw mx my mz na nb nc nd ne nf ng nh ni nj nk nl go bg"><strong class="mq gw"><em class="mp">Time Series : Correlation with Lagged values with ACF and PACF</em></strong></p><ul class=""><li id="6427" class="mn mo gv mq b mr ms mt mu mv mw mx my mz na nb nc nd ne nf ng nh ni nj nk nl oj ok ol bg"><strong class="mq gw"><em class="mp">Auto-Correlation Plot (ACF)</em></strong></li></ul><pre class="nq nr ns nt nu os ot ou ov ae ow bg"><span id="9cd2" class="ox oy gv ot b oz pa pb e pc pd">mean = timeseries.mean(axis=0)<br/>acf_plot = acf((mean.values), nlags=len(mean))</span></pre><figure class="nq nr ns nt nu md nn no paragraph-image"><div role="button" tabindex="0" class="pf pg ek ph bd pi"><span class="eo ep eq ai er es et eu ev speechify-ignore">Press enter or click to view image in full size</span><div class="nn no pn"><picture><source srcSet="https://miro.medium.com/v2/resize:fit:640/format:webp/1*Be-76gMFm3c_wODmrg7b4g.png 640w, https://miro.medium.com/v2/resize:fit:720/format:webp/1*Be-76gMFm3c_wODmrg7b4g.png 720w, https://miro.medium.com/v2/resize:fit:750/format:webp/1*Be-76gMFm3c_wODmrg7b4g.png 750w, https://miro.medium.com/v2/resize:fit:786/format:webp/1*Be-76gMFm3c_wODmrg7b4g.png 786w, https://miro.medium.com/v2/resize:fit:828/format:webp/1*Be-76gMFm3c_wODmrg7b4g.png 828w, https://miro.medium.com/v2/resize:fit:1100/format:webp/1*Be-76gMFm3c_wODmrg7b4g.png 1100w, https://miro.medium.com/v2/resize:fit:1400/format:webp/1*Be-76gMFm3c_wODmrg7b4g.png 1400w" sizes="(min-resolution: 4dppx) and (max-width: 700px) 50vw, (-webkit-min-device-pixel-ratio: 4) and (max-width: 700px) 50vw, (min-resolution: 3dppx) and (max-width: 700px) 67vw, (-webkit-min-device-pixel-ratio: 3) and (max-width: 700px) 65vw, (min-resolution: 2.5dppx) and (max-width: 700px) 80vw, (-webkit-min-device-pixel-ratio: 2.5) and (max-width: 700px) 80vw, (min-resolution: 2dppx) and (max-width: 700px) 100vw, (-webkit-min-device-pixel-ratio: 2) and (max-width: 700px) 100vw, 700px" type="image/webp"/><source data-testid="og" srcSet="https://miro.medium.com/v2/resize:fit:640/1*Be-76gMFm3c_wODmrg7b4g.png 640w, https://miro.medium.com/v2/resize:fit:720/1*Be-76gMFm3c_wODmrg7b4g.png 720w, https://miro.medium.com/v2/resize:fit:750/1*Be-76gMFm3c_wODmrg7b4g.png 750w, https://miro.medium.com/v2/resize:fit:786/1*Be-76gMFm3c_wODmrg7b4g.png 786w, https://miro.medium.com/v2/resize:fit:828/1*Be-76gMFm3c_wODmrg7b4g.png 828w, https://miro.medium.com/v2/resize:fit:1100/1*Be-76gMFm3c_wODmrg7b4g.png 1100w, https://miro.medium.com/v2/resize:fit:1400/1*Be-76gMFm3c_wODmrg7b4g.png 1400w" sizes="(min-resolution: 4dppx) and (max-width: 700px) 50vw, (-webkit-min-device-pixel-ratio: 4) and (max-width: 700px) 50vw, (min-resolution: 3dppx) and (max-width: 700px) 67vw, (-webkit-min-device-pixel-ratio: 3) and (max-width: 700px) 65vw, (min-resolution: 2.5dppx) and (max-width: 700px) 80vw, (-webkit-min-device-pixel-ratio: 2.5) and (max-width: 700px) 80vw, (min-resolution: 2dppx) and (max-width: 700px) 100vw, (-webkit-min-device-pixel-ratio: 2) and (max-width: 700px) 100vw, 700px"/><img alt="" class="bd ln mj c" width="700" height="346" loading="lazy" role="presentation"/></picture></div></div></figure><p id="1484" class="pw-post-body-paragraph mn mo gv mq b mr ms mt mu mv mw mx my mz na nb nc nd ne nf ng nh ni nj nk nl go bg">Figure shows, <a class="z nm" href="https://en.wikipedia.org/wiki/Autocorrelation#:~:text=Autocorrelation%2C%20also%20known%20as%20serial,the%20time%20lag%20between%20them." rel="noopener ugc nofollow" target="_blank"><em class="mp">ACF (Auto Correlation)</em></a> for the complete time series. We can clearly see that the page views are strongly correlated with their previous values.</p><p id="cdd7" class="pw-post-body-paragraph mn mo gv mq b mr ms mt mu mv mw mx my mz na nb nc nd ne nf ng nh ni nj nk nl go bg">Plotting ACF plot with different lags, to understand the correlation in depth.</p><figure class="nq nr ns nt nu md nn no paragraph-image"><div role="button" tabindex="0" class="pf pg ek ph bd pi"><span class="eo ep eq ai er es et eu ev speechify-ignore">Press enter or click to view image in full size</span><div class="nn no po"><picture><source srcSet="https://miro.medium.com/v2/resize:fit:640/format:webp/1*hszIaezTj3XxgvdwI5EK7A.png 640w, https://miro.medium.com/v2/resize:fit:720/format:webp/1*hszIaezTj3XxgvdwI5EK7A.png 720w, https://miro.medium.com/v2/resize:fit:750/format:webp/1*hszIaezTj3XxgvdwI5EK7A.png 750w, https://miro.medium.com/v2/resize:fit:786/format:webp/1*hszIaezTj3XxgvdwI5EK7A.png 786w, https://miro.medium.com/v2/resize:fit:828/format:webp/1*hszIaezTj3XxgvdwI5EK7A.png 828w, https://miro.medium.com/v2/resize:fit:1100/format:webp/1*hszIaezTj3XxgvdwI5EK7A.png 1100w, https://miro.medium.com/v2/resize:fit:1400/format:webp/1*hszIaezTj3XxgvdwI5EK7A.png 1400w" sizes="(min-resolution: 4dppx) and (max-width: 700px) 50vw, (-webkit-min-device-pixel-ratio: 4) and (max-width: 700px) 50vw, (min-resolution: 3dppx) and (max-width: 700px) 67vw, (-webkit-min-device-pixel-ratio: 3) and (max-width: 700px) 65vw, (min-resolution: 2.5dppx) and (max-width: 700px) 80vw, (-webkit-min-device-pixel-ratio: 2.5) and (max-width: 700px) 80vw, (min-resolution: 2dppx) and (max-width: 700px) 100vw, (-webkit-min-device-pixel-ratio: 2) and (max-width: 700px) 100vw, 700px" type="image/webp"/><source data-testid="og" srcSet="https://miro.medium.com/v2/resize:fit:640/1*hszIaezTj3XxgvdwI5EK7A.png 640w, https://miro.medium.com/v2/resize:fit:720/1*hszIaezTj3XxgvdwI5EK7A.png 720w, https://miro.medium.com/v2/resize:fit:750/1*hszIaezTj3XxgvdwI5EK7A.png 750w, https://miro.medium.com/v2/resize:fit:786/1*hszIaezTj3XxgvdwI5EK7A.png 786w, https://miro.medium.com/v2/resize:fit:828/1*hszIaezTj3XxgvdwI5EK7A.png 828w, https://miro.medium.com/v2/resize:fit:1100/1*hszIaezTj3XxgvdwI5EK7A.png 1100w, https://miro.medium.com/v2/resize:fit:1400/1*hszIaezTj3XxgvdwI5EK7A.png 1400w" sizes="(min-resolution: 4dppx) and (max-width: 700px) 50vw, (-webkit-min-device-pixel-ratio: 4) and (max-width: 700px) 50vw, (min-resolution: 3dppx) and (max-width: 700px) 67vw, (-webkit-min-device-pixel-ratio: 3) and (max-width: 700px) 65vw, (min-resolution: 2.5dppx) and (max-width: 700px) 80vw, (-webkit-min-device-pixel-ratio: 2.5) and (max-width: 700px) 80vw, (min-resolution: 2dppx) and (max-width: 700px) 100vw, (-webkit-min-device-pixel-ratio: 2) and (max-width: 700px) 100vw, 700px"/><img alt="" class="bd ln mj c" width="700" height="454" loading="lazy" role="presentation"/></picture></div></div></figure><p id="9abb" class="pw-post-body-paragraph mn mo gv mq b mr ms mt mu mv mw mx my mz na nb nc nd ne nf ng nh ni nj nk nl go bg">With four different plots of correlation of Mean page views with its lagged values, we can see that the correlation is high in Weekly, Monthly and Quarterly lags.</p><p id="22b7" class="pw-post-body-paragraph mn mo gv mq b mr ms mt mu mv mw mx my mz na nb nc nd ne nf ng nh ni nj nk nl go bg">We can see that the high correlation among the mean pageview drops below threshold value of 90% interval in case of Yearly correlation plot, which continues to increase in negative scale for certain period.</p><p id="8a02" class="pw-post-body-paragraph mn mo gv mq b mr ms mt mu mv mw mx my mz na nb nc nd ne nf ng nh ni nj nk nl go bg">From above Quarterly and Yearly ACF plot, we can say that the data is highly correlated with the lagged values of the same signals for each page views. Let us see how the page views are related with the residual values of actual page views.</p><ul class=""><li id="7cd0" class="mn mo gv mq b mr ms mt mu mv mw mx my mz na nb nc nd ne nf ng nh ni nj nk nl oj ok ol bg"><strong class="mq gw"><em class="mp">Partial Auto-Correlation Plot (PACF)</em></strong></li></ul><pre class="nq nr ns nt nu os ot ou ov ae ow bg"><span id="14b1" class="ox oy gv ot b oz pa pb e pc pd">mean = timeseries.mean(axis=0)<br/>acf_plot = pacf((mean.values), nlags=len(mean))</span></pre><figure class="nq nr ns nt nu md nn no paragraph-image"><div role="button" tabindex="0" class="pf pg ek ph bd pi"><span class="eo ep eq ai er es et eu ev speechify-ignore">Press enter or click to view image in full size</span><div class="nn no pp"><picture><source srcSet="https://miro.medium.com/v2/resize:fit:640/format:webp/1*cvrATtYmbl-Zx15m-Livdg.png 640w, https://miro.medium.com/v2/resize:fit:720/format:webp/1*cvrATtYmbl-Zx15m-Livdg.png 720w, https://miro.medium.com/v2/resize:fit:750/format:webp/1*cvrATtYmbl-Zx15m-Livdg.png 750w, https://miro.medium.com/v2/resize:fit:786/format:webp/1*cvrATtYmbl-Zx15m-Livdg.png 786w, https://miro.medium.com/v2/resize:fit:828/format:webp/1*cvrATtYmbl-Zx15m-Livdg.png 828w, https://miro.medium.com/v2/resize:fit:1100/format:webp/1*cvrATtYmbl-Zx15m-Livdg.png 1100w, https://miro.medium.com/v2/resize:fit:1400/format:webp/1*cvrATtYmbl-Zx15m-Livdg.png 1400w" sizes="(min-resolution: 4dppx) and (max-width: 700px) 50vw, (-webkit-min-device-pixel-ratio: 4) and (max-width: 700px) 50vw, (min-resolution: 3dppx) and (max-width: 700px) 67vw, (-webkit-min-device-pixel-ratio: 3) and (max-width: 700px) 65vw, (min-resolution: 2.5dppx) and (max-width: 700px) 80vw, (-webkit-min-device-pixel-ratio: 2.5) and (max-width: 700px) 80vw, (min-resolution: 2dppx) and (max-width: 700px) 100vw, (-webkit-min-device-pixel-ratio: 2) and (max-width: 700px) 100vw, 700px" type="image/webp"/><source data-testid="og" srcSet="https://miro.medium.com/v2/resize:fit:640/1*cvrATtYmbl-Zx15m-Livdg.png 640w, https://miro.medium.com/v2/resize:fit:720/1*cvrATtYmbl-Zx15m-Livdg.png 720w, https://miro.medium.com/v2/resize:fit:750/1*cvrATtYmbl-Zx15m-Livdg.png 750w, https://miro.medium.com/v2/resize:fit:786/1*cvrATtYmbl-Zx15m-Livdg.png 786w, https://miro.medium.com/v2/resize:fit:828/1*cvrATtYmbl-Zx15m-Livdg.png 828w, https://miro.medium.com/v2/resize:fit:1100/1*cvrATtYmbl-Zx15m-Livdg.png 1100w, https://miro.medium.com/v2/resize:fit:1400/1*cvrATtYmbl-Zx15m-Livdg.png 1400w" sizes="(min-resolution: 4dppx) and (max-width: 700px) 50vw, (-webkit-min-device-pixel-ratio: 4) and (max-width: 700px) 50vw, (min-resolution: 3dppx) and (max-width: 700px) 67vw, (-webkit-min-device-pixel-ratio: 3) and (max-width: 700px) 65vw, (min-resolution: 2.5dppx) and (max-width: 700px) 80vw, (-webkit-min-device-pixel-ratio: 2.5) and (max-width: 700px) 80vw, (min-resolution: 2dppx) and (max-width: 700px) 100vw, (-webkit-min-device-pixel-ratio: 2) and (max-width: 700px) 100vw, 700px"/><img alt="" class="bd ln mj c" width="700" height="340" loading="lazy" role="presentation"/></picture></div></div></figure><p id="bd6c" class="pw-post-body-paragraph mn mo gv mq b mr ms mt mu mv mw mx my mz na nb nc nd ne nf ng nh ni nj nk nl go bg">Partial ACF on the complete timestamps as seen from above figure shows there is a strong correlation of partial residuals of the lagged values in the Yearly manner. The correlation is not periodic as the peaks do not occur in timely fashion.</p><p id="9db5" class="pw-post-body-paragraph mn mo gv mq b mr ms mt mu mv mw mx my mz na nb nc nd ne nf ng nh ni nj nk nl go bg">Understanding the PACF with Weekly, Monthly, Quarterly and Yearly lagged values.</p><figure class="nq nr ns nt nu md nn no paragraph-image"><div role="button" tabindex="0" class="pf pg ek ph bd pi"><span class="eo ep eq ai er es et eu ev speechify-ignore">Press enter or click to view image in full size</span><div class="nn no pq"><picture><source srcSet="https://miro.medium.com/v2/resize:fit:640/format:webp/1*XDSEJ0uRtK7jUuDswOl8Ew.png 640w, https://miro.medium.com/v2/resize:fit:720/format:webp/1*XDSEJ0uRtK7jUuDswOl8Ew.png 720w, https://miro.medium.com/v2/resize:fit:750/format:webp/1*XDSEJ0uRtK7jUuDswOl8Ew.png 750w, https://miro.medium.com/v2/resize:fit:786/format:webp/1*XDSEJ0uRtK7jUuDswOl8Ew.png 786w, https://miro.medium.com/v2/resize:fit:828/format:webp/1*XDSEJ0uRtK7jUuDswOl8Ew.png 828w, https://miro.medium.com/v2/resize:fit:1100/format:webp/1*XDSEJ0uRtK7jUuDswOl8Ew.png 1100w, https://miro.medium.com/v2/resize:fit:1400/format:webp/1*XDSEJ0uRtK7jUuDswOl8Ew.png 1400w" sizes="(min-resolution: 4dppx) and (max-width: 700px) 50vw, (-webkit-min-device-pixel-ratio: 4) and (max-width: 700px) 50vw, (min-resolution: 3dppx) and (max-width: 700px) 67vw, (-webkit-min-device-pixel-ratio: 3) and (max-width: 700px) 65vw, (min-resolution: 2.5dppx) and (max-width: 700px) 80vw, (-webkit-min-device-pixel-ratio: 2.5) and (max-width: 700px) 80vw, (min-resolution: 2dppx) and (max-width: 700px) 100vw, (-webkit-min-device-pixel-ratio: 2) and (max-width: 700px) 100vw, 700px" type="image/webp"/><source data-testid="og" srcSet="https://miro.medium.com/v2/resize:fit:640/1*XDSEJ0uRtK7jUuDswOl8Ew.png 640w, https://miro.medium.com/v2/resize:fit:720/1*XDSEJ0uRtK7jUuDswOl8Ew.png 720w, https://miro.medium.com/v2/resize:fit:750/1*XDSEJ0uRtK7jUuDswOl8Ew.png 750w, https://miro.medium.com/v2/resize:fit:786/1*XDSEJ0uRtK7jUuDswOl8Ew.png 786w, https://miro.medium.com/v2/resize:fit:828/1*XDSEJ0uRtK7jUuDswOl8Ew.png 828w, https://miro.medium.com/v2/resize:fit:1100/1*XDSEJ0uRtK7jUuDswOl8Ew.png 1100w, https://miro.medium.com/v2/resize:fit:1400/1*XDSEJ0uRtK7jUuDswOl8Ew.png 1400w" sizes="(min-resolution: 4dppx) and (max-width: 700px) 50vw, (-webkit-min-device-pixel-ratio: 4) and (max-width: 700px) 50vw, (min-resolution: 3dppx) and (max-width: 700px) 67vw, (-webkit-min-device-pixel-ratio: 3) and (max-width: 700px) 65vw, (min-resolution: 2.5dppx) and (max-width: 700px) 80vw, (-webkit-min-device-pixel-ratio: 2.5) and (max-width: 700px) 80vw, (min-resolution: 2dppx) and (max-width: 700px) 100vw, (-webkit-min-device-pixel-ratio: 2) and (max-width: 700px) 100vw, 700px"/><img alt="" class="bd ln mj c" width="700" height="457" loading="lazy" role="presentation"/></picture></div></div></figure><p id="993c" class="pw-post-body-paragraph mn mo gv mq b mr ms mt mu mv mw mx my mz na nb nc nd ne nf ng nh ni nj nk nl go bg">With Weekly, Monthly, Quarterly and Yearly correlation for Mean PageViews of the data, no significant correlaiton was observed for shorted lag values, i.e. for Weekly, Monthly and Quarterly PACF.</p><p id="5f2a" class="pw-post-body-paragraph mn mo gv mq b mr ms mt mu mv mw mx my mz na nb nc nd ne nf ng nh ni nj nk nl go bg">Sharp spike of significant PACF can be observed after 2016–04–07, i.e. after 270 days. With this we can assume that a lag of year can become significant in determining the forecasting.</p><p id="1c25" class="pw-post-body-paragraph mn mo gv mq b mr ms mt mu mv mw mx my mz na nb nc nd ne nf ng nh ni nj nk nl go bg"><strong class="mq gw"><em class="mp">Time Series : Trend and Seasonality</em></strong></p><pre class="nq nr ns nt nu os ot ou ov ae ow bg"><span id="c40f" class="ox oy gv ot b oz pa pb e pc pd">result = seasonal_decompose(mean, model=&#x27;multiplicative&#x27;, freq=365)<br/>trend_comp    = result.trend<br/>seasonal_comp = result.seasonal<br/>residual_comp = result.resid<br/>observed_val  = result.observed</span></pre><figure class="nq nr ns nt nu md nn no paragraph-image"><div role="button" tabindex="0" class="pf pg ek ph bd pi"><span class="eo ep eq ai er es et eu ev speechify-ignore">Press enter or click to view image in full size</span><div class="nn no pr"><picture><source srcSet="https://miro.medium.com/v2/resize:fit:640/format:webp/1*1jSfokZPeTA80zuS9GuHQQ.png 640w, https://miro.medium.com/v2/resize:fit:720/format:webp/1*1jSfokZPeTA80zuS9GuHQQ.png 720w, https://miro.medium.com/v2/resize:fit:750/format:webp/1*1jSfokZPeTA80zuS9GuHQQ.png 750w, https://miro.medium.com/v2/resize:fit:786/format:webp/1*1jSfokZPeTA80zuS9GuHQQ.png 786w, https://miro.medium.com/v2/resize:fit:828/format:webp/1*1jSfokZPeTA80zuS9GuHQQ.png 828w, https://miro.medium.com/v2/resize:fit:1100/format:webp/1*1jSfokZPeTA80zuS9GuHQQ.png 1100w, https://miro.medium.com/v2/resize:fit:1400/format:webp/1*1jSfokZPeTA80zuS9GuHQQ.png 1400w" sizes="(min-resolution: 4dppx) and (max-width: 700px) 50vw, (-webkit-min-device-pixel-ratio: 4) and (max-width: 700px) 50vw, (min-resolution: 3dppx) and (max-width: 700px) 67vw, (-webkit-min-device-pixel-ratio: 3) and (max-width: 700px) 65vw, (min-resolution: 2.5dppx) and (max-width: 700px) 80vw, (-webkit-min-device-pixel-ratio: 2.5) and (max-width: 700px) 80vw, (min-resolution: 2dppx) and (max-width: 700px) 100vw, (-webkit-min-device-pixel-ratio: 2) and (max-width: 700px) 100vw, 700px" type="image/webp"/><source data-testid="og" srcSet="https://miro.medium.com/v2/resize:fit:640/1*1jSfokZPeTA80zuS9GuHQQ.png 640w, https://miro.medium.com/v2/resize:fit:720/1*1jSfokZPeTA80zuS9GuHQQ.png 720w, https://miro.medium.com/v2/resize:fit:750/1*1jSfokZPeTA80zuS9GuHQQ.png 750w, https://miro.medium.com/v2/resize:fit:786/1*1jSfokZPeTA80zuS9GuHQQ.png 786w, https://miro.medium.com/v2/resize:fit:828/1*1jSfokZPeTA80zuS9GuHQQ.png 828w, https://miro.medium.com/v2/resize:fit:1100/1*1jSfokZPeTA80zuS9GuHQQ.png 1100w, https://miro.medium.com/v2/resize:fit:1400/1*1jSfokZPeTA80zuS9GuHQQ.png 1400w" sizes="(min-resolution: 4dppx) and (max-width: 700px) 50vw, (-webkit-min-device-pixel-ratio: 4) and (max-width: 700px) 50vw, (min-resolution: 3dppx) and (max-width: 700px) 67vw, (-webkit-min-device-pixel-ratio: 3) and (max-width: 700px) 65vw, (min-resolution: 2.5dppx) and (max-width: 700px) 80vw, (-webkit-min-device-pixel-ratio: 2.5) and (max-width: 700px) 80vw, (min-resolution: 2dppx) and (max-width: 700px) 100vw, (-webkit-min-device-pixel-ratio: 2) and (max-width: 700px) 100vw, 700px"/><img alt="" class="bd ln mj c" width="700" height="393" loading="lazy" role="presentation"/></picture></div></div></figure><p id="75a2" class="pw-post-body-paragraph mn mo gv mq b mr ms mt mu mv mw mx my mz na nb nc nd ne nf ng nh ni nj nk nl go bg">From the plot of PACF, we could see negative spike in the data, which can be observed from trend waveform.</p><p id="1bb1" class="pw-post-body-paragraph mn mo gv mq b mr ms mt mu mv mw mx my mz na nb nc nd ne nf ng nh ni nj nk nl go bg">With seasonality decomposition of the mean time series for all pages, we can see</p><ul class=""><li id="a949" class="mn mo gv mq b mr ms mt mu mv mw mx my mz na nb nc nd ne nf ng nh ni nj nk nl oj ok ol bg">Trend is decreasing after a certain increase in the initial period.</li><li id="dd58" class="mn mo gv mq b mr om mt mu mv on mx my mz oo nb nc nd op nf ng nh oq nj nk nl oj ok ol bg">yearly cycle is observed in the data</li></ul><p id="2670" class="pw-post-body-paragraph mn mo gv mq b mr ms mt mu mv mw mx my mz na nb nc nd ne nf ng nh ni nj nk nl go bg">With this understanding of the time series, we can prepare the data for modeling.</p></div></div></div><div class="v cf oa ob oc od" role="separator"><span class="oe bu bi of og oh"></span><span class="oe bu bi of og oh"></span><span class="oe bu bi of og"></span></div><div class="go gp gq gr gs"><div class="v cf"><div class="cm bd ga gb gc gd"><blockquote class="mk ml mm"><p id="e214" class="mn mo mp mq b mr ms mt mu mv mw mx my mz na nb nc nd ne nf ng nh ni nj nk nl go bg"><strong class="mq gw"><em class="gv">Data Preparation :</em></strong></p></blockquote><p id="ca45" class="pw-post-body-paragraph mn mo gv mq b mr ms mt mu mv mw mx my mz na nb nc nd ne nf ng nh ni nj nk nl go bg">With total of 803 time stamps for page views of each pages, from Jul 27, 2015 till Sept 10, 2017, we can divide the initial 2 years data as Train data <em class="mp">(from July 1, 2015 upto July 1, 2017)</em> and remaining data can be used as Cross Validation data, i.e. for validating the parameters so as to perform well on future unseen points.</p><pre class="nq nr ns nt nu os ot ou ov ae ow bg"><span id="88ce" class="ox oy gv ot b oz pa pb e pc pd">#getting the index of date<br/>date_cols  = timeseries.columns.tolist()<br/>train_end  = date_cols.index(&#x27;2017-07-01&#x27;)-1</span><span id="9dae" class="ox oy gv ot b oz ps pb e pc pd">#splitting the main data as train and cv<br/>train_data = timeseries.iloc[:,:]<br/>cv_data    = timeseries.iloc[:,train_end:]</span></pre><p id="240b" class="pw-post-body-paragraph mn mo gv mq b mr ms mt mu mv mw mx my mz na nb nc nd ne nf ng nh ni nj nk nl go bg">Later, we will One Hot Encode, each of the features derived from Page Name, which can be suitable for modeling.</p><pre class="nq nr ns nt nu os ot ou ov ae ow bg"><span id="70f7" class="ox oy gv ot b oz pa pb e pc pd">label = LabelEncoder()</span><span id="c724" class="ox oy gv ot b oz ps pb e pc pd">train_data[&#x27;Site_OHE&#x27;]=label.fit_transform(train_data[&#x27;Site_Name&#x27;]).tolist()<br/>train_data[&#x27;Lang_OHE&#x27;]=label.fit_transform(train_data[&#x27;Language&#x27;]).tolist()<br/>train_data[&#x27;Access_OHE&#x27;]=label.fit_transform(train_data[&#x27;Access&#x27;]).tolist()<br/>train_data[&#x27;Agent_OHE&#x27;]=label.fit_transform(train_data[&#x27;Agent&#x27;]).tolist()</span><span id="fc39" class="ox oy gv ot b oz ps pb e pc pd">#changing the last columns as Observed <br/>train_data=train_data.rename(columns={timeseries.iloc[:,:train_end].columns[-1]:&#x27;Observed&#x27;})</span></pre><p id="14e5" class="pw-post-body-paragraph mn mo gv mq b mr ms mt mu mv mw mx my mz na nb nc nd ne nf ng nh ni nj nk nl go bg">With LabelEncoder, we encoded each Page Name features into numerical format. This features can be used with rest of the time stamps as combined features so as to train the model. We can make the same modifications on Test data too.</p><p id="5eac" class="pw-post-body-paragraph mn mo gv mq b mr ms mt mu mv mw mx my mz na nb nc nd ne nf ng nh ni nj nk nl go bg">Now that our data is ready, we can proceed with the modeling.</p></div></div></div><div class="v cf oa ob oc od" role="separator"><span class="oe bu bi of og oh"></span><span class="oe bu bi of og oh"></span><span class="oe bu bi of og"></span></div><div class="go gp gq gr gs"><div class="v cf"><div class="cm bd ga gb gc gd"><blockquote class="mk ml mm"><p id="5a37" class="mn mo mp mq b mr ms mt mu mv mw mx my mz na nb nc nd ne nf ng nh ni nj nk nl go bg"><strong class="mq gw"><em class="gv">Metric for Model Evaluation</em></strong></p></blockquote><p id="38c6" class="pw-post-body-paragraph mn mo gv mq b mr ms mt mu mv mw mx my mz na nb nc nd ne nf ng nh ni nj nk nl go bg">Before we could talk about modeling, first let’s have a look at the metric which can be used to evaluate the performance of the ML/DL models. For this problem, we will be using Metric provided by Kaggle and that is SMAPE (Symmetric Mean Absolute Percentage Error) which is formulated as,</p><figure class="nq nr ns nt nu md nn no paragraph-image"><div class="nn no pt"><picture><source srcSet="https://miro.medium.com/v2/resize:fit:640/format:webp/1*lF4bGmuzhuS9M3zV-aFlAQ.png 640w, https://miro.medium.com/v2/resize:fit:720/format:webp/1*lF4bGmuzhuS9M3zV-aFlAQ.png 720w, https://miro.medium.com/v2/resize:fit:750/format:webp/1*lF4bGmuzhuS9M3zV-aFlAQ.png 750w, https://miro.medium.com/v2/resize:fit:786/format:webp/1*lF4bGmuzhuS9M3zV-aFlAQ.png 786w, https://miro.medium.com/v2/resize:fit:828/format:webp/1*lF4bGmuzhuS9M3zV-aFlAQ.png 828w, https://miro.medium.com/v2/resize:fit:1100/format:webp/1*lF4bGmuzhuS9M3zV-aFlAQ.png 1100w, https://miro.medium.com/v2/resize:fit:562/format:webp/1*lF4bGmuzhuS9M3zV-aFlAQ.png 562w" sizes="(min-resolution: 4dppx) and (max-width: 700px) 50vw, (-webkit-min-device-pixel-ratio: 4) and (max-width: 700px) 50vw, (min-resolution: 3dppx) and (max-width: 700px) 67vw, (-webkit-min-device-pixel-ratio: 3) and (max-width: 700px) 65vw, (min-resolution: 2.5dppx) and (max-width: 700px) 80vw, (-webkit-min-device-pixel-ratio: 2.5) and (max-width: 700px) 80vw, (min-resolution: 2dppx) and (max-width: 700px) 100vw, (-webkit-min-device-pixel-ratio: 2) and (max-width: 700px) 100vw, 281px" type="image/webp"/><source data-testid="og" srcSet="https://miro.medium.com/v2/resize:fit:640/1*lF4bGmuzhuS9M3zV-aFlAQ.png 640w, https://miro.medium.com/v2/resize:fit:720/1*lF4bGmuzhuS9M3zV-aFlAQ.png 720w, https://miro.medium.com/v2/resize:fit:750/1*lF4bGmuzhuS9M3zV-aFlAQ.png 750w, https://miro.medium.com/v2/resize:fit:786/1*lF4bGmuzhuS9M3zV-aFlAQ.png 786w, https://miro.medium.com/v2/resize:fit:828/1*lF4bGmuzhuS9M3zV-aFlAQ.png 828w, https://miro.medium.com/v2/resize:fit:1100/1*lF4bGmuzhuS9M3zV-aFlAQ.png 1100w, https://miro.medium.com/v2/resize:fit:562/1*lF4bGmuzhuS9M3zV-aFlAQ.png 562w" sizes="(min-resolution: 4dppx) and (max-width: 700px) 50vw, (-webkit-min-device-pixel-ratio: 4) and (max-width: 700px) 50vw, (min-resolution: 3dppx) and (max-width: 700px) 67vw, (-webkit-min-device-pixel-ratio: 3) and (max-width: 700px) 65vw, (min-resolution: 2.5dppx) and (max-width: 700px) 80vw, (-webkit-min-device-pixel-ratio: 2.5) and (max-width: 700px) 80vw, (min-resolution: 2dppx) and (max-width: 700px) 100vw, (-webkit-min-device-pixel-ratio: 2) and (max-width: 700px) 100vw, 281px"/><img alt="" class="bd ln mj c" width="281" height="77" loading="lazy" role="presentation"/></picture></div><figcaption class="nv nw nx nn no ny nz bb b bc u eb">SMAPE formulation</figcaption></figure><p id="33de" class="pw-post-body-paragraph mn mo gv mq b mr ms mt mu mv mw mx my mz na nb nc nd ne nf ng nh ni nj nk nl go bg">Defining function for returning the SMAPE for forecast values,</p><pre class="nq nr ns nt nu os ot ou ov ae ow bg"><span id="02ad" class="ox oy gv ot b oz pa pb e pc pd">#metric for evaluation which accepts Y_True and Y_Pred<br/>def smape(ytr, ypr):<br/>    numerator   = np.abs(ypr - ytr)<br/>    #print(numerator)<br/>    denominator = (np.abs(ytr) + np.abs(ypr))<br/>    #print(denominator)<br/>    return (200/len(ytr) * np.sum( numerator / denominator ))</span></pre></div></div></div><div class="v cf oa ob oc od" role="separator"><span class="oe bu bi of og oh"></span><span class="oe bu bi of og oh"></span><span class="oe bu bi of og"></span></div><div class="go gp gq gr gs"><div class="v cf"><div class="cm bd ga gb gc gd"><blockquote class="mk ml mm"><p id="e6a6" class="mn mo mp mq b mr ms mt mu mv mw mx my mz na nb nc nd ne nf ng nh ni nj nk nl go bg"><strong class="mq gw"><em class="gv">Modeling : ML Modeling</em></strong></p></blockquote><p id="ca21" class="pw-post-body-paragraph mn mo gv mq b mr ms mt mu mv mw mx my mz na nb nc nd ne nf ng nh ni nj nk nl go bg">With the prepared data, where we already extracted Page features, we will perform both Machine Learning(ML) Modeling and Deep Learning(DL) Modeling as well.</p><p id="2444" class="pw-post-body-paragraph mn mo gv mq b mr ms mt mu mv mw mx my mz na nb nc nd ne nf ng nh ni nj nk nl go bg">Before proceeding to our modeling, we will perform Train and Cross Validation analysis few of the previous values. This is because the time series is more likely will depend on its previous values and hence, we can select few of the lagged observations to fit the model which can forecast the values for future time stamps.</p><pre class="nq nr ns nt nu os ot ou ov ae ow bg"><span id="375f" class="ox oy gv ot b oz pa pb e pc pd">lagged_window = [ 7, 30, 90, 365 ]</span></pre><p id="cdc6" class="pw-post-body-paragraph mn mo gv mq b mr ms mt mu mv mw mx my mz na nb nc nd ne nf ng nh ni nj nk nl go bg">Since, page views are real number, and can have any non-zero value, hence, using these values directly in our modeling can create stability issue in modeling. Hence, we will standardize the values by taking log of the original values. Also, in this case, we cannot use natural log as page views can be 0, which can create problem when we will calculate SMAPE, and hence, we will be using log(1+x) for this problem.</p><p id="b800" class="pw-post-body-paragraph mn mo gv mq b mr ms mt mu mv mw mx my mz na nb nc nd ne nf ng nh ni nj nk nl go bg"><strong class="mq gw"><em class="mp">ML Modeling : Window Mean</em></strong></p><p id="09db" class="pw-post-body-paragraph mn mo gv mq b mr ms mt mu mv mw mx my mz na nb nc nd ne nf ng nh ni nj nk nl go bg">In this modeling, we consider mean of previous values for forecasting. The best lag window can be found out with the performance of model in CV data where we try to predict the page views for each day and later calculate SMAPE for the forecast values.</p><pre class="nq nr ns nt nu os ot ou ov ae ow bg"><span id="d173" class="ox oy gv ot b oz pa pb e pc pd">X = np.log1p(timeseries_X.iloc[:,-lag:])<br/>mean_X = X.mean(axis=1)<br/>#calculating SMAPE and MAPE<br/>train_smape = smoothed_smape(Y, mean_X)<br/>train_mape = mape(Y, mean_X)</span></pre><figure class="nq nr ns nt nu md nn no paragraph-image"><div class="nn no pu"><picture><source srcSet="https://miro.medium.com/v2/resize:fit:640/format:webp/1*HGuChaxB7xUJQZ7hRTxPiw.png 640w, https://miro.medium.com/v2/resize:fit:720/format:webp/1*HGuChaxB7xUJQZ7hRTxPiw.png 720w, https://miro.medium.com/v2/resize:fit:750/format:webp/1*HGuChaxB7xUJQZ7hRTxPiw.png 750w, https://miro.medium.com/v2/resize:fit:786/format:webp/1*HGuChaxB7xUJQZ7hRTxPiw.png 786w, https://miro.medium.com/v2/resize:fit:828/format:webp/1*HGuChaxB7xUJQZ7hRTxPiw.png 828w, https://miro.medium.com/v2/resize:fit:1100/format:webp/1*HGuChaxB7xUJQZ7hRTxPiw.png 1100w, https://miro.medium.com/v2/resize:fit:508/format:webp/1*HGuChaxB7xUJQZ7hRTxPiw.png 508w" sizes="(min-resolution: 4dppx) and (max-width: 700px) 50vw, (-webkit-min-device-pixel-ratio: 4) and (max-width: 700px) 50vw, (min-resolution: 3dppx) and (max-width: 700px) 67vw, (-webkit-min-device-pixel-ratio: 3) and (max-width: 700px) 65vw, (min-resolution: 2.5dppx) and (max-width: 700px) 80vw, (-webkit-min-device-pixel-ratio: 2.5) and (max-width: 700px) 80vw, (min-resolution: 2dppx) and (max-width: 700px) 100vw, (-webkit-min-device-pixel-ratio: 2) and (max-width: 700px) 100vw, 254px" type="image/webp"/><source data-testid="og" srcSet="https://miro.medium.com/v2/resize:fit:640/1*HGuChaxB7xUJQZ7hRTxPiw.png 640w, https://miro.medium.com/v2/resize:fit:720/1*HGuChaxB7xUJQZ7hRTxPiw.png 720w, https://miro.medium.com/v2/resize:fit:750/1*HGuChaxB7xUJQZ7hRTxPiw.png 750w, https://miro.medium.com/v2/resize:fit:786/1*HGuChaxB7xUJQZ7hRTxPiw.png 786w, https://miro.medium.com/v2/resize:fit:828/1*HGuChaxB7xUJQZ7hRTxPiw.png 828w, https://miro.medium.com/v2/resize:fit:1100/1*HGuChaxB7xUJQZ7hRTxPiw.png 1100w, https://miro.medium.com/v2/resize:fit:508/1*HGuChaxB7xUJQZ7hRTxPiw.png 508w" sizes="(min-resolution: 4dppx) and (max-width: 700px) 50vw, (-webkit-min-device-pixel-ratio: 4) and (max-width: 700px) 50vw, (min-resolution: 3dppx) and (max-width: 700px) 67vw, (-webkit-min-device-pixel-ratio: 3) and (max-width: 700px) 65vw, (min-resolution: 2.5dppx) and (max-width: 700px) 80vw, (-webkit-min-device-pixel-ratio: 2.5) and (max-width: 700px) 80vw, (min-resolution: 2dppx) and (max-width: 700px) 100vw, (-webkit-min-device-pixel-ratio: 2) and (max-width: 700px) 100vw, 254px"/><img alt="" class="bd ln mj c" width="254" height="67" loading="lazy" role="presentation"/></picture></div></figure><figure class="nq nr ns nt nu md nn no paragraph-image"><div role="button" tabindex="0" class="pf pg ek ph bd pi"><span class="eo ep eq ai er es et eu ev speechify-ignore">Press enter or click to view image in full size</span><div class="nn no pv"><picture><source srcSet="https://miro.medium.com/v2/resize:fit:640/format:webp/1*P2UG2fehKYHHu-xy_SS-2A.png 640w, https://miro.medium.com/v2/resize:fit:720/format:webp/1*P2UG2fehKYHHu-xy_SS-2A.png 720w, https://miro.medium.com/v2/resize:fit:750/format:webp/1*P2UG2fehKYHHu-xy_SS-2A.png 750w, https://miro.medium.com/v2/resize:fit:786/format:webp/1*P2UG2fehKYHHu-xy_SS-2A.png 786w, https://miro.medium.com/v2/resize:fit:828/format:webp/1*P2UG2fehKYHHu-xy_SS-2A.png 828w, https://miro.medium.com/v2/resize:fit:1100/format:webp/1*P2UG2fehKYHHu-xy_SS-2A.png 1100w, https://miro.medium.com/v2/resize:fit:1400/format:webp/1*P2UG2fehKYHHu-xy_SS-2A.png 1400w" sizes="(min-resolution: 4dppx) and (max-width: 700px) 50vw, (-webkit-min-device-pixel-ratio: 4) and (max-width: 700px) 50vw, (min-resolution: 3dppx) and (max-width: 700px) 67vw, (-webkit-min-device-pixel-ratio: 3) and (max-width: 700px) 65vw, (min-resolution: 2.5dppx) and (max-width: 700px) 80vw, (-webkit-min-device-pixel-ratio: 2.5) and (max-width: 700px) 80vw, (min-resolution: 2dppx) and (max-width: 700px) 100vw, (-webkit-min-device-pixel-ratio: 2) and (max-width: 700px) 100vw, 700px" type="image/webp"/><source data-testid="og" srcSet="https://miro.medium.com/v2/resize:fit:640/1*P2UG2fehKYHHu-xy_SS-2A.png 640w, https://miro.medium.com/v2/resize:fit:720/1*P2UG2fehKYHHu-xy_SS-2A.png 720w, https://miro.medium.com/v2/resize:fit:750/1*P2UG2fehKYHHu-xy_SS-2A.png 750w, https://miro.medium.com/v2/resize:fit:786/1*P2UG2fehKYHHu-xy_SS-2A.png 786w, https://miro.medium.com/v2/resize:fit:828/1*P2UG2fehKYHHu-xy_SS-2A.png 828w, https://miro.medium.com/v2/resize:fit:1100/1*P2UG2fehKYHHu-xy_SS-2A.png 1100w, https://miro.medium.com/v2/resize:fit:1400/1*P2UG2fehKYHHu-xy_SS-2A.png 1400w" sizes="(min-resolution: 4dppx) and (max-width: 700px) 50vw, (-webkit-min-device-pixel-ratio: 4) and (max-width: 700px) 50vw, (min-resolution: 3dppx) and (max-width: 700px) 67vw, (-webkit-min-device-pixel-ratio: 3) and (max-width: 700px) 65vw, (min-resolution: 2.5dppx) and (max-width: 700px) 80vw, (-webkit-min-device-pixel-ratio: 2.5) and (max-width: 700px) 80vw, (min-resolution: 2dppx) and (max-width: 700px) 100vw, (-webkit-min-device-pixel-ratio: 2) and (max-width: 700px) 100vw, 700px"/><img alt="" class="bd ln mj c" width="700" height="287" loading="lazy" role="presentation"/></picture></div></div></figure><p id="585c" class="pw-post-body-paragraph mn mo gv mq b mr ms mt mu mv mw mx my mz na nb nc nd ne nf ng nh ni nj nk nl go bg">Above plot is the mean page views of all page for Cross Validation dataset. We can see the model is under-fit to the given data. Kaggle scorer for this model on test data is found to be 44.92666.</p><p id="df1e" class="pw-post-body-paragraph mn mo gv mq b mr ms mt mu mv mw mx my mz na nb nc nd ne nf ng nh ni nj nk nl go bg"><strong class="mq gw"><em class="mp">ML Modeling : Linear Regression</em></strong></p><p id="e3ca" class="pw-post-body-paragraph mn mo gv mq b mr ms mt mu mv mw mx my mz na nb nc nd ne nf ng nh ni nj nk nl go bg">Available time series data can be fit to Linear Regressor model, with loss function of Squared Loss and Huber loss. We will fit the model on different lagged windows, so as to find on how many previous time stamps the target page views are dependent.</p><p id="4762" class="pw-post-body-paragraph mn mo gv mq b mr ms mt mu mv mw mx my mz na nb nc nd ne nf ng nh ni nj nk nl go bg">To the lagged windows of the available time series, we will also add extra features that we extracted from Page Name of the given articles.</p><p id="f11c" class="pw-post-body-paragraph mn mo gv mq b mr ms mt mu mv mw mx my mz na nb nc nd ne nf ng nh ni nj nk nl go bg">Therefore, we will be training the model on mentioned losses with data containing Lagged values as well as Page Features.</p><ul class=""><li id="f50d" class="mn mo gv mq b mr ms mt mu mv mw mx my mz na nb nc nd ne nf ng nh ni nj nk nl oj ok ol bg"><strong class="mq gw"><em class="mp">Linear Regression with Squared Loss</em></strong></li></ul><pre class="nq nr ns nt nu os ot ou ov ae ow bg"><span id="0f25" class="ox oy gv ot b oz pa pb e pc pd">X = np.log1p(history.iloc[:, -best_window:])<br/>#adding page features to the lagged values<br/>X = np.hstack((X_pagename, X))<br/>log_reg = SGDRegressor(alpha=best_alpha, loss=&#x27;squared_loss&#x27;, \<br/>          penalty=&#x27;l2&#x27;, fit_intercept=True, random_state=45)<br/>log_reg.fit(X, Y)</span><span id="38dd" class="ox oy gv ot b oz ps pb e pc pd">#saving the best fit mode<br/>joblib.dump(log_reg, &#x27;./ML_MODEL-linear_regression_squareloss.sav&#x27;)</span></pre><figure class="nq nr ns nt nu md nn no paragraph-image"><div role="button" tabindex="0" class="pf pg ek ph bd pi"><span class="eo ep eq ai er es et eu ev speechify-ignore">Press enter or click to view image in full size</span><div class="nn no pv"><picture><source srcSet="https://miro.medium.com/v2/resize:fit:640/format:webp/1*rrb-2U8I2TUBIm6LGfSaGQ.png 640w, https://miro.medium.com/v2/resize:fit:720/format:webp/1*rrb-2U8I2TUBIm6LGfSaGQ.png 720w, https://miro.medium.com/v2/resize:fit:750/format:webp/1*rrb-2U8I2TUBIm6LGfSaGQ.png 750w, https://miro.medium.com/v2/resize:fit:786/format:webp/1*rrb-2U8I2TUBIm6LGfSaGQ.png 786w, https://miro.medium.com/v2/resize:fit:828/format:webp/1*rrb-2U8I2TUBIm6LGfSaGQ.png 828w, https://miro.medium.com/v2/resize:fit:1100/format:webp/1*rrb-2U8I2TUBIm6LGfSaGQ.png 1100w, https://miro.medium.com/v2/resize:fit:1400/format:webp/1*rrb-2U8I2TUBIm6LGfSaGQ.png 1400w" sizes="(min-resolution: 4dppx) and (max-width: 700px) 50vw, (-webkit-min-device-pixel-ratio: 4) and (max-width: 700px) 50vw, (min-resolution: 3dppx) and (max-width: 700px) 67vw, (-webkit-min-device-pixel-ratio: 3) and (max-width: 700px) 65vw, (min-resolution: 2.5dppx) and (max-width: 700px) 80vw, (-webkit-min-device-pixel-ratio: 2.5) and (max-width: 700px) 80vw, (min-resolution: 2dppx) and (max-width: 700px) 100vw, (-webkit-min-device-pixel-ratio: 2) and (max-width: 700px) 100vw, 700px" type="image/webp"/><source data-testid="og" srcSet="https://miro.medium.com/v2/resize:fit:640/1*rrb-2U8I2TUBIm6LGfSaGQ.png 640w, https://miro.medium.com/v2/resize:fit:720/1*rrb-2U8I2TUBIm6LGfSaGQ.png 720w, https://miro.medium.com/v2/resize:fit:750/1*rrb-2U8I2TUBIm6LGfSaGQ.png 750w, https://miro.medium.com/v2/resize:fit:786/1*rrb-2U8I2TUBIm6LGfSaGQ.png 786w, https://miro.medium.com/v2/resize:fit:828/1*rrb-2U8I2TUBIm6LGfSaGQ.png 828w, https://miro.medium.com/v2/resize:fit:1100/1*rrb-2U8I2TUBIm6LGfSaGQ.png 1100w, https://miro.medium.com/v2/resize:fit:1400/1*rrb-2U8I2TUBIm6LGfSaGQ.png 1400w" sizes="(min-resolution: 4dppx) and (max-width: 700px) 50vw, (-webkit-min-device-pixel-ratio: 4) and (max-width: 700px) 50vw, (min-resolution: 3dppx) and (max-width: 700px) 67vw, (-webkit-min-device-pixel-ratio: 3) and (max-width: 700px) 65vw, (min-resolution: 2.5dppx) and (max-width: 700px) 80vw, (-webkit-min-device-pixel-ratio: 2.5) and (max-width: 700px) 80vw, (min-resolution: 2dppx) and (max-width: 700px) 100vw, (-webkit-min-device-pixel-ratio: 2) and (max-width: 700px) 100vw, 700px"/><img alt="" class="bd ln mj c" width="700" height="296" loading="lazy" role="presentation"/></picture></div></div></figure><ul class=""><li id="17db" class="mn mo gv mq b mr ms mt mu mv mw mx my mz na nb nc nd ne nf ng nh ni nj nk nl oj ok ol bg"><strong class="mq gw"><em class="mp">Linear Regression with Huber Loss</em></strong></li></ul><pre class="nq nr ns nt nu os ot ou ov ae ow bg"><span id="7015" class="ox oy gv ot b oz pa pb e pc pd">X = np.log1p(history.iloc[:, -best_window:])<br/>#adding page features to the lagged values<br/>X = np.hstack((X_pagename, X))<br/>log_reg = SGDRegressor(alpha=best_alpha, loss=&#x27;huber&#x27;, \<br/>                     penalty=&#x27;l2&#x27;, fit_intercept=True, random_state=45)<br/>log_reg.fit(X, Y)<br/>#saving the best fit mode<br/>joblib.dump(log_reg, &#x27;./ML_MODEL-linear_regression_huberloss.sav&#x27;)</span></pre><figure class="nq nr ns nt nu md nn no paragraph-image"><div role="button" tabindex="0" class="pf pg ek ph bd pi"><span class="eo ep eq ai er es et eu ev speechify-ignore">Press enter or click to view image in full size</span><div class="nn no pw"><picture><source srcSet="https://miro.medium.com/v2/resize:fit:640/format:webp/1*MCaWcNP0VfSKr2yBzW9G5A.png 640w, https://miro.medium.com/v2/resize:fit:720/format:webp/1*MCaWcNP0VfSKr2yBzW9G5A.png 720w, https://miro.medium.com/v2/resize:fit:750/format:webp/1*MCaWcNP0VfSKr2yBzW9G5A.png 750w, https://miro.medium.com/v2/resize:fit:786/format:webp/1*MCaWcNP0VfSKr2yBzW9G5A.png 786w, https://miro.medium.com/v2/resize:fit:828/format:webp/1*MCaWcNP0VfSKr2yBzW9G5A.png 828w, https://miro.medium.com/v2/resize:fit:1100/format:webp/1*MCaWcNP0VfSKr2yBzW9G5A.png 1100w, https://miro.medium.com/v2/resize:fit:1400/format:webp/1*MCaWcNP0VfSKr2yBzW9G5A.png 1400w" sizes="(min-resolution: 4dppx) and (max-width: 700px) 50vw, (-webkit-min-device-pixel-ratio: 4) and (max-width: 700px) 50vw, (min-resolution: 3dppx) and (max-width: 700px) 67vw, (-webkit-min-device-pixel-ratio: 3) and (max-width: 700px) 65vw, (min-resolution: 2.5dppx) and (max-width: 700px) 80vw, (-webkit-min-device-pixel-ratio: 2.5) and (max-width: 700px) 80vw, (min-resolution: 2dppx) and (max-width: 700px) 100vw, (-webkit-min-device-pixel-ratio: 2) and (max-width: 700px) 100vw, 700px" type="image/webp"/><source data-testid="og" srcSet="https://miro.medium.com/v2/resize:fit:640/1*MCaWcNP0VfSKr2yBzW9G5A.png 640w, https://miro.medium.com/v2/resize:fit:720/1*MCaWcNP0VfSKr2yBzW9G5A.png 720w, https://miro.medium.com/v2/resize:fit:750/1*MCaWcNP0VfSKr2yBzW9G5A.png 750w, https://miro.medium.com/v2/resize:fit:786/1*MCaWcNP0VfSKr2yBzW9G5A.png 786w, https://miro.medium.com/v2/resize:fit:828/1*MCaWcNP0VfSKr2yBzW9G5A.png 828w, https://miro.medium.com/v2/resize:fit:1100/1*MCaWcNP0VfSKr2yBzW9G5A.png 1100w, https://miro.medium.com/v2/resize:fit:1400/1*MCaWcNP0VfSKr2yBzW9G5A.png 1400w" sizes="(min-resolution: 4dppx) and (max-width: 700px) 50vw, (-webkit-min-device-pixel-ratio: 4) and (max-width: 700px) 50vw, (min-resolution: 3dppx) and (max-width: 700px) 67vw, (-webkit-min-device-pixel-ratio: 3) and (max-width: 700px) 65vw, (min-resolution: 2.5dppx) and (max-width: 700px) 80vw, (-webkit-min-device-pixel-ratio: 2.5) and (max-width: 700px) 80vw, (min-resolution: 2dppx) and (max-width: 700px) 100vw, (-webkit-min-device-pixel-ratio: 2) and (max-width: 700px) 100vw, 700px"/><img alt="" class="bd ln mj c" width="700" height="294" loading="lazy" role="presentation"/></picture></div></div></figure><p id="80eb" class="pw-post-body-paragraph mn mo gv mq b mr ms mt mu mv mw mx my mz na nb nc nd ne nf ng nh ni nj nk nl go bg">Compared to square loss, model tried to fit to the existing train data, value started to increase for the dates for which we can see increase in mean page views.</p><p id="df05" class="pw-post-body-paragraph mn mo gv mq b mr ms mt mu mv mw mx my mz na nb nc nd ne nf ng nh ni nj nk nl go bg">Data with limited features, can be best fit using Tree based classifiers and hence, we will be fitting tree based classifiers to check the model performance.</p><p id="d865" class="pw-post-body-paragraph mn mo gv mq b mr ms mt mu mv mw mx my mz na nb nc nd ne nf ng nh ni nj nk nl go bg"><strong class="mq gw"><em class="mp">ML Modeling : Tree Based Methods</em></strong></p><ul class=""><li id="f90f" class="mn mo gv mq b mr ms mt mu mv mw mx my mz na nb nc nd ne nf ng nh ni nj nk nl oj ok ol bg"><strong class="mq gw"><em class="mp">Decision Tree :</em></strong></li></ul><p id="1382" class="pw-post-body-paragraph mn mo gv mq b mr ms mt mu mv mw mx my mz na nb nc nd ne nf ng nh ni nj nk nl go bg">With Decision Tree being the simplest tree based method, we will fit the model on our data considering selected lag windows.</p><pre class="nq nr ns nt nu os ot ou ov ae ow bg"><span id="ad8c" class="ox oy gv ot b oz pa pb e pc pd">#preparing data for test run<br/>X = np.log1p(history.iloc[:, -best_window:])<br/>#staking it with page features<br/>X = np.hstack((X_pagename, X))</span><span id="bc5b" class="ox oy gv ot b oz ps pb e pc pd">#fitting a RF Regressor model with best parameters<br/>dt_regressor = DecisionTreeRegressor(max_depth = best_depth,<br/>               min_samples_split = best_split, random_state=45)<br/>dt_regressor.fit(X, Y)</span><span id="938f" class="ox oy gv ot b oz ps pb e pc pd">#saving the model<br/>joblib.dump(dt_regressor, &#x27;./ML_MODEL-decisiontree_regressor.sav&#x27;)</span></pre><figure class="nq nr ns nt nu md nn no paragraph-image"><div role="button" tabindex="0" class="pf pg ek ph bd pi"><span class="eo ep eq ai er es et eu ev speechify-ignore">Press enter or click to view image in full size</span><div class="nn no px"><picture><source srcSet="https://miro.medium.com/v2/resize:fit:640/format:webp/1*4VwSBBB3DJQopDjDChnCwA.png 640w, https://miro.medium.com/v2/resize:fit:720/format:webp/1*4VwSBBB3DJQopDjDChnCwA.png 720w, https://miro.medium.com/v2/resize:fit:750/format:webp/1*4VwSBBB3DJQopDjDChnCwA.png 750w, https://miro.medium.com/v2/resize:fit:786/format:webp/1*4VwSBBB3DJQopDjDChnCwA.png 786w, https://miro.medium.com/v2/resize:fit:828/format:webp/1*4VwSBBB3DJQopDjDChnCwA.png 828w, https://miro.medium.com/v2/resize:fit:1100/format:webp/1*4VwSBBB3DJQopDjDChnCwA.png 1100w, https://miro.medium.com/v2/resize:fit:1400/format:webp/1*4VwSBBB3DJQopDjDChnCwA.png 1400w" sizes="(min-resolution: 4dppx) and (max-width: 700px) 50vw, (-webkit-min-device-pixel-ratio: 4) and (max-width: 700px) 50vw, (min-resolution: 3dppx) and (max-width: 700px) 67vw, (-webkit-min-device-pixel-ratio: 3) and (max-width: 700px) 65vw, (min-resolution: 2.5dppx) and (max-width: 700px) 80vw, (-webkit-min-device-pixel-ratio: 2.5) and (max-width: 700px) 80vw, (min-resolution: 2dppx) and (max-width: 700px) 100vw, (-webkit-min-device-pixel-ratio: 2) and (max-width: 700px) 100vw, 700px" type="image/webp"/><source data-testid="og" srcSet="https://miro.medium.com/v2/resize:fit:640/1*4VwSBBB3DJQopDjDChnCwA.png 640w, https://miro.medium.com/v2/resize:fit:720/1*4VwSBBB3DJQopDjDChnCwA.png 720w, https://miro.medium.com/v2/resize:fit:750/1*4VwSBBB3DJQopDjDChnCwA.png 750w, https://miro.medium.com/v2/resize:fit:786/1*4VwSBBB3DJQopDjDChnCwA.png 786w, https://miro.medium.com/v2/resize:fit:828/1*4VwSBBB3DJQopDjDChnCwA.png 828w, https://miro.medium.com/v2/resize:fit:1100/1*4VwSBBB3DJQopDjDChnCwA.png 1100w, https://miro.medium.com/v2/resize:fit:1400/1*4VwSBBB3DJQopDjDChnCwA.png 1400w" sizes="(min-resolution: 4dppx) and (max-width: 700px) 50vw, (-webkit-min-device-pixel-ratio: 4) and (max-width: 700px) 50vw, (min-resolution: 3dppx) and (max-width: 700px) 67vw, (-webkit-min-device-pixel-ratio: 3) and (max-width: 700px) 65vw, (min-resolution: 2.5dppx) and (max-width: 700px) 80vw, (-webkit-min-device-pixel-ratio: 2.5) and (max-width: 700px) 80vw, (min-resolution: 2dppx) and (max-width: 700px) 100vw, (-webkit-min-device-pixel-ratio: 2) and (max-width: 700px) 100vw, 700px"/><img alt="" class="bd ln mj c" width="700" height="303" loading="lazy" role="presentation"/></picture></div></div></figure><p id="dc84" class="pw-post-body-paragraph mn mo gv mq b mr ms mt mu mv mw mx my mz na nb nc nd ne nf ng nh ni nj nk nl go bg">Clearly, we can see that the model performance is far better in Decision Tree compared to that of previous models that we saw.</p><ul class=""><li id="1384" class="mn mo gv mq b mr ms mt mu mv mw mx my mz na nb nc nd ne nf ng nh ni nj nk nl oj ok ol bg"><strong class="mq gw"><em class="mp">AdaBoost Regressor :</em></strong></li></ul><p id="d604" class="pw-post-body-paragraph mn mo gv mq b mr ms mt mu mv mw mx my mz na nb nc nd ne nf ng nh ni nj nk nl go bg">With the best decision tree that we obtain from above technique, we will fit the AdaBoost Regressor which used the decision tree for n number of times so as to reduce variance. Here we minimize square loss.</p><pre class="nq nr ns nt nu os ot ou ov ae ow bg"><span id="0ec5" class="ox oy gv ot b oz pa pb e pc pd">#preparing data for test run<br/>X = np.log1p(history.iloc[:, -best_window:])<br/>#staking it with page features<br/>X = np.hstack((X_pagename, X))</span><span id="ee43" class="ox oy gv ot b oz ps pb e pc pd">#fitting a RF Regressor model with best parameters<br/>adaboost = AdaBoostRegressor(base_estimator = best_decision_tree,<br/>           n_estimators = best_estimators, learning_rate = best_lr,<br/>           loss=&#x27;square&#x27;, random_state=45) <br/>adaboost.fit(X, Y)</span><span id="7fb1" class="ox oy gv ot b oz ps pb e pc pd">#saving the model<br/>joblib.dump(adaboost, &#x27;./ML_MODEL-adaboost_regressor.sav&#x27;)</span></pre><figure class="nq nr ns nt nu md nn no paragraph-image"><div role="button" tabindex="0" class="pf pg ek ph bd pi"><span class="eo ep eq ai er es et eu ev speechify-ignore">Press enter or click to view image in full size</span><div class="nn no pv"><picture><source srcSet="https://miro.medium.com/v2/resize:fit:640/format:webp/1*URBkosGwNmcuHoRB3c7Ljw.png 640w, https://miro.medium.com/v2/resize:fit:720/format:webp/1*URBkosGwNmcuHoRB3c7Ljw.png 720w, https://miro.medium.com/v2/resize:fit:750/format:webp/1*URBkosGwNmcuHoRB3c7Ljw.png 750w, https://miro.medium.com/v2/resize:fit:786/format:webp/1*URBkosGwNmcuHoRB3c7Ljw.png 786w, https://miro.medium.com/v2/resize:fit:828/format:webp/1*URBkosGwNmcuHoRB3c7Ljw.png 828w, https://miro.medium.com/v2/resize:fit:1100/format:webp/1*URBkosGwNmcuHoRB3c7Ljw.png 1100w, https://miro.medium.com/v2/resize:fit:1400/format:webp/1*URBkosGwNmcuHoRB3c7Ljw.png 1400w" sizes="(min-resolution: 4dppx) and (max-width: 700px) 50vw, (-webkit-min-device-pixel-ratio: 4) and (max-width: 700px) 50vw, (min-resolution: 3dppx) and (max-width: 700px) 67vw, (-webkit-min-device-pixel-ratio: 3) and (max-width: 700px) 65vw, (min-resolution: 2.5dppx) and (max-width: 700px) 80vw, (-webkit-min-device-pixel-ratio: 2.5) and (max-width: 700px) 80vw, (min-resolution: 2dppx) and (max-width: 700px) 100vw, (-webkit-min-device-pixel-ratio: 2) and (max-width: 700px) 100vw, 700px" type="image/webp"/><source data-testid="og" srcSet="https://miro.medium.com/v2/resize:fit:640/1*URBkosGwNmcuHoRB3c7Ljw.png 640w, https://miro.medium.com/v2/resize:fit:720/1*URBkosGwNmcuHoRB3c7Ljw.png 720w, https://miro.medium.com/v2/resize:fit:750/1*URBkosGwNmcuHoRB3c7Ljw.png 750w, https://miro.medium.com/v2/resize:fit:786/1*URBkosGwNmcuHoRB3c7Ljw.png 786w, https://miro.medium.com/v2/resize:fit:828/1*URBkosGwNmcuHoRB3c7Ljw.png 828w, https://miro.medium.com/v2/resize:fit:1100/1*URBkosGwNmcuHoRB3c7Ljw.png 1100w, https://miro.medium.com/v2/resize:fit:1400/1*URBkosGwNmcuHoRB3c7Ljw.png 1400w" sizes="(min-resolution: 4dppx) and (max-width: 700px) 50vw, (-webkit-min-device-pixel-ratio: 4) and (max-width: 700px) 50vw, (min-resolution: 3dppx) and (max-width: 700px) 67vw, (-webkit-min-device-pixel-ratio: 3) and (max-width: 700px) 65vw, (min-resolution: 2.5dppx) and (max-width: 700px) 80vw, (-webkit-min-device-pixel-ratio: 2.5) and (max-width: 700px) 80vw, (min-resolution: 2dppx) and (max-width: 700px) 100vw, (-webkit-min-device-pixel-ratio: 2) and (max-width: 700px) 100vw, 700px"/><img alt="" class="bd ln mj c" width="700" height="298" loading="lazy" role="presentation"/></picture></div></div></figure><p id="0e9d" class="pw-post-body-paragraph mn mo gv mq b mr ms mt mu mv mw mx my mz na nb nc nd ne nf ng nh ni nj nk nl go bg">Performance of AdaBoost is average considering the mean values of the Cross Validation dataset. Compared to Decision Tree, it is comparatively less effective.</p><p id="4276" class="pw-post-body-paragraph mn mo gv mq b mr ms mt mu mv mw mx my mz na nb nc nd ne nf ng nh ni nj nk nl go bg">With Tree based methods are working fine with the data, we can use Ensembles to even further boost the performance.</p><p id="9026" class="pw-post-body-paragraph mn mo gv mq b mr ms mt mu mv mw mx my mz na nb nc nd ne nf ng nh ni nj nk nl go bg"><strong class="mq gw"><em class="mp">ML Modeling : Ensembles</em></strong></p><ul class=""><li id="3eeb" class="mn mo gv mq b mr ms mt mu mv mw mx my mz na nb nc nd ne nf ng nh ni nj nk nl oj ok ol bg"><strong class="mq gw"><em class="mp">Random Forest (RF)</em></strong></li></ul><p id="90ee" class="pw-post-body-paragraph mn mo gv mq b mr ms mt mu mv mw mx my mz na nb nc nd ne nf ng nh ni nj nk nl go bg">Modeling of Random Forest will be carried out with multiple high variance models so as to reduce overall variance of the model.</p><p id="87bd" class="pw-post-body-paragraph mn mo gv mq b mr ms mt mu mv mw mx my mz na nb nc nd ne nf ng nh ni nj nk nl go bg">We did Randomized search for this modeling, which found the best parameters for the model</p><pre class="nq nr ns nt nu os ot ou ov ae ow bg"><span id="e1d1" class="ox oy gv ot b oz pa pb e pc pd">#preparing data for test run<br/>X = np.log1p(history.iloc[:, -best_window:])<br/>#staking it with page features<br/>X = np.hstack((X_pagename, X))</span><span id="3212" class="ox oy gv ot b oz ps pb e pc pd">randomforest = RandomForestRegressor(n_estimators = best_estimator,<br/>               max_depth = best_depth,<br/>               min_samples_split = best_split,<br/>               n_jobs=-1, random_state=45)<br/>randomforest.fit(X, Y)<br/>#saving the best fit mode<br/>import joblib<br/>joblib.dump(randomforest, &#x27;./ML_MODEL-randomforest_regression.sav&#x27;)</span></pre><figure class="nq nr ns nt nu md nn no paragraph-image"><div role="button" tabindex="0" class="pf pg ek ph bd pi"><span class="eo ep eq ai er es et eu ev speechify-ignore">Press enter or click to view image in full size</span><div class="nn no py"><picture><source srcSet="https://miro.medium.com/v2/resize:fit:640/format:webp/1*io1QacBQ7eHEu975CxCB2w.png 640w, https://miro.medium.com/v2/resize:fit:720/format:webp/1*io1QacBQ7eHEu975CxCB2w.png 720w, https://miro.medium.com/v2/resize:fit:750/format:webp/1*io1QacBQ7eHEu975CxCB2w.png 750w, https://miro.medium.com/v2/resize:fit:786/format:webp/1*io1QacBQ7eHEu975CxCB2w.png 786w, https://miro.medium.com/v2/resize:fit:828/format:webp/1*io1QacBQ7eHEu975CxCB2w.png 828w, https://miro.medium.com/v2/resize:fit:1100/format:webp/1*io1QacBQ7eHEu975CxCB2w.png 1100w, https://miro.medium.com/v2/resize:fit:1400/format:webp/1*io1QacBQ7eHEu975CxCB2w.png 1400w" sizes="(min-resolution: 4dppx) and (max-width: 700px) 50vw, (-webkit-min-device-pixel-ratio: 4) and (max-width: 700px) 50vw, (min-resolution: 3dppx) and (max-width: 700px) 67vw, (-webkit-min-device-pixel-ratio: 3) and (max-width: 700px) 65vw, (min-resolution: 2.5dppx) and (max-width: 700px) 80vw, (-webkit-min-device-pixel-ratio: 2.5) and (max-width: 700px) 80vw, (min-resolution: 2dppx) and (max-width: 700px) 100vw, (-webkit-min-device-pixel-ratio: 2) and (max-width: 700px) 100vw, 700px" type="image/webp"/><source data-testid="og" srcSet="https://miro.medium.com/v2/resize:fit:640/1*io1QacBQ7eHEu975CxCB2w.png 640w, https://miro.medium.com/v2/resize:fit:720/1*io1QacBQ7eHEu975CxCB2w.png 720w, https://miro.medium.com/v2/resize:fit:750/1*io1QacBQ7eHEu975CxCB2w.png 750w, https://miro.medium.com/v2/resize:fit:786/1*io1QacBQ7eHEu975CxCB2w.png 786w, https://miro.medium.com/v2/resize:fit:828/1*io1QacBQ7eHEu975CxCB2w.png 828w, https://miro.medium.com/v2/resize:fit:1100/1*io1QacBQ7eHEu975CxCB2w.png 1100w, https://miro.medium.com/v2/resize:fit:1400/1*io1QacBQ7eHEu975CxCB2w.png 1400w" sizes="(min-resolution: 4dppx) and (max-width: 700px) 50vw, (-webkit-min-device-pixel-ratio: 4) and (max-width: 700px) 50vw, (min-resolution: 3dppx) and (max-width: 700px) 67vw, (-webkit-min-device-pixel-ratio: 3) and (max-width: 700px) 65vw, (min-resolution: 2.5dppx) and (max-width: 700px) 80vw, (-webkit-min-device-pixel-ratio: 2.5) and (max-width: 700px) 80vw, (min-resolution: 2dppx) and (max-width: 700px) 100vw, (-webkit-min-device-pixel-ratio: 2) and (max-width: 700px) 100vw, 700px"/><img alt="" class="bd ln mj c" width="700" height="293" loading="lazy" role="presentation"/></picture></div></div></figure><p id="54af" class="pw-post-body-paragraph mn mo gv mq b mr ms mt mu mv mw mx my mz na nb nc nd ne nf ng nh ni nj nk nl go bg">RF model tries to get close to the actual values in the initial run but eventually predicts the page views linearly as seen above.</p><ul class=""><li id="5981" class="mn mo gv mq b mr ms mt mu mv mw mx my mz na nb nc nd ne nf ng nh ni nj nk nl oj ok ol bg"><strong class="mq gw"><em class="mp">XGBoost</em></strong></li></ul><p id="0ab5" class="pw-post-body-paragraph mn mo gv mq b mr ms mt mu mv mw mx my mz na nb nc nd ne nf ng nh ni nj nk nl go bg">Now, we will model with High Bias model with XGBoost Technique.</p><pre class="nq nr ns nt nu os ot ou ov ae ow bg"><span id="c75a" class="ox oy gv ot b oz pa pb e pc pd">#preparing data for test run<br/>X = np.log1p(history.iloc[:, -best_window:])<br/>#staking it with page features<br/>X = np.hstack((X_pagename, X))</span><span id="5c75" class="ox oy gv ot b oz ps pb e pc pd">xgboost = xgb.XGBRegressor(objective = &#x27;reg:squarederror&#x27;,<br/>          n_estimators = best_estimators, <br/>          max_depth = best_depth, <br/>          learning_rate = best_learning_rate, <br/>          colsample_bytree = best_colsample_bytree, <br/>          n_jobs=-1, random_state=45)<br/>xgboost.fit(X, Y)<br/>#saving the best fit mode<br/>joblib.dump(xgboost, &#x27;./ML_MODEL-xgboost_regressor.sav&#x27;)</span></pre><figure class="nq nr ns nt nu md nn no paragraph-image"><div role="button" tabindex="0" class="pf pg ek ph bd pi"><span class="eo ep eq ai er es et eu ev speechify-ignore">Press enter or click to view image in full size</span><div class="nn no pv"><picture><source srcSet="https://miro.medium.com/v2/resize:fit:640/format:webp/1*X5kcLyP8YWzersIzYg197Q.png 640w, https://miro.medium.com/v2/resize:fit:720/format:webp/1*X5kcLyP8YWzersIzYg197Q.png 720w, https://miro.medium.com/v2/resize:fit:750/format:webp/1*X5kcLyP8YWzersIzYg197Q.png 750w, https://miro.medium.com/v2/resize:fit:786/format:webp/1*X5kcLyP8YWzersIzYg197Q.png 786w, https://miro.medium.com/v2/resize:fit:828/format:webp/1*X5kcLyP8YWzersIzYg197Q.png 828w, https://miro.medium.com/v2/resize:fit:1100/format:webp/1*X5kcLyP8YWzersIzYg197Q.png 1100w, https://miro.medium.com/v2/resize:fit:1400/format:webp/1*X5kcLyP8YWzersIzYg197Q.png 1400w" sizes="(min-resolution: 4dppx) and (max-width: 700px) 50vw, (-webkit-min-device-pixel-ratio: 4) and (max-width: 700px) 50vw, (min-resolution: 3dppx) and (max-width: 700px) 67vw, (-webkit-min-device-pixel-ratio: 3) and (max-width: 700px) 65vw, (min-resolution: 2.5dppx) and (max-width: 700px) 80vw, (-webkit-min-device-pixel-ratio: 2.5) and (max-width: 700px) 80vw, (min-resolution: 2dppx) and (max-width: 700px) 100vw, (-webkit-min-device-pixel-ratio: 2) and (max-width: 700px) 100vw, 700px" type="image/webp"/><source data-testid="og" srcSet="https://miro.medium.com/v2/resize:fit:640/1*X5kcLyP8YWzersIzYg197Q.png 640w, https://miro.medium.com/v2/resize:fit:720/1*X5kcLyP8YWzersIzYg197Q.png 720w, https://miro.medium.com/v2/resize:fit:750/1*X5kcLyP8YWzersIzYg197Q.png 750w, https://miro.medium.com/v2/resize:fit:786/1*X5kcLyP8YWzersIzYg197Q.png 786w, https://miro.medium.com/v2/resize:fit:828/1*X5kcLyP8YWzersIzYg197Q.png 828w, https://miro.medium.com/v2/resize:fit:1100/1*X5kcLyP8YWzersIzYg197Q.png 1100w, https://miro.medium.com/v2/resize:fit:1400/1*X5kcLyP8YWzersIzYg197Q.png 1400w" sizes="(min-resolution: 4dppx) and (max-width: 700px) 50vw, (-webkit-min-device-pixel-ratio: 4) and (max-width: 700px) 50vw, (min-resolution: 3dppx) and (max-width: 700px) 67vw, (-webkit-min-device-pixel-ratio: 3) and (max-width: 700px) 65vw, (min-resolution: 2.5dppx) and (max-width: 700px) 80vw, (-webkit-min-device-pixel-ratio: 2.5) and (max-width: 700px) 80vw, (min-resolution: 2dppx) and (max-width: 700px) 100vw, (-webkit-min-device-pixel-ratio: 2) and (max-width: 700px) 100vw, 700px"/><img alt="" class="bd ln mj c" width="700" height="286" loading="lazy" role="presentation"/></picture></div></div></figure><p id="21d8" class="pw-post-body-paragraph mn mo gv mq b mr ms mt mu mv mw mx my mz na nb nc nd ne nf ng nh ni nj nk nl go bg">Over forecasting can be easily seen on the CV data with XGBoost Modeling. Also, the mean values of page views are also predicted to be very high but comparing these values with the mean page view distribution, the nature of the actual observations are maintained in this.</p><ul class=""><li id="13b6" class="mn mo gv mq b mr ms mt mu mv mw mx my mz na nb nc nd ne nf ng nh ni nj nk nl oj ok ol bg"><strong class="mq gw"><em class="mp">ML Modeling : Overall Models Performances</em></strong></li></ul><p id="ee36" class="pw-post-body-paragraph mn mo gv mq b mr ms mt mu mv mw mx my mz na nb nc nd ne nf ng nh ni nj nk nl go bg">Tabulating the performance of each of ML model on Cross Validation data as well on actual Test data. Kaggle score for the Test data is also added.</p><figure class="nq nr ns nt nu md nn no paragraph-image"><div role="button" tabindex="0" class="pf pg ek ph bd pi"><span class="eo ep eq ai er es et eu ev speechify-ignore">Press enter or click to view image in full size</span><div class="nn no pz"><picture><source srcSet="https://miro.medium.com/v2/resize:fit:640/format:webp/1*z5EtWLEBU_JeMKlfE63sbw.png 640w, https://miro.medium.com/v2/resize:fit:720/format:webp/1*z5EtWLEBU_JeMKlfE63sbw.png 720w, https://miro.medium.com/v2/resize:fit:750/format:webp/1*z5EtWLEBU_JeMKlfE63sbw.png 750w, https://miro.medium.com/v2/resize:fit:786/format:webp/1*z5EtWLEBU_JeMKlfE63sbw.png 786w, https://miro.medium.com/v2/resize:fit:828/format:webp/1*z5EtWLEBU_JeMKlfE63sbw.png 828w, https://miro.medium.com/v2/resize:fit:1100/format:webp/1*z5EtWLEBU_JeMKlfE63sbw.png 1100w, https://miro.medium.com/v2/resize:fit:1400/format:webp/1*z5EtWLEBU_JeMKlfE63sbw.png 1400w" sizes="(min-resolution: 4dppx) and (max-width: 700px) 50vw, (-webkit-min-device-pixel-ratio: 4) and (max-width: 700px) 50vw, (min-resolution: 3dppx) and (max-width: 700px) 67vw, (-webkit-min-device-pixel-ratio: 3) and (max-width: 700px) 65vw, (min-resolution: 2.5dppx) and (max-width: 700px) 80vw, (-webkit-min-device-pixel-ratio: 2.5) and (max-width: 700px) 80vw, (min-resolution: 2dppx) and (max-width: 700px) 100vw, (-webkit-min-device-pixel-ratio: 2) and (max-width: 700px) 100vw, 700px" type="image/webp"/><source data-testid="og" srcSet="https://miro.medium.com/v2/resize:fit:640/1*z5EtWLEBU_JeMKlfE63sbw.png 640w, https://miro.medium.com/v2/resize:fit:720/1*z5EtWLEBU_JeMKlfE63sbw.png 720w, https://miro.medium.com/v2/resize:fit:750/1*z5EtWLEBU_JeMKlfE63sbw.png 750w, https://miro.medium.com/v2/resize:fit:786/1*z5EtWLEBU_JeMKlfE63sbw.png 786w, https://miro.medium.com/v2/resize:fit:828/1*z5EtWLEBU_JeMKlfE63sbw.png 828w, https://miro.medium.com/v2/resize:fit:1100/1*z5EtWLEBU_JeMKlfE63sbw.png 1100w, https://miro.medium.com/v2/resize:fit:1400/1*z5EtWLEBU_JeMKlfE63sbw.png 1400w" sizes="(min-resolution: 4dppx) and (max-width: 700px) 50vw, (-webkit-min-device-pixel-ratio: 4) and (max-width: 700px) 50vw, (min-resolution: 3dppx) and (max-width: 700px) 67vw, (-webkit-min-device-pixel-ratio: 3) and (max-width: 700px) 65vw, (min-resolution: 2.5dppx) and (max-width: 700px) 80vw, (-webkit-min-device-pixel-ratio: 2.5) and (max-width: 700px) 80vw, (min-resolution: 2dppx) and (max-width: 700px) 100vw, (-webkit-min-device-pixel-ratio: 2) and (max-width: 700px) 100vw, 700px"/><img alt="" class="bd ln mj c" width="700" height="194" loading="lazy" role="presentation"/></picture></div></div></figure></div></div></div><div class="v cf oa ob oc od" role="separator"><span class="oe bu bi of og oh"></span><span class="oe bu bi of og oh"></span><span class="oe bu bi of og"></span></div><div class="go gp gq gr gs"><div class="v cf"><div class="cm bd ga gb gc gd"><blockquote class="mk ml mm"><p id="106f" class="mn mo mp mq b mr ms mt mu mv mw mx my mz na nb nc nd ne nf ng nh ni nj nk nl go bg"><strong class="mq gw"><em class="gv">Modeling : DL Modeling</em></strong></p></blockquote><p id="a20f" class="pw-post-body-paragraph mn mo gv mq b mr ms mt mu mv mw mx my mz na nb nc nd ne nf ng nh ni nj nk nl go bg">With the trending Deep Learning modeling, we can try to find the best solution possible for this time series problem. As time series is a data comprising of series of dependent values, we can make use concept of RNNs to build the modeling. Also, treating this as 1-Dimensional array, we can also build the CNN modeling for the data.</p><ul class=""><li id="a0fb" class="mn mo gv mq b mr ms mt mu mv mw mx my mz na nb nc nd ne nf ng nh ni nj nk nl oj ok ol bg"><strong class="mq gw"><em class="mp">DL Modeling : Simple DNN</em></strong></li></ul><pre class="nq nr ns nt nu os ot ou ov ae ow bg"><span id="c4db" class="ox oy gv ot b oz pa pb e pc pd">#simple DNN model<br/>def dense_model(shape, print_summary=False):<br/>  model = Sequential()<br/>  model.add(Dense(512, activation=&#x27;tanh&#x27;, input_shape=(shape, )))<br/>  model.add(Dense(128, activation=&#x27;tanh&#x27;))<br/>  model.add(Dense(64, activation=&#x27;tanh&#x27;))<br/>  model.add(Dense(8, activation=&#x27;tanh&#x27;))<br/>  model.add(Dense(1))<br/>  model.compile(loss=&#x27;mean_squared_error&#x27;, <br/>                optimizer=&#x27;adam&#x27;, metrics=[tf_smape])<br/>  return model</span><span id="d89f" class="ox oy gv ot b oz ps pb e pc pd">#making the train data<br/>X = np.log1p(X_timeseries.iloc[:,-best_window-1:-1])<br/>Y = np.log1p(X_timeseries.iloc[:,-1])<br/> <br/>#fitting model with best parameters<br/>model = dense_model(best_window, print_summary=True)<br/>model.fit(X, Y, batch_size=batch, epochs=epoch, verbose=1)<br/> <br/>#save the model weights<br/>my_model = model.to_json()<br/>with open(&quot;dnn_model.json&quot;, &quot;w&quot;) as json_file:<br/>  json_file.write(my_model)<br/>model.save_weights(&quot;dnn_model_weights.h5&quot;)</span></pre><p id="0622" class="pw-post-body-paragraph mn mo gv mq b mr ms mt mu mv mw mx my mz na nb nc nd ne nf ng nh ni nj nk nl go bg">With the best lagged window, we can train the simple DNN model.</p><figure class="nq nr ns nt nu md nn no paragraph-image"><div class="nn no qa"><picture><source srcSet="https://miro.medium.com/v2/resize:fit:640/format:webp/1*m7mYl1i3xPsM4bANgevKmg.png 640w, https://miro.medium.com/v2/resize:fit:720/format:webp/1*m7mYl1i3xPsM4bANgevKmg.png 720w, https://miro.medium.com/v2/resize:fit:750/format:webp/1*m7mYl1i3xPsM4bANgevKmg.png 750w, https://miro.medium.com/v2/resize:fit:786/format:webp/1*m7mYl1i3xPsM4bANgevKmg.png 786w, https://miro.medium.com/v2/resize:fit:828/format:webp/1*m7mYl1i3xPsM4bANgevKmg.png 828w, https://miro.medium.com/v2/resize:fit:1100/format:webp/1*m7mYl1i3xPsM4bANgevKmg.png 1100w, https://miro.medium.com/v2/resize:fit:1278/format:webp/1*m7mYl1i3xPsM4bANgevKmg.png 1278w" sizes="(min-resolution: 4dppx) and (max-width: 700px) 50vw, (-webkit-min-device-pixel-ratio: 4) and (max-width: 700px) 50vw, (min-resolution: 3dppx) and (max-width: 700px) 67vw, (-webkit-min-device-pixel-ratio: 3) and (max-width: 700px) 65vw, (min-resolution: 2.5dppx) and (max-width: 700px) 80vw, (-webkit-min-device-pixel-ratio: 2.5) and (max-width: 700px) 80vw, (min-resolution: 2dppx) and (max-width: 700px) 100vw, (-webkit-min-device-pixel-ratio: 2) and (max-width: 700px) 100vw, 639px" type="image/webp"/><source data-testid="og" srcSet="https://miro.medium.com/v2/resize:fit:640/1*m7mYl1i3xPsM4bANgevKmg.png 640w, https://miro.medium.com/v2/resize:fit:720/1*m7mYl1i3xPsM4bANgevKmg.png 720w, https://miro.medium.com/v2/resize:fit:750/1*m7mYl1i3xPsM4bANgevKmg.png 750w, https://miro.medium.com/v2/resize:fit:786/1*m7mYl1i3xPsM4bANgevKmg.png 786w, https://miro.medium.com/v2/resize:fit:828/1*m7mYl1i3xPsM4bANgevKmg.png 828w, https://miro.medium.com/v2/resize:fit:1100/1*m7mYl1i3xPsM4bANgevKmg.png 1100w, https://miro.medium.com/v2/resize:fit:1278/1*m7mYl1i3xPsM4bANgevKmg.png 1278w" sizes="(min-resolution: 4dppx) and (max-width: 700px) 50vw, (-webkit-min-device-pixel-ratio: 4) and (max-width: 700px) 50vw, (min-resolution: 3dppx) and (max-width: 700px) 67vw, (-webkit-min-device-pixel-ratio: 3) and (max-width: 700px) 65vw, (min-resolution: 2.5dppx) and (max-width: 700px) 80vw, (-webkit-min-device-pixel-ratio: 2.5) and (max-width: 700px) 80vw, (min-resolution: 2dppx) and (max-width: 700px) 100vw, (-webkit-min-device-pixel-ratio: 2) and (max-width: 700px) 100vw, 639px"/><img alt="" class="bd ln mj c" width="639" height="576" loading="lazy" role="presentation"/></picture></div><figcaption class="nv nw nx nn no ny nz bb b bc u eb">Fitting DNN model with train data</figcaption></figure><figure class="nq nr ns nt nu md nn no paragraph-image"><div role="button" tabindex="0" class="pf pg ek ph bd pi"><span class="eo ep eq ai er es et eu ev speechify-ignore">Press enter or click to view image in full size</span><div class="nn no qb"><picture><source srcSet="https://miro.medium.com/v2/resize:fit:640/format:webp/1*JDoQTEYxN3eqkLuDoSfM8g.png 640w, https://miro.medium.com/v2/resize:fit:720/format:webp/1*JDoQTEYxN3eqkLuDoSfM8g.png 720w, https://miro.medium.com/v2/resize:fit:750/format:webp/1*JDoQTEYxN3eqkLuDoSfM8g.png 750w, https://miro.medium.com/v2/resize:fit:786/format:webp/1*JDoQTEYxN3eqkLuDoSfM8g.png 786w, https://miro.medium.com/v2/resize:fit:828/format:webp/1*JDoQTEYxN3eqkLuDoSfM8g.png 828w, https://miro.medium.com/v2/resize:fit:1100/format:webp/1*JDoQTEYxN3eqkLuDoSfM8g.png 1100w, https://miro.medium.com/v2/resize:fit:1400/format:webp/1*JDoQTEYxN3eqkLuDoSfM8g.png 1400w" sizes="(min-resolution: 4dppx) and (max-width: 700px) 50vw, (-webkit-min-device-pixel-ratio: 4) and (max-width: 700px) 50vw, (min-resolution: 3dppx) and (max-width: 700px) 67vw, (-webkit-min-device-pixel-ratio: 3) and (max-width: 700px) 65vw, (min-resolution: 2.5dppx) and (max-width: 700px) 80vw, (-webkit-min-device-pixel-ratio: 2.5) and (max-width: 700px) 80vw, (min-resolution: 2dppx) and (max-width: 700px) 100vw, (-webkit-min-device-pixel-ratio: 2) and (max-width: 700px) 100vw, 700px" type="image/webp"/><source data-testid="og" srcSet="https://miro.medium.com/v2/resize:fit:640/1*JDoQTEYxN3eqkLuDoSfM8g.png 640w, https://miro.medium.com/v2/resize:fit:720/1*JDoQTEYxN3eqkLuDoSfM8g.png 720w, https://miro.medium.com/v2/resize:fit:750/1*JDoQTEYxN3eqkLuDoSfM8g.png 750w, https://miro.medium.com/v2/resize:fit:786/1*JDoQTEYxN3eqkLuDoSfM8g.png 786w, https://miro.medium.com/v2/resize:fit:828/1*JDoQTEYxN3eqkLuDoSfM8g.png 828w, https://miro.medium.com/v2/resize:fit:1100/1*JDoQTEYxN3eqkLuDoSfM8g.png 1100w, https://miro.medium.com/v2/resize:fit:1400/1*JDoQTEYxN3eqkLuDoSfM8g.png 1400w" sizes="(min-resolution: 4dppx) and (max-width: 700px) 50vw, (-webkit-min-device-pixel-ratio: 4) and (max-width: 700px) 50vw, (min-resolution: 3dppx) and (max-width: 700px) 67vw, (-webkit-min-device-pixel-ratio: 3) and (max-width: 700px) 65vw, (min-resolution: 2.5dppx) and (max-width: 700px) 80vw, (-webkit-min-device-pixel-ratio: 2.5) and (max-width: 700px) 80vw, (min-resolution: 2dppx) and (max-width: 700px) 100vw, (-webkit-min-device-pixel-ratio: 2) and (max-width: 700px) 100vw, 700px"/><img alt="" class="bd ln mj c" width="700" height="298" loading="lazy" role="presentation"/></picture></div></div></figure><p id="f652" class="pw-post-body-paragraph mn mo gv mq b mr ms mt mu mv mw mx my mz na nb nc nd ne nf ng nh ni nj nk nl go bg">Model seems to be over-fitting to the training data. This over-fitting can be minimized with the help of hyper-parameter tuning of each of the layers of the model.</p><ul class=""><li id="f835" class="mn mo gv mq b mr ms mt mu mv mw mx my mz na nb nc nd ne nf ng nh ni nj nk nl oj ok ol bg"><strong class="mq gw"><em class="mp">DL Modeling : Modeling with LSTMs</em></strong></li></ul><p id="d8b4" class="pw-post-body-paragraph mn mo gv mq b mr ms mt mu mv mw mx my mz na nb nc nd ne nf ng nh ni nj nk nl go bg">Long Short Term Memory (LSTMs) are the Deep Neural Network blocks where the sequence information can be preserved for that instance. Here, page views for article being the time dependent values, we can make use of LSTMs for our modeling.</p><ul class=""><li id="f725" class="mn mo gv mq b mr ms mt mu mv mw mx my mz na nb nc nd ne nf ng nh ni nj nk nl oj ok ol bg"><em class="mp">One Layered LSTM model</em></li></ul><pre class="nq nr ns nt nu os ot ou ov ae ow bg"><span id="7d4b" class="ox oy gv ot b oz pa pb e pc pd">def lstm(shape, print_summary=False):<br/>    model = Sequential()<br/>    model.add(LSTM(64, activation=&#x27;tanh&#x27;, <br/>              return_sequences=True, input_shape=(shape, 1)))<br/>    model.add(LSTM(64, activation=&#x27;tanh&#x27;))<br/>    model.add(Dropout(0.5))<br/>    #model.add(Flatten())<br/>    model.add(Dense(1))<br/>    model.compile(loss=&#x27;mean_squared_error&#x27;, <br/>                  optimizer=&#x27;adam&#x27;, metrics=[tf_smape])<br/>    return model</span><span id="ec45" class="ox oy gv ot b oz ps pb e pc pd">#fiting model with best parameters<br/>X = np.log1p(X_timeseries.iloc[:,-best_window-1:-1])<br/>r, c = X.shape<br/>X = np.array(X).reshape((r, c, 1))<br/>Y = np.log1p(X_timeseries.iloc[:,-1])<br/> <br/>#fitting model wth best parameters<br/>clear_session()<br/>model = lstm(best_window, print_summary=True)<br/>model.fit(X, Y, batch_size=batch, epochs=epoch, verbose=1)<br/> <br/>#save the model weights<br/>my_model = model.to_json()<br/>with open(&quot;lstm_model.json&quot;, &quot;w&quot;) as json_file:<br/>  json_file.write(my_model)<br/>model.save_weights(&quot;lstm_model_weights.h5&quot;)</span></pre><p id="0c5b" class="pw-post-body-paragraph mn mo gv mq b mr ms mt mu mv mw mx my mz na nb nc nd ne nf ng nh ni nj nk nl go bg">Fitting the model with best lagged data, to test the performance on CV data.</p><figure class="nq nr ns nt nu md nn no paragraph-image"><div class="nn no qc"><picture><source srcSet="https://miro.medium.com/v2/resize:fit:640/format:webp/1*szT2Dz4xT2LC0E9aLYjlpA.png 640w, https://miro.medium.com/v2/resize:fit:720/format:webp/1*szT2Dz4xT2LC0E9aLYjlpA.png 720w, https://miro.medium.com/v2/resize:fit:750/format:webp/1*szT2Dz4xT2LC0E9aLYjlpA.png 750w, https://miro.medium.com/v2/resize:fit:786/format:webp/1*szT2Dz4xT2LC0E9aLYjlpA.png 786w, https://miro.medium.com/v2/resize:fit:828/format:webp/1*szT2Dz4xT2LC0E9aLYjlpA.png 828w, https://miro.medium.com/v2/resize:fit:1100/format:webp/1*szT2Dz4xT2LC0E9aLYjlpA.png 1100w, https://miro.medium.com/v2/resize:fit:1336/format:webp/1*szT2Dz4xT2LC0E9aLYjlpA.png 1336w" sizes="(min-resolution: 4dppx) and (max-width: 700px) 50vw, (-webkit-min-device-pixel-ratio: 4) and (max-width: 700px) 50vw, (min-resolution: 3dppx) and (max-width: 700px) 67vw, (-webkit-min-device-pixel-ratio: 3) and (max-width: 700px) 65vw, (min-resolution: 2.5dppx) and (max-width: 700px) 80vw, (-webkit-min-device-pixel-ratio: 2.5) and (max-width: 700px) 80vw, (min-resolution: 2dppx) and (max-width: 700px) 100vw, (-webkit-min-device-pixel-ratio: 2) and (max-width: 700px) 100vw, 668px" type="image/webp"/><source data-testid="og" srcSet="https://miro.medium.com/v2/resize:fit:640/1*szT2Dz4xT2LC0E9aLYjlpA.png 640w, https://miro.medium.com/v2/resize:fit:720/1*szT2Dz4xT2LC0E9aLYjlpA.png 720w, https://miro.medium.com/v2/resize:fit:750/1*szT2Dz4xT2LC0E9aLYjlpA.png 750w, https://miro.medium.com/v2/resize:fit:786/1*szT2Dz4xT2LC0E9aLYjlpA.png 786w, https://miro.medium.com/v2/resize:fit:828/1*szT2Dz4xT2LC0E9aLYjlpA.png 828w, https://miro.medium.com/v2/resize:fit:1100/1*szT2Dz4xT2LC0E9aLYjlpA.png 1100w, https://miro.medium.com/v2/resize:fit:1336/1*szT2Dz4xT2LC0E9aLYjlpA.png 1336w" sizes="(min-resolution: 4dppx) and (max-width: 700px) 50vw, (-webkit-min-device-pixel-ratio: 4) and (max-width: 700px) 50vw, (min-resolution: 3dppx) and (max-width: 700px) 67vw, (-webkit-min-device-pixel-ratio: 3) and (max-width: 700px) 65vw, (min-resolution: 2.5dppx) and (max-width: 700px) 80vw, (-webkit-min-device-pixel-ratio: 2.5) and (max-width: 700px) 80vw, (min-resolution: 2dppx) and (max-width: 700px) 100vw, (-webkit-min-device-pixel-ratio: 2) and (max-width: 700px) 100vw, 668px"/><img alt="" class="bd ln mj c" width="668" height="579" loading="lazy" role="presentation"/></picture></div></figure><figure class="nq nr ns nt nu md nn no paragraph-image"><div role="button" tabindex="0" class="pf pg ek ph bd pi"><span class="eo ep eq ai er es et eu ev speechify-ignore">Press enter or click to view image in full size</span><div class="nn no qd"><picture><source srcSet="https://miro.medium.com/v2/resize:fit:640/format:webp/1*Q0BAKsL4euEsremHNmW9OA.png 640w, https://miro.medium.com/v2/resize:fit:720/format:webp/1*Q0BAKsL4euEsremHNmW9OA.png 720w, https://miro.medium.com/v2/resize:fit:750/format:webp/1*Q0BAKsL4euEsremHNmW9OA.png 750w, https://miro.medium.com/v2/resize:fit:786/format:webp/1*Q0BAKsL4euEsremHNmW9OA.png 786w, https://miro.medium.com/v2/resize:fit:828/format:webp/1*Q0BAKsL4euEsremHNmW9OA.png 828w, https://miro.medium.com/v2/resize:fit:1100/format:webp/1*Q0BAKsL4euEsremHNmW9OA.png 1100w, https://miro.medium.com/v2/resize:fit:1400/format:webp/1*Q0BAKsL4euEsremHNmW9OA.png 1400w" sizes="(min-resolution: 4dppx) and (max-width: 700px) 50vw, (-webkit-min-device-pixel-ratio: 4) and (max-width: 700px) 50vw, (min-resolution: 3dppx) and (max-width: 700px) 67vw, (-webkit-min-device-pixel-ratio: 3) and (max-width: 700px) 65vw, (min-resolution: 2.5dppx) and (max-width: 700px) 80vw, (-webkit-min-device-pixel-ratio: 2.5) and (max-width: 700px) 80vw, (min-resolution: 2dppx) and (max-width: 700px) 100vw, (-webkit-min-device-pixel-ratio: 2) and (max-width: 700px) 100vw, 700px" type="image/webp"/><source data-testid="og" srcSet="https://miro.medium.com/v2/resize:fit:640/1*Q0BAKsL4euEsremHNmW9OA.png 640w, https://miro.medium.com/v2/resize:fit:720/1*Q0BAKsL4euEsremHNmW9OA.png 720w, https://miro.medium.com/v2/resize:fit:750/1*Q0BAKsL4euEsremHNmW9OA.png 750w, https://miro.medium.com/v2/resize:fit:786/1*Q0BAKsL4euEsremHNmW9OA.png 786w, https://miro.medium.com/v2/resize:fit:828/1*Q0BAKsL4euEsremHNmW9OA.png 828w, https://miro.medium.com/v2/resize:fit:1100/1*Q0BAKsL4euEsremHNmW9OA.png 1100w, https://miro.medium.com/v2/resize:fit:1400/1*Q0BAKsL4euEsremHNmW9OA.png 1400w" sizes="(min-resolution: 4dppx) and (max-width: 700px) 50vw, (-webkit-min-device-pixel-ratio: 4) and (max-width: 700px) 50vw, (min-resolution: 3dppx) and (max-width: 700px) 67vw, (-webkit-min-device-pixel-ratio: 3) and (max-width: 700px) 65vw, (min-resolution: 2.5dppx) and (max-width: 700px) 80vw, (-webkit-min-device-pixel-ratio: 2.5) and (max-width: 700px) 80vw, (min-resolution: 2dppx) and (max-width: 700px) 100vw, (-webkit-min-device-pixel-ratio: 2) and (max-width: 700px) 100vw, 700px"/><img alt="" class="bd ln mj c" width="700" height="302" loading="lazy" role="presentation"/></picture></div></div></figure><p id="f381" class="pw-post-body-paragraph mn mo gv mq b mr ms mt mu mv mw mx my mz na nb nc nd ne nf ng nh ni nj nk nl go bg">The data was under-fitting for the initial time stamps, but later was able to match up with the page view distribution. Let us understand how the same LSTMs work when we increase the LSTM layer in the model,</p><ul class=""><li id="5256" class="mn mo gv mq b mr ms mt mu mv mw mx my mz na nb nc nd ne nf ng nh ni nj nk nl oj ok ol bg"><em class="mp">Two Layered LSTM Model</em></li></ul><p id="f4fc" class="pw-post-body-paragraph mn mo gv mq b mr ms mt mu mv mw mx my mz na nb nc nd ne nf ng nh ni nj nk nl go bg">we will be using early stopping for these models by increasing the epochs for which the model is going to repeat itself.</p><pre class="nq nr ns nt nu os ot ou ov ae ow bg"><span id="f359" class="ox oy gv ot b oz pa pb e pc pd">from tensorflow.keras.callbacks import EarlyStopping<br/>dl_stopping = EarlyStopping(monitor=&#x27;tf_smape&#x27;, patience=3)</span><span id="897a" class="ox oy gv ot b oz ps pb e pc pd">def complex_lstm(shape, print_summary=False):<br/>    model = Sequential()<br/>    model.add(LSTM(64, activation=&#x27;tanh&#x27;, <br/>              return_sequences=True, input_shape=(shape, 1)))<br/>    model.add(LSTM(64, activation=&#x27;tanh&#x27;, return_sequences=True))<br/>    model.add(Dropout(0.5))<br/>    model.add(LSTM(8, activation=&#x27;tanh&#x27;))<br/>    model.add(Dropout(0.5))<br/>    model.add(Dense(1))<br/>    model.compile(loss=&#x27;mean_squared_error&#x27;, <br/>                  optimizer=&#x27;adam&#x27;, metrics=[tf_smape])<br/>    return model</span><span id="737a" class="ox oy gv ot b oz ps pb e pc pd">#fiting model with best parameters<br/>X = np.log1p(X_timeseries.iloc[:,-best_window-1:-1])<br/>r, c = X.shape<br/>X = np.array(X).reshape((r, c, 1))<br/>Y = np.log1p(X_timeseries.iloc[:,-1])<br/> <br/>#fitting model wth best parameters<br/>model = complex_lstm(best_window, print_summary=True)<br/>model.fit(X, Y, batch_size=batch, epochs=deep_epoch, \<br/>          verbose=1, callbacks=[dl_stopping])<br/> <br/>#save the model weights<br/>my_model = model.to_json()<br/>with open(&quot;complex_lstm_model.json&quot;, &quot;w&quot;) as json_file:<br/>  json_file.write(my_model)<br/>model.save_weights(&quot;complex_lstm_model_weights.h5&quot;)</span></pre><figure class="nq nr ns nt nu md nn no paragraph-image"><div class="nn no qe"><picture><source srcSet="https://miro.medium.com/v2/resize:fit:640/format:webp/1*UoYgFVdI7PbjIZ0GU48Sdw.png 640w, https://miro.medium.com/v2/resize:fit:720/format:webp/1*UoYgFVdI7PbjIZ0GU48Sdw.png 720w, https://miro.medium.com/v2/resize:fit:750/format:webp/1*UoYgFVdI7PbjIZ0GU48Sdw.png 750w, https://miro.medium.com/v2/resize:fit:786/format:webp/1*UoYgFVdI7PbjIZ0GU48Sdw.png 786w, https://miro.medium.com/v2/resize:fit:828/format:webp/1*UoYgFVdI7PbjIZ0GU48Sdw.png 828w, https://miro.medium.com/v2/resize:fit:1100/format:webp/1*UoYgFVdI7PbjIZ0GU48Sdw.png 1100w, https://miro.medium.com/v2/resize:fit:1294/format:webp/1*UoYgFVdI7PbjIZ0GU48Sdw.png 1294w" sizes="(min-resolution: 4dppx) and (max-width: 700px) 50vw, (-webkit-min-device-pixel-ratio: 4) and (max-width: 700px) 50vw, (min-resolution: 3dppx) and (max-width: 700px) 67vw, (-webkit-min-device-pixel-ratio: 3) and (max-width: 700px) 65vw, (min-resolution: 2.5dppx) and (max-width: 700px) 80vw, (-webkit-min-device-pixel-ratio: 2.5) and (max-width: 700px) 80vw, (min-resolution: 2dppx) and (max-width: 700px) 100vw, (-webkit-min-device-pixel-ratio: 2) and (max-width: 700px) 100vw, 647px" type="image/webp"/><source data-testid="og" srcSet="https://miro.medium.com/v2/resize:fit:640/1*UoYgFVdI7PbjIZ0GU48Sdw.png 640w, https://miro.medium.com/v2/resize:fit:720/1*UoYgFVdI7PbjIZ0GU48Sdw.png 720w, https://miro.medium.com/v2/resize:fit:750/1*UoYgFVdI7PbjIZ0GU48Sdw.png 750w, https://miro.medium.com/v2/resize:fit:786/1*UoYgFVdI7PbjIZ0GU48Sdw.png 786w, https://miro.medium.com/v2/resize:fit:828/1*UoYgFVdI7PbjIZ0GU48Sdw.png 828w, https://miro.medium.com/v2/resize:fit:1100/1*UoYgFVdI7PbjIZ0GU48Sdw.png 1100w, https://miro.medium.com/v2/resize:fit:1294/1*UoYgFVdI7PbjIZ0GU48Sdw.png 1294w" sizes="(min-resolution: 4dppx) and (max-width: 700px) 50vw, (-webkit-min-device-pixel-ratio: 4) and (max-width: 700px) 50vw, (min-resolution: 3dppx) and (max-width: 700px) 67vw, (-webkit-min-device-pixel-ratio: 3) and (max-width: 700px) 65vw, (min-resolution: 2.5dppx) and (max-width: 700px) 80vw, (-webkit-min-device-pixel-ratio: 2.5) and (max-width: 700px) 80vw, (min-resolution: 2dppx) and (max-width: 700px) 100vw, (-webkit-min-device-pixel-ratio: 2) and (max-width: 700px) 100vw, 647px"/><img alt="" class="bd ln mj c" width="647" height="434" loading="lazy" role="presentation"/></picture></div></figure><figure class="nq nr ns nt nu md nn no paragraph-image"><div role="button" tabindex="0" class="pf pg ek ph bd pi"><span class="eo ep eq ai er es et eu ev speechify-ignore">Press enter or click to view image in full size</span><div class="nn no qf"><picture><source srcSet="https://miro.medium.com/v2/resize:fit:640/format:webp/1*KnZHH2TrzWw-XBzTIx9bnw.png 640w, https://miro.medium.com/v2/resize:fit:720/format:webp/1*KnZHH2TrzWw-XBzTIx9bnw.png 720w, https://miro.medium.com/v2/resize:fit:750/format:webp/1*KnZHH2TrzWw-XBzTIx9bnw.png 750w, https://miro.medium.com/v2/resize:fit:786/format:webp/1*KnZHH2TrzWw-XBzTIx9bnw.png 786w, https://miro.medium.com/v2/resize:fit:828/format:webp/1*KnZHH2TrzWw-XBzTIx9bnw.png 828w, https://miro.medium.com/v2/resize:fit:1100/format:webp/1*KnZHH2TrzWw-XBzTIx9bnw.png 1100w, https://miro.medium.com/v2/resize:fit:1400/format:webp/1*KnZHH2TrzWw-XBzTIx9bnw.png 1400w" sizes="(min-resolution: 4dppx) and (max-width: 700px) 50vw, (-webkit-min-device-pixel-ratio: 4) and (max-width: 700px) 50vw, (min-resolution: 3dppx) and (max-width: 700px) 67vw, (-webkit-min-device-pixel-ratio: 3) and (max-width: 700px) 65vw, (min-resolution: 2.5dppx) and (max-width: 700px) 80vw, (-webkit-min-device-pixel-ratio: 2.5) and (max-width: 700px) 80vw, (min-resolution: 2dppx) and (max-width: 700px) 100vw, (-webkit-min-device-pixel-ratio: 2) and (max-width: 700px) 100vw, 700px" type="image/webp"/><source data-testid="og" srcSet="https://miro.medium.com/v2/resize:fit:640/1*KnZHH2TrzWw-XBzTIx9bnw.png 640w, https://miro.medium.com/v2/resize:fit:720/1*KnZHH2TrzWw-XBzTIx9bnw.png 720w, https://miro.medium.com/v2/resize:fit:750/1*KnZHH2TrzWw-XBzTIx9bnw.png 750w, https://miro.medium.com/v2/resize:fit:786/1*KnZHH2TrzWw-XBzTIx9bnw.png 786w, https://miro.medium.com/v2/resize:fit:828/1*KnZHH2TrzWw-XBzTIx9bnw.png 828w, https://miro.medium.com/v2/resize:fit:1100/1*KnZHH2TrzWw-XBzTIx9bnw.png 1100w, https://miro.medium.com/v2/resize:fit:1400/1*KnZHH2TrzWw-XBzTIx9bnw.png 1400w" sizes="(min-resolution: 4dppx) and (max-width: 700px) 50vw, (-webkit-min-device-pixel-ratio: 4) and (max-width: 700px) 50vw, (min-resolution: 3dppx) and (max-width: 700px) 67vw, (-webkit-min-device-pixel-ratio: 3) and (max-width: 700px) 65vw, (min-resolution: 2.5dppx) and (max-width: 700px) 80vw, (-webkit-min-device-pixel-ratio: 2.5) and (max-width: 700px) 80vw, (min-resolution: 2dppx) and (max-width: 700px) 100vw, (-webkit-min-device-pixel-ratio: 2) and (max-width: 700px) 100vw, 700px"/><img alt="" class="bd ln mj c" width="700" height="295" loading="lazy" role="presentation"/></picture></div></div></figure><p id="c743" class="pw-post-body-paragraph mn mo gv mq b mr ms mt mu mv mw mx my mz na nb nc nd ne nf ng nh ni nj nk nl go bg">Under-fit model performance can be seen from forecasting for CV data.</p><ul class=""><li id="84f0" class="mn mo gv mq b mr ms mt mu mv mw mx my mz na nb nc nd ne nf ng nh ni nj nk nl oj ok ol bg"><strong class="mq gw"><em class="mp">DL Modeling : Modeling with CNNs</em></strong></li></ul><p id="b363" class="pw-post-body-paragraph mn mo gv mq b mr ms mt mu mv mw mx my mz na nb nc nd ne nf ng nh ni nj nk nl go bg">Considering time series data as a 1 dimensional block of array, we can apply Convolution filter so as to extract the features to pass it to the dense layer of CNN model.</p><pre class="nq nr ns nt nu os ot ou ov ae ow bg"><span id="8096" class="ox oy gv ot b oz pa pb e pc pd">def complex_cnn_model(shape, print_summary=False):<br/>  model = Sequential()<br/>  model.add(Conv1D(filters=32, kernel_size=2, padding=&#x27;same&#x27;, \<br/>                   activation=&#x27;relu&#x27;, <br/>                   kernel_initializer = &#x27;he_uniform&#x27;,<br/>                   input_shape=(shape, 1)))<br/>  model.add(Conv1D(filters=32, kernel_size=2, padding=&#x27;same&#x27;, \<br/>                   activation=&#x27;relu&#x27;, <br/>                   kernel_initializer = &#x27;he_uniform&#x27;))<br/>  model.add(MaxPooling1D(pool_size=2))<br/>  model.add(Conv1D(filters=32, kernel_size=2, padding=&#x27;same&#x27;, \<br/>                   activation=&#x27;relu&#x27;, <br/>                   kernel_initializer = &#x27;he_uniform&#x27;))<br/>  model.add(Conv1D(filters=32, kernel_size=2, \<br/>                   activation=&#x27;relu&#x27;, <br/>                   kernel_initializer = &#x27;he_uniform&#x27;))<br/>  model.add(MaxPooling1D(pool_size=2))<br/>  model.add(Flatten())<br/>  model.add(Dense(32, activation=&#x27;relu&#x27;))<br/>  model.add(Dense(1))<br/>  model.compile(loss=&#x27;mean_squared_error&#x27;, <br/>                optimizer=&#x27;adam&#x27;, metrics=[tf_smape])<br/>  return model</span></pre><figure class="nq nr ns nt nu md nn no paragraph-image"><div role="button" tabindex="0" class="pf pg ek ph bd pi"><span class="eo ep eq ai er es et eu ev speechify-ignore">Press enter or click to view image in full size</span><div class="nn no qg"><picture><source srcSet="https://miro.medium.com/v2/resize:fit:640/format:webp/1*66IW_jKGq4mQmnlGdKFwJA.png 640w, https://miro.medium.com/v2/resize:fit:720/format:webp/1*66IW_jKGq4mQmnlGdKFwJA.png 720w, https://miro.medium.com/v2/resize:fit:750/format:webp/1*66IW_jKGq4mQmnlGdKFwJA.png 750w, https://miro.medium.com/v2/resize:fit:786/format:webp/1*66IW_jKGq4mQmnlGdKFwJA.png 786w, https://miro.medium.com/v2/resize:fit:828/format:webp/1*66IW_jKGq4mQmnlGdKFwJA.png 828w, https://miro.medium.com/v2/resize:fit:1100/format:webp/1*66IW_jKGq4mQmnlGdKFwJA.png 1100w, https://miro.medium.com/v2/resize:fit:1400/format:webp/1*66IW_jKGq4mQmnlGdKFwJA.png 1400w" sizes="(min-resolution: 4dppx) and (max-width: 700px) 50vw, (-webkit-min-device-pixel-ratio: 4) and (max-width: 700px) 50vw, (min-resolution: 3dppx) and (max-width: 700px) 67vw, (-webkit-min-device-pixel-ratio: 3) and (max-width: 700px) 65vw, (min-resolution: 2.5dppx) and (max-width: 700px) 80vw, (-webkit-min-device-pixel-ratio: 2.5) and (max-width: 700px) 80vw, (min-resolution: 2dppx) and (max-width: 700px) 100vw, (-webkit-min-device-pixel-ratio: 2) and (max-width: 700px) 100vw, 700px" type="image/webp"/><source data-testid="og" srcSet="https://miro.medium.com/v2/resize:fit:640/1*66IW_jKGq4mQmnlGdKFwJA.png 640w, https://miro.medium.com/v2/resize:fit:720/1*66IW_jKGq4mQmnlGdKFwJA.png 720w, https://miro.medium.com/v2/resize:fit:750/1*66IW_jKGq4mQmnlGdKFwJA.png 750w, https://miro.medium.com/v2/resize:fit:786/1*66IW_jKGq4mQmnlGdKFwJA.png 786w, https://miro.medium.com/v2/resize:fit:828/1*66IW_jKGq4mQmnlGdKFwJA.png 828w, https://miro.medium.com/v2/resize:fit:1100/1*66IW_jKGq4mQmnlGdKFwJA.png 1100w, https://miro.medium.com/v2/resize:fit:1400/1*66IW_jKGq4mQmnlGdKFwJA.png 1400w" sizes="(min-resolution: 4dppx) and (max-width: 700px) 50vw, (-webkit-min-device-pixel-ratio: 4) and (max-width: 700px) 50vw, (min-resolution: 3dppx) and (max-width: 700px) 67vw, (-webkit-min-device-pixel-ratio: 3) and (max-width: 700px) 65vw, (min-resolution: 2.5dppx) and (max-width: 700px) 80vw, (-webkit-min-device-pixel-ratio: 2.5) and (max-width: 700px) 80vw, (min-resolution: 2dppx) and (max-width: 700px) 100vw, (-webkit-min-device-pixel-ratio: 2) and (max-width: 700px) 100vw, 700px"/><img alt="" class="bd ln mj c" width="700" height="1294" loading="lazy" role="presentation"/></picture></div></div></figure><figure class="nq nr ns nt nu md nn no paragraph-image"><div role="button" tabindex="0" class="pf pg ek ph bd pi"><span class="eo ep eq ai er es et eu ev speechify-ignore">Press enter or click to view image in full size</span><div class="nn no qh"><picture><source srcSet="https://miro.medium.com/v2/resize:fit:640/format:webp/1*AioQV6rMnuUCovVX6Qls0Q.png 640w, https://miro.medium.com/v2/resize:fit:720/format:webp/1*AioQV6rMnuUCovVX6Qls0Q.png 720w, https://miro.medium.com/v2/resize:fit:750/format:webp/1*AioQV6rMnuUCovVX6Qls0Q.png 750w, https://miro.medium.com/v2/resize:fit:786/format:webp/1*AioQV6rMnuUCovVX6Qls0Q.png 786w, https://miro.medium.com/v2/resize:fit:828/format:webp/1*AioQV6rMnuUCovVX6Qls0Q.png 828w, https://miro.medium.com/v2/resize:fit:1100/format:webp/1*AioQV6rMnuUCovVX6Qls0Q.png 1100w, https://miro.medium.com/v2/resize:fit:1400/format:webp/1*AioQV6rMnuUCovVX6Qls0Q.png 1400w" sizes="(min-resolution: 4dppx) and (max-width: 700px) 50vw, (-webkit-min-device-pixel-ratio: 4) and (max-width: 700px) 50vw, (min-resolution: 3dppx) and (max-width: 700px) 67vw, (-webkit-min-device-pixel-ratio: 3) and (max-width: 700px) 65vw, (min-resolution: 2.5dppx) and (max-width: 700px) 80vw, (-webkit-min-device-pixel-ratio: 2.5) and (max-width: 700px) 80vw, (min-resolution: 2dppx) and (max-width: 700px) 100vw, (-webkit-min-device-pixel-ratio: 2) and (max-width: 700px) 100vw, 700px" type="image/webp"/><source data-testid="og" srcSet="https://miro.medium.com/v2/resize:fit:640/1*AioQV6rMnuUCovVX6Qls0Q.png 640w, https://miro.medium.com/v2/resize:fit:720/1*AioQV6rMnuUCovVX6Qls0Q.png 720w, https://miro.medium.com/v2/resize:fit:750/1*AioQV6rMnuUCovVX6Qls0Q.png 750w, https://miro.medium.com/v2/resize:fit:786/1*AioQV6rMnuUCovVX6Qls0Q.png 786w, https://miro.medium.com/v2/resize:fit:828/1*AioQV6rMnuUCovVX6Qls0Q.png 828w, https://miro.medium.com/v2/resize:fit:1100/1*AioQV6rMnuUCovVX6Qls0Q.png 1100w, https://miro.medium.com/v2/resize:fit:1400/1*AioQV6rMnuUCovVX6Qls0Q.png 1400w" sizes="(min-resolution: 4dppx) and (max-width: 700px) 50vw, (-webkit-min-device-pixel-ratio: 4) and (max-width: 700px) 50vw, (min-resolution: 3dppx) and (max-width: 700px) 67vw, (-webkit-min-device-pixel-ratio: 3) and (max-width: 700px) 65vw, (min-resolution: 2.5dppx) and (max-width: 700px) 80vw, (-webkit-min-device-pixel-ratio: 2.5) and (max-width: 700px) 80vw, (min-resolution: 2dppx) and (max-width: 700px) 100vw, (-webkit-min-device-pixel-ratio: 2) and (max-width: 700px) 100vw, 700px"/><img alt="" class="bd ln mj c" width="700" height="308" loading="lazy" role="presentation"/></picture></div></div></figure><p id="b557" class="pw-post-body-paragraph mn mo gv mq b mr ms mt mu mv mw mx my mz na nb nc nd ne nf ng nh ni nj nk nl go bg">Let us merge the two modeling techniques, which is CNN and LSTM to make a new model which can preserve the previous values and also extract the features with convolution filter.</p><ul class=""><li id="8297" class="mn mo gv mq b mr ms mt mu mv mw mx my mz na nb nc nd ne nf ng nh ni nj nk nl oj ok ol bg"><strong class="mq gw"><em class="mp">DL Modeling : CNN LSTM Model</em></strong></li></ul><pre class="nq nr ns nt nu os ot ou ov ae ow bg"><span id="8f1a" class="ox oy gv ot b oz pa pb e pc pd">def cnn_lstm_model(shape, print_summary=False):<br/>    model = Sequential()<br/>    model.add(Conv1D(filters=128, kernel_size=2, activation=&#x27;tanh&#x27;,<br/>              kernel_initializer = &#x27;he_uniform&#x27;, <br/>              input_shape=(shape, 1)))<br/>    model.add(Conv1D(filters=128, kernel_size=2, activation=&#x27;tanh&#x27;,<br/>              kernel_initializer = &#x27;he_uniform&#x27;))<br/>    model.add(MaxPooling1D(pool_size=3))<br/>    model.add(LSTM(128, activation=&#x27;tanh&#x27;, return_sequences=True))<br/>    model.add(LSTM(128, activation=&#x27;tanh&#x27;))<br/>    model.add(Dense(64, activation=&#x27;relu&#x27;))<br/>    model.add(Dropout(0.5))<br/>    model.add(Dense(8, activation=&#x27;relu&#x27;))<br/>    model.add(Dropout(0.5))<br/>    model.add(Dense(1))<br/>    model.compile(loss=&#x27;mean_squared_error&#x27;, <br/>                  optimizer=&#x27;adam&#x27;, metrics=[tf_smape])<br/>    return model</span><span id="f9a9" class="ox oy gv ot b oz ps pb e pc pd">X = np.log1p(X_timeseries.iloc[:,-best_window-1:-1])<br/>r, c = X.shape<br/>X = np.array(X).reshape((r, c, 1))<br/>Y = np.log1p(X_timeseries.iloc[:,-1])<br/> <br/>#fitting model wth best parameters<br/>model = cnn_lstm_model(best_window, print_summary=True)<br/>model.fit(X, Y, batch_size=batch, epochs=epoch, verbose=1)<br/> <br/>#save the model weights<br/>my_model = model.to_json()<br/>with open(&quot;cnn_lstm_model.json&quot;, &quot;w&quot;) as json_file:<br/>  json_file.write(my_model)<br/>model.save_weights(&quot;cnn_lstm_model_weights.h5&quot;)</span></pre><figure class="nq nr ns nt nu md nn no paragraph-image"><div class="nn no qi"><picture><source srcSet="https://miro.medium.com/v2/resize:fit:640/format:webp/1*_WJYYp4LORJiDw-ngASNcg.png 640w, https://miro.medium.com/v2/resize:fit:720/format:webp/1*_WJYYp4LORJiDw-ngASNcg.png 720w, https://miro.medium.com/v2/resize:fit:750/format:webp/1*_WJYYp4LORJiDw-ngASNcg.png 750w, https://miro.medium.com/v2/resize:fit:786/format:webp/1*_WJYYp4LORJiDw-ngASNcg.png 786w, https://miro.medium.com/v2/resize:fit:828/format:webp/1*_WJYYp4LORJiDw-ngASNcg.png 828w, https://miro.medium.com/v2/resize:fit:1100/format:webp/1*_WJYYp4LORJiDw-ngASNcg.png 1100w, https://miro.medium.com/v2/resize:fit:1316/format:webp/1*_WJYYp4LORJiDw-ngASNcg.png 1316w" sizes="(min-resolution: 4dppx) and (max-width: 700px) 50vw, (-webkit-min-device-pixel-ratio: 4) and (max-width: 700px) 50vw, (min-resolution: 3dppx) and (max-width: 700px) 67vw, (-webkit-min-device-pixel-ratio: 3) and (max-width: 700px) 65vw, (min-resolution: 2.5dppx) and (max-width: 700px) 80vw, (-webkit-min-device-pixel-ratio: 2.5) and (max-width: 700px) 80vw, (min-resolution: 2dppx) and (max-width: 700px) 100vw, (-webkit-min-device-pixel-ratio: 2) and (max-width: 700px) 100vw, 658px" type="image/webp"/><source data-testid="og" srcSet="https://miro.medium.com/v2/resize:fit:640/1*_WJYYp4LORJiDw-ngASNcg.png 640w, https://miro.medium.com/v2/resize:fit:720/1*_WJYYp4LORJiDw-ngASNcg.png 720w, https://miro.medium.com/v2/resize:fit:750/1*_WJYYp4LORJiDw-ngASNcg.png 750w, https://miro.medium.com/v2/resize:fit:786/1*_WJYYp4LORJiDw-ngASNcg.png 786w, https://miro.medium.com/v2/resize:fit:828/1*_WJYYp4LORJiDw-ngASNcg.png 828w, https://miro.medium.com/v2/resize:fit:1100/1*_WJYYp4LORJiDw-ngASNcg.png 1100w, https://miro.medium.com/v2/resize:fit:1316/1*_WJYYp4LORJiDw-ngASNcg.png 1316w" sizes="(min-resolution: 4dppx) and (max-width: 700px) 50vw, (-webkit-min-device-pixel-ratio: 4) and (max-width: 700px) 50vw, (min-resolution: 3dppx) and (max-width: 700px) 67vw, (-webkit-min-device-pixel-ratio: 3) and (max-width: 700px) 65vw, (min-resolution: 2.5dppx) and (max-width: 700px) 80vw, (-webkit-min-device-pixel-ratio: 2.5) and (max-width: 700px) 80vw, (min-resolution: 2dppx) and (max-width: 700px) 100vw, (-webkit-min-device-pixel-ratio: 2) and (max-width: 700px) 100vw, 658px"/><img alt="" class="bd ln mj c" width="658" height="574" loading="lazy" role="presentation"/></picture></div></figure><figure class="nq nr ns nt nu md nn no paragraph-image"><div role="button" tabindex="0" class="pf pg ek ph bd pi"><span class="eo ep eq ai er es et eu ev speechify-ignore">Press enter or click to view image in full size</span><div class="nn no qj"><picture><source srcSet="https://miro.medium.com/v2/resize:fit:640/format:webp/1*7dfd8IxqwaEzVbityFJmgg.png 640w, https://miro.medium.com/v2/resize:fit:720/format:webp/1*7dfd8IxqwaEzVbityFJmgg.png 720w, https://miro.medium.com/v2/resize:fit:750/format:webp/1*7dfd8IxqwaEzVbityFJmgg.png 750w, https://miro.medium.com/v2/resize:fit:786/format:webp/1*7dfd8IxqwaEzVbityFJmgg.png 786w, https://miro.medium.com/v2/resize:fit:828/format:webp/1*7dfd8IxqwaEzVbityFJmgg.png 828w, https://miro.medium.com/v2/resize:fit:1100/format:webp/1*7dfd8IxqwaEzVbityFJmgg.png 1100w, https://miro.medium.com/v2/resize:fit:1400/format:webp/1*7dfd8IxqwaEzVbityFJmgg.png 1400w" sizes="(min-resolution: 4dppx) and (max-width: 700px) 50vw, (-webkit-min-device-pixel-ratio: 4) and (max-width: 700px) 50vw, (min-resolution: 3dppx) and (max-width: 700px) 67vw, (-webkit-min-device-pixel-ratio: 3) and (max-width: 700px) 65vw, (min-resolution: 2.5dppx) and (max-width: 700px) 80vw, (-webkit-min-device-pixel-ratio: 2.5) and (max-width: 700px) 80vw, (min-resolution: 2dppx) and (max-width: 700px) 100vw, (-webkit-min-device-pixel-ratio: 2) and (max-width: 700px) 100vw, 700px" type="image/webp"/><source data-testid="og" srcSet="https://miro.medium.com/v2/resize:fit:640/1*7dfd8IxqwaEzVbityFJmgg.png 640w, https://miro.medium.com/v2/resize:fit:720/1*7dfd8IxqwaEzVbityFJmgg.png 720w, https://miro.medium.com/v2/resize:fit:750/1*7dfd8IxqwaEzVbityFJmgg.png 750w, https://miro.medium.com/v2/resize:fit:786/1*7dfd8IxqwaEzVbityFJmgg.png 786w, https://miro.medium.com/v2/resize:fit:828/1*7dfd8IxqwaEzVbityFJmgg.png 828w, https://miro.medium.com/v2/resize:fit:1100/1*7dfd8IxqwaEzVbityFJmgg.png 1100w, https://miro.medium.com/v2/resize:fit:1400/1*7dfd8IxqwaEzVbityFJmgg.png 1400w" sizes="(min-resolution: 4dppx) and (max-width: 700px) 50vw, (-webkit-min-device-pixel-ratio: 4) and (max-width: 700px) 50vw, (min-resolution: 3dppx) and (max-width: 700px) 67vw, (-webkit-min-device-pixel-ratio: 3) and (max-width: 700px) 65vw, (min-resolution: 2.5dppx) and (max-width: 700px) 80vw, (-webkit-min-device-pixel-ratio: 2.5) and (max-width: 700px) 80vw, (min-resolution: 2dppx) and (max-width: 700px) 100vw, (-webkit-min-device-pixel-ratio: 2) and (max-width: 700px) 100vw, 700px"/><img alt="" class="bd ln mj c" width="700" height="291" loading="lazy" role="presentation"/></picture></div></div></figure><p id="8eb3" class="pw-post-body-paragraph mn mo gv mq b mr ms mt mu mv mw mx my mz na nb nc nd ne nf ng nh ni nj nk nl go bg">Model performance deteriorates as the test time stamps increases.</p><ul class=""><li id="8e7e" class="mn mo gv mq b mr ms mt mu mv mw mx my mz na nb nc nd ne nf ng nh ni nj nk nl oj ok ol bg"><strong class="mq gw"><em class="mp">DL Modeling : Overall Model performances</em></strong></li></ul><p id="abd2" class="pw-post-body-paragraph mn mo gv mq b mr ms mt mu mv mw mx my mz na nb nc nd ne nf ng nh ni nj nk nl go bg">Tabulating overall results of each of the DL models, where each of them was tested on cross validation dataset to find the best parameters so as to run the same on actual test data. Test score from Kaggle for few of the models also included in this.</p><figure class="nq nr ns nt nu md nn no paragraph-image"><div class="nn no qk"><picture><source srcSet="https://miro.medium.com/v2/resize:fit:640/format:webp/1*wJtdiY1wp5uv0u3StRJlZw.png 640w, https://miro.medium.com/v2/resize:fit:720/format:webp/1*wJtdiY1wp5uv0u3StRJlZw.png 720w, https://miro.medium.com/v2/resize:fit:750/format:webp/1*wJtdiY1wp5uv0u3StRJlZw.png 750w, https://miro.medium.com/v2/resize:fit:786/format:webp/1*wJtdiY1wp5uv0u3StRJlZw.png 786w, https://miro.medium.com/v2/resize:fit:828/format:webp/1*wJtdiY1wp5uv0u3StRJlZw.png 828w, https://miro.medium.com/v2/resize:fit:1100/format:webp/1*wJtdiY1wp5uv0u3StRJlZw.png 1100w, https://miro.medium.com/v2/resize:fit:1140/format:webp/1*wJtdiY1wp5uv0u3StRJlZw.png 1140w" sizes="(min-resolution: 4dppx) and (max-width: 700px) 50vw, (-webkit-min-device-pixel-ratio: 4) and (max-width: 700px) 50vw, (min-resolution: 3dppx) and (max-width: 700px) 67vw, (-webkit-min-device-pixel-ratio: 3) and (max-width: 700px) 65vw, (min-resolution: 2.5dppx) and (max-width: 700px) 80vw, (-webkit-min-device-pixel-ratio: 2.5) and (max-width: 700px) 80vw, (min-resolution: 2dppx) and (max-width: 700px) 100vw, (-webkit-min-device-pixel-ratio: 2) and (max-width: 700px) 100vw, 570px" type="image/webp"/><source data-testid="og" srcSet="https://miro.medium.com/v2/resize:fit:640/1*wJtdiY1wp5uv0u3StRJlZw.png 640w, https://miro.medium.com/v2/resize:fit:720/1*wJtdiY1wp5uv0u3StRJlZw.png 720w, https://miro.medium.com/v2/resize:fit:750/1*wJtdiY1wp5uv0u3StRJlZw.png 750w, https://miro.medium.com/v2/resize:fit:786/1*wJtdiY1wp5uv0u3StRJlZw.png 786w, https://miro.medium.com/v2/resize:fit:828/1*wJtdiY1wp5uv0u3StRJlZw.png 828w, https://miro.medium.com/v2/resize:fit:1100/1*wJtdiY1wp5uv0u3StRJlZw.png 1100w, https://miro.medium.com/v2/resize:fit:1140/1*wJtdiY1wp5uv0u3StRJlZw.png 1140w" sizes="(min-resolution: 4dppx) and (max-width: 700px) 50vw, (-webkit-min-device-pixel-ratio: 4) and (max-width: 700px) 50vw, (min-resolution: 3dppx) and (max-width: 700px) 67vw, (-webkit-min-device-pixel-ratio: 3) and (max-width: 700px) 65vw, (min-resolution: 2.5dppx) and (max-width: 700px) 80vw, (-webkit-min-device-pixel-ratio: 2.5) and (max-width: 700px) 80vw, (min-resolution: 2dppx) and (max-width: 700px) 100vw, (-webkit-min-device-pixel-ratio: 2) and (max-width: 700px) 100vw, 570px"/><img alt="" class="bd ln mj c" width="570" height="176" loading="lazy" role="presentation"/></picture></div></figure></div></div></div><div class="v cf oa ob oc od" role="separator"><span class="oe bu bi of og oh"></span><span class="oe bu bi of og oh"></span><span class="oe bu bi of og"></span></div><div class="go gp gq gr gs"><div class="v cf"><div class="cm bd ga gb gc gd"><blockquote class="mk ml mm"><p id="4a39" class="mn mo mp mq b mr ms mt mu mv mw mx my mz na nb nc nd ne nf ng nh ni nj nk nl go bg"><strong class="mq gw">Conclusion and Areas of Improvement :</strong></p></blockquote><p id="0bce" class="pw-post-body-paragraph mn mo gv mq b mr ms mt mu mv mw mx my mz na nb nc nd ne nf ng nh ni nj nk nl go bg">Concluding the complete analysis done on this problem, we can say that, both ML and DL modeling with basic feature engineering give us considerably better results. Adding features extracted from Page Name, can certainly gave a good boost to ML modeling.</p><p id="af6b" class="pw-post-body-paragraph mn mo gv mq b mr ms mt mu mv mw mx my mz na nb nc nd ne nf ng nh ni nj nk nl go bg">All above models, can be improved with intensive hyper-parameter search keeping in mind the impact of Over-fitting and Under-fitting. For DL Models, we can also do hyper-parameter search for each of the layer parameters. Also, regularization techniques can be implemented so as to to keep the weights optimal for better performance of the model.</p><p id="cf42" class="pw-post-body-paragraph mn mo gv mq b mr ms mt mu mv mw mx my mz na nb nc nd ne nf ng nh ni nj nk nl go bg">For further improvement, we can also add new features like, day of the week, seasonal holidays etc.</p><blockquote class="mk ml mm"><p id="fdaa" class="mn mo mp mq b mr ms mt mu mv mw mx my mz na nb nc nd ne nf ng nh ni nj nk nl go bg"><strong class="mq gw"><em class="gv">References :</em></strong></p></blockquote><div class="ql qm qn qo qp qq"><a href="https://www.kaggle.com/c/web-traffic-time-series-forecasting/overview?source=post_page-----6c916c7f5d85---------------------------------------" rel="noopener  ugc nofollow" target="_blank"><div class="qr v bx"><div class="qs v cs cf ca qt"><h2 class="bb gw oz u es qu qv qw qx qy qz gu bg">Web Traffic Time Series Forecasting</h2><div class="ra e"><h3 class="bb b oz u es qu qv qw qx qy qz eb">Forecast future traffic to Wikipedia pages</h3></div><div class="rb e"><p class="bb b ec u es qu qv qw qx qy qz eb">www.kaggle.com</p></div></div><div class="rc e"><div class="rd e re rf rg rc rh ln qq"></div></div></div></a></div></div></div></div></div></section></div></div></article></div><div class="v cf"><div class="cm bd ga gb gc gd"><div class="ri rj v is"><div class="ra v"><a class="rk ae ai ak" href="https://medium.com/tag/machine-learning?source=post_page-----6c916c7f5d85---------------------------------------" rel="noopener follow"><div class="rl ek db rm gf rn ro bb b bc u bg eu">Machine Learning</div></a></div><div class="ra v"><a class="rk ae ai ak" href="https://medium.com/tag/time-series-forecasting?source=post_page-----6c916c7f5d85---------------------------------------" rel="noopener follow"><div class="rl ek db rm gf rn ro bb b bc u bg eu">Time Series Forecasting</div></a></div><div class="ra v"><a class="rk ae ai ak" href="https://medium.com/tag/kaggle-competition?source=post_page-----6c916c7f5d85---------------------------------------" rel="noopener follow"><div class="rl ek db rm gf rn ro bb b bc u bg eu">Kaggle Competition</div></a></div><div class="ra v"><a class="rk ae ai ak" href="https://medium.com/tag/python3?source=post_page-----6c916c7f5d85---------------------------------------" rel="noopener follow"><div class="rl ek db rm gf rn ro bb b bc u bg eu">Python3</div></a></div><div class="ra v"><a class="rk ae ai ak" href="https://medium.com/tag/deep-learning?source=post_page-----6c916c7f5d85---------------------------------------" rel="noopener follow"><div class="rl ek db rm gf rn ro bb b bc u bg eu">Deep Learning</div></a></div></div></div></div><div class="e"></div><footer class="rp rq rr rs rt v j ru rv c"><div class="e y"><div class="v cf"><div class="cm bd ga gb gc gd"><div class="v ct rw"><div class="v j kb"><div class="rx e"><span class="e ry rz sa sb s"><div class="v j kb kc"><div class="pw-multi-vote-icon ek kd ke kf kg"><div class=""><div class="kh ki kj kk kl km kn ai ko kp kq kg" role="presentation"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" aria-label="clap"><path fill-rule="evenodd" d="M11.37.828 12 3.282l.63-2.454zM15.421 1.84l-1.185-.388-.338 2.5zM9.757 1.452l-1.184.389 1.523 2.112zM20.253 11.84 17.75 7.438c-.238-.353-.57-.584-.93-.643a.96.96 0 0 0-.753.183 1.13 1.13 0 0 0-.443.695c.014.019.03.033.044.053l2.352 4.138c1.