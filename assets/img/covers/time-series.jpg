s platform","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:409a9719c105_28":{"__typename":"Paragraph","id":"409a9719c105_28","name":"e546","type":"ULI","href":null,"layout":null,"metadata":null,"text":"Mobile-web platform","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:409a9719c105_29":{"__typename":"Paragraph","id":"409a9719c105_29","name":"59cc","type":"ULI","href":null,"layout":null,"metadata":null,"text":"Desktop platform","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:409a9719c105_30":{"__typename":"Paragraph","id":"409a9719c105_30","name":"56b1","type":"P","href":null,"layout":null,"metadata":null,"text":"From above Bar plots, we can see that the traffic is more for pages with all-access as access category. The remaining two categories shows comparatively less traffic. Also, Mobile-web traffic is slightly more compared to that of Desktop based traffic.","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:409a9719c105_31":{"__typename":"Paragraph","id":"409a9719c105_31","name":"e239","type":"P","href":null,"layout":null,"metadata":null,"text":"Web Traffic : Agent Feature","hasDropCap":null,"dropCapImage":null,"markups":[{"__typename":"Markup","type":"STRONG","start":0,"end":27,"href":null,"anchorType":null,"userId":null,"linkMetadata":null},{"__typename":"Markup","type":"EM","start":0,"end":27,"href":null,"anchorType":null,"userId":null,"linkMetadata":null}],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:409a9719c105_32":{"__typename":"Paragraph","id":"409a9719c105_32","name":"7cd2","type":"PRE","href":null,"layout":null,"metadata":null,"text":"data_counts = pageData['Agent'].value_counts()","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"ImageMetadata:1*LUUdPyDYaM0-cvrGR3BFGQ.png":{"__typename":"ImageMetadata","id":"1*LUUdPyDYaM0-cvrGR3BFGQ.png","originalHeight":366,"originalWidth":969,"focusPercentX":null,"focusPercentY":null,"alt":null},"Paragraph:409a9719c105_33":{"__typename":"Paragraph","id":"409a9719c105_33","name":"9482","type":"IMG","href":null,"layout":"INSET_CENTER","metadata":{"__ref":"ImageMetadata:1*LUUdPyDYaM0-cvrGR3BFGQ.png"},"text":"","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:409a9719c105_34":{"__typename":"Paragraph","id":"409a9719c105_34","name":"3794","type":"P","href":null,"layout":null,"metadata":null,"text":"For all pages, we are having two agents through which the pages are being accessed. All-agents being the agent through which most of the traffic was observed from compared to Spider agent.","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:409a9719c105_35":{"__typename":"Paragraph","id":"409a9719c105_35","name":"b576","type":"P","href":null,"layout":null,"metadata":null,"text":"Time Series : Mean Page Views","hasDropCap":null,"dropCapImage":null,"markups":[{"__typename":"Markup","type":"STRONG","start":0,"end":29,"href":null,"anchorType":null,"userId":null,"linkMetadata":null},{"__typename":"Markup","type":"EM","start":0,"end":29,"href":null,"anchorType":null,"userId":null,"linkMetadata":null}],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:409a9719c105_36":{"__typename":"Paragraph","id":"409a9719c105_36","name":"51b9","type":"PRE","href":null,"layout":null,"metadata":null,"text":"mean = timeseries.mean(axis=0)","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"ImageMetadata:1*kRFxQDhLsGSj7ZOvSp4pXQ.png":{"__typename":"ImageMetadata","id":"1*kRFxQDhLsGSj7ZOvSp4pXQ.png","originalHeight":467,"originalWidth":993,"focusPercentX":null,"focusPercentY":null,"alt":null},"Paragraph:409a9719c105_37":{"__typename":"Paragraph","id":"409a9719c105_37","name":"339d","type":"IMG","href":null,"layout":"INSET_CENTER","metadata":{"__ref":"ImageMetadata:1*kRFxQDhLsGSj7ZOvSp4pXQ.png"},"text":"","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:409a9719c105_38":{"__typename":"Paragraph","id":"409a9719c105_38","name":"05de","type":"P","href":null,"layout":null,"metadata":null,"text":"From this timely distribution of the data, we can see that the data is not stationary over time and also there is no combining effect was observed in the data i.e. strict increase in the page views over the increase in time. There can be sharp spikes seen for the page views for certain days, considering them to be holidays, weekends. Let us understand if the time series nature of data has some correlation with it’s own lag value.","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:409a9719c105_39":{"__typename":"Paragraph","id":"409a9719c105_39","name":"a2cd","type":"P","href":null,"layout":null,"metadata":null,"text":"Time Series : Correlation with Lagged values with ACF and PACF","hasDropCap":null,"dropCapImage":null,"markups":[{"__typename":"Markup","type":"STRONG","start":0,"end":62,"href":null,"anchorType":null,"userId":null,"linkMetadata":null},{"__typename":"Markup","type":"EM","start":0,"end":62,"href":null,"anchorType":null,"userId":null,"linkMetadata":null}],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:409a9719c105_40":{"__typename":"Paragraph","id":"409a9719c105_40","name":"6427","type":"ULI","href":null,"layout":null,"metadata":null,"text":"Auto-Correlation Plot (ACF)","hasDropCap":null,"dropCapImage":null,"markups":[{"__typename":"Markup","type":"STRONG","start":0,"end":27,"href":null,"anchorType":null,"userId":null,"linkMetadata":null},{"__typename":"Markup","type":"EM","start":0,"end":27,"href":null,"anchorType":null,"userId":null,"linkMetadata":null}],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:409a9719c105_41":{"__typename":"Paragraph","id":"409a9719c105_41","name":"9cd2","type":"PRE","href":null,"layout":null,"metadata":null,"text":"mean = timeseries.mean(axis=0)\nacf_plot = acf((mean.values), nlags=len(mean))","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"ImageMetadata:1*Be-76gMFm3c_wODmrg7b4g.png":{"__typename":"ImageMetadata","id":"1*Be-76gMFm3c_wODmrg7b4g.png","originalHeight":423,"originalWidth":858,"focusPercentX":null,"focusPercentY":null,"alt":null},"Paragraph:409a9719c105_42":{"__typename":"Paragraph","id":"409a9719c105_42","name":"df86","type":"IMG","href":null,"layout":"INSET_CENTER","metadata":{"__ref":"ImageMetadata:1*Be-76gMFm3c_wODmrg7b4g.png"},"text":"","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:409a9719c105_43":{"__typename":"Paragraph","id":"409a9719c105_43","name":"1484","type":"P","href":null,"layout":null,"metadata":null,"text":"Figure shows, ACF (Auto Correlation) for the complete time series. We can clearly see that the page views are strongly correlated with their previous values.","hasDropCap":null,"dropCapImage":null,"markups":[{"__typename":"Markup","type":"A","start":14,"end":36,"href":"https:\u002F\u002Fen.wikipedia.org\u002Fwiki\u002FAutocorrelation#:~:text=Autocorrelation%2C%20also%20known%20as%20serial,the%20time%20lag%20between%20them.","anchorType":"LINK","userId":null,"linkMetadata":null},{"__typename":"Markup","type":"EM","start":14,"end":36,"href":null,"anchorType":null,"userId":null,"linkMetadata":null}],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:409a9719c105_44":{"__typename":"Paragraph","id":"409a9719c105_44","name":"cdd7","type":"P","href":null,"layout":null,"metadata":null,"text":"Plotting ACF plot with different lags, to understand the correlation in depth.","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"ImageMetadata:1*hszIaezTj3XxgvdwI5EK7A.png":{"__typename":"ImageMetadata","id":"1*hszIaezTj3XxgvdwI5EK7A.png","originalHeight":575,"originalWidth":887,"focusPercentX":null,"focusPercentY":null,"alt":null},"Paragraph:409a9719c105_45":{"__typename":"Paragraph","id":"409a9719c105_45","name":"b5c5","type":"IMG","href":null,"layout":"INSET_CENTER","metadata":{"__ref":"ImageMetadata:1*hszIaezTj3XxgvdwI5EK7A.png"},"text":"","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:409a9719c105_46":{"__typename":"Paragraph","id":"409a9719c105_46","name":"9abb","type":"P","href":null,"layout":null,"metadata":null,"text":"With four different plots of correlation of Mean page views with its lagged values, we can see that the correlation is high in Weekly, Monthly and Quarterly lags.","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:409a9719c105_47":{"__typename":"Paragraph","id":"409a9719c105_47","name":"22b7","type":"P","href":null,"layout":null,"metadata":null,"text":"We can see that the high correlation among the mean pageview drops below threshold value of 90% interval in case of Yearly correlation plot, which continues to increase in negative scale for certain period.","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:409a9719c105_48":{"__typename":"Paragraph","id":"409a9719c105_48","name":"8a02","type":"P","href":null,"layout":null,"metadata":null,"text":"From above Quarterly and Yearly ACF plot, we can say that the data is highly correlated with the lagged values of the same signals for each page views. Let us see how the page views are related with the residual values of actual page views.","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:409a9719c105_49":{"__typename":"Paragraph","id":"409a9719c105_49","name":"7cd0","type":"ULI","href":null,"layout":null,"metadata":null,"text":"Partial Auto-Correlation Plot (PACF)","hasDropCap":null,"dropCapImage":null,"markups":[{"__typename":"Markup","type":"STRONG","start":0,"end":36,"href":null,"anchorType":null,"userId":null,"linkMetadata":null},{"__typename":"Markup","type":"EM","start":0,"end":36,"href":null,"anchorType":null,"userId":null,"linkMetadata":null}],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:409a9719c105_50":{"__typename":"Paragraph","id":"409a9719c105_50","name":"14b1","type":"PRE","href":null,"layout":null,"metadata":null,"text":"mean = timeseries.mean(axis=0)\nacf_plot = pacf((mean.values), nlags=len(mean))","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"ImageMetadata:1*cvrATtYmbl-Zx15m-Livdg.png":{"__typename":"ImageMetadata","id":"1*cvrATtYmbl-Zx15m-Livdg.png","originalHeight":506,"originalWidth":1042,"focusPercentX":null,"focusPercentY":null,"alt":null},"Paragraph:409a9719c105_51":{"__typename":"Paragraph","id":"409a9719c105_51","name":"5361","type":"IMG","href":null,"layout":"INSET_CENTER","metadata":{"__ref":"ImageMetadata:1*cvrATtYmbl-Zx15m-Livdg.png"},"text":"","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:409a9719c105_52":{"__typename":"Paragraph","id":"409a9719c105_52","name":"bd6c","type":"P","href":null,"layout":null,"metadata":null,"text":"Partial ACF on the complete timestamps as seen from above figure shows there is a strong correlation of partial residuals of the lagged values in the Yearly manner. The correlation is not periodic as the peaks do not occur in timely fashion.","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:409a9719c105_53":{"__typename":"Paragraph","id":"409a9719c105_53","name":"9db5","type":"P","href":null,"layout":null,"metadata":null,"text":"Understanding the PACF with Weekly, Monthly, Quarterly and Yearly lagged values.","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"ImageMetadata:1*XDSEJ0uRtK7jUuDswOl8Ew.png":{"__typename":"ImageMetadata","id":"1*XDSEJ0uRtK7jUuDswOl8Ew.png","originalHeight":574,"originalWidth":880,"focusPercentX":null,"focusPercentY":null,"alt":null},"Paragraph:409a9719c105_54":{"__typename":"Paragraph","id":"409a9719c105_54","name":"a541","type":"IMG","href":null,"layout":"INSET_CENTER","metadata":{"__ref":"ImageMetadata:1*XDSEJ0uRtK7jUuDswOl8Ew.png"},"text":"","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:409a9719c105_55":{"__typename":"Paragraph","id":"409a9719c105_55","name":"993c","type":"P","href":null,"layout":null,"metadata":null,"text":"With Weekly, Monthly, Quarterly and Yearly correlation for Mean PageViews of the data, no significant correlaiton was observed for shorted lag values, i.e. for Weekly, Monthly and Quarterly PACF.","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:409a9719c105_56":{"__typename":"Paragraph","id":"409a9719c105_56","name":"5f2a","type":"P","href":null,"layout":null,"metadata":null,"text":"Sharp spike of significant PACF can be observed after 2016–04–07, i.e. after 270 days. With this we can assume that a lag of year can become significant in determining the forecasting.","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:409a9719c105_57":{"__typename":"Paragraph","id":"409a9719c105_57","name":"1c25","type":"P","href":null,"layout":null,"metadata":null,"text":"Time Series : Trend and Seasonality","hasDropCap":null,"dropCapImage":null,"markups":[{"__typename":"Markup","type":"STRONG","start":0,"end":35,"href":null,"anchorType":null,"userId":null,"linkMetadata":null},{"__typename":"Markup","type":"EM","start":0,"end":35,"href":null,"anchorType":null,"userId":null,"linkMetadata":null}],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:409a9719c105_58":{"__typename":"Paragraph","id":"409a9719c105_58","name":"c40f","type":"PRE","href":null,"layout":null,"metadata":null,"text":"result = seasonal_decompose(mean, model='multiplicative', freq=365)\ntrend_comp    = result.trend\nseasonal_comp = result.seasonal\nresidual_comp = result.resid\nobserved_val  = result.observed","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"ImageMetadata:1*1jSfokZPeTA80zuS9GuHQQ.png":{"__typename":"ImageMetadata","id":"1*1jSfokZPeTA80zuS9GuHQQ.png","originalHeight":498,"originalWidth":888,"focusPercentX":null,"focusPercentY":null,"alt":null},"Paragraph:409a9719c105_59":{"__typename":"Paragraph","id":"409a9719c105_59","name":"f192","type":"IMG","href":null,"layout":"INSET_CENTER","metadata":{"__ref":"ImageMetadata:1*1jSfokZPeTA80zuS9GuHQQ.png"},"text":"","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:409a9719c105_60":{"__typename":"Paragraph","id":"409a9719c105_60","name":"75a2","type":"P","href":null,"layout":null,"metadata":null,"text":"From the plot of PACF, we could see negative spike in the data, which can be observed from trend waveform.","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:409a9719c105_61":{"__typename":"Paragraph","id":"409a9719c105_61","name":"1bb1","type":"P","href":null,"layout":null,"metadata":null,"text":"With seasonality decomposition of the mean time series for all pages, we can see","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:409a9719c105_62":{"__typename":"Paragraph","id":"409a9719c105_62","name":"a949","type":"ULI","href":null,"layout":null,"metadata":null,"text":"Trend is decreasing after a certain increase in the initial period.","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:409a9719c105_63":{"__typename":"Paragraph","id":"409a9719c105_63","name":"dd58","type":"ULI","href":null,"layout":null,"metadata":null,"text":"yearly cycle is observed in the data","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:409a9719c105_64":{"__typename":"Paragraph","id":"409a9719c105_64","name":"2670","type":"P","href":null,"layout":null,"metadata":null,"text":"With this understanding of the time series, we can prepare the data for modeling.","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:409a9719c105_65":{"__typename":"Paragraph","id":"409a9719c105_65","name":"e214","type":"BQ","href":null,"layout":null,"metadata":null,"text":"Data Preparation :","hasDropCap":null,"dropCapImage":null,"markups":[{"__typename":"Markup","type":"STRONG","start":0,"end":18,"href":null,"anchorType":null,"userId":null,"linkMetadata":null},{"__typename":"Markup","type":"EM","start":0,"end":18,"href":null,"anchorType":null,"userId":null,"linkMetadata":null}],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:409a9719c105_66":{"__typename":"Paragraph","id":"409a9719c105_66","name":"ca45","type":"P","href":null,"layout":null,"metadata":null,"text":"With total of 803 time stamps for page views of each pages, from Jul 27, 2015 till Sept 10, 2017, we can divide the initial 2 years data as Train data (from July 1, 2015 upto July 1, 2017) and remaining data can be used as Cross Validation data, i.e. for validating the parameters so as to perform well on future unseen points.","hasDropCap":null,"dropCapImage":null,"markups":[{"__typename":"Markup","type":"EM","start":151,"end":188,"href":null,"anchorType":null,"userId":null,"linkMetadata":null}],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:409a9719c105_67":{"__typename":"Paragraph","id":"409a9719c105_67","name":"88ce","type":"PRE","href":null,"layout":null,"metadata":null,"text":"#getting the index of date\ndate_cols  = timeseries.columns.tolist()\ntrain_end  = date_cols.index('2017-07-01')-1","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:409a9719c105_68":{"__typename":"Paragraph","id":"409a9719c105_68","name":"9dae","type":"PRE","href":null,"layout":null,"metadata":null,"text":"#splitting the main data as train and cv\ntrain_data = timeseries.iloc[:,:]\ncv_data    = timeseries.iloc[:,train_end:]","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:409a9719c105_69":{"__typename":"Paragraph","id":"409a9719c105_69","name":"240b","type":"P","href":null,"layout":null,"metadata":null,"text":"Later, we will One Hot Encode, each of the features derived from Page Name, which can be suitable for modeling.","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:409a9719c105_70":{"__typename":"Paragraph","id":"409a9719c105_70","name":"70f7","type":"PRE","href":null,"layout":null,"metadata":null,"text":"label = LabelEncoder()","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:409a9719c105_71":{"__typename":"Paragraph","id":"409a9719c105_71","name":"c724","type":"PRE","href":null,"layout":null,"metadata":null,"text":"train_data['Site_OHE']=label.fit_transform(train_data['Site_Name']).tolist()\ntrain_data['Lang_OHE']=label.fit_transform(train_data['Language']).tolist()\ntrain_data['Access_OHE']=label.fit_transform(train_data['Access']).tolist()\ntrain_data['Agent_OHE']=label.fit_transform(train_data['Agent']).tolist()","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:409a9719c105_72":{"__typename":"Paragraph","id":"409a9719c105_72","name":"fc39","type":"PRE","href":null,"layout":null,"metadata":null,"text":"#changing the last columns as Observed \ntrain_data=train_data.rename(columns={timeseries.iloc[:,:train_end].columns[-1]:'Observed'})","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:409a9719c105_73":{"__typename":"Paragraph","id":"409a9719c105_73","name":"14e5","type":"P","href":null,"layout":null,"metadata":null,"text":"With LabelEncoder, we encoded each Page Name features into numerical format. This features can be used with rest of the time stamps as combined features so as to train the model. We can make the same modifications on Test data too.","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:409a9719c105_74":{"__typename":"Paragraph","id":"409a9719c105_74","name":"5eac","type":"P","href":null,"layout":null,"metadata":null,"text":"Now that our data is ready, we can proceed with the modeling.","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:409a9719c105_75":{"__typename":"Paragraph","id":"409a9719c105_75","name":"5a37","type":"BQ","href":null,"layout":null,"metadata":null,"text":"Metric for Model Evaluation","hasDropCap":null,"dropCapImage":null,"markups":[{"__typename":"Markup","type":"STRONG","start":0,"end":27,"href":null,"anchorType":null,"userId":null,"linkMetadata":null},{"__typename":"Markup","type":"EM","start":0,"end":27,"href":null,"anchorType":null,"userId":null,"linkMetadata":null}],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:409a9719c105_76":{"__typename":"Paragraph","id":"409a9719c105_76","name":"38c6","type":"P","href":null,"layout":null,"metadata":null,"text":"Before we could talk about modeling, first let’s have a look at the metric which can be used to evaluate the performance of the ML\u002FDL models. For this problem, we will be using Metric provided by Kaggle and that is SMAPE (Symmetric Mean Absolute Percentage Error) which is formulated as,","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"ImageMetadata:1*lF4bGmuzhuS9M3zV-aFlAQ.png":{"__typename":"ImageMetadata","id":"1*lF4bGmuzhuS9M3zV-aFlAQ.png","originalHeight":77,"originalWidth":281,"focusPercentX":null,"focusPercentY":null,"alt":null},"Paragraph:409a9719c105_77":{"__typename":"Paragraph","id":"409a9719c105_77","name":"d3ca","type":"IMG","href":null,"layout":"INSET_CENTER","metadata":{"__ref":"ImageMetadata:1*lF4bGmuzhuS9M3zV-aFlAQ.png"},"text":"SMAPE formulation","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:409a9719c105_78":{"__typename":"Paragraph","id":"409a9719c105_78","name":"33de","type":"P","href":null,"layout":null,"metadata":null,"text":"Defining function for returning the SMAPE for forecast values,","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:409a9719c105_79":{"__typename":"Paragraph","id":"409a9719c105_79","name":"02ad","type":"PRE","href":null,"layout":null,"metadata":null,"text":"#metric for evaluation which accepts Y_True and Y_Pred\ndef smape(ytr, ypr):\n    numerator   = np.abs(ypr - ytr)\n    #print(numerator)\n    denominator = (np.abs(ytr) + np.abs(ypr))\n    #print(denominator)\n    return (200\u002Flen(ytr) * np.sum( numerator \u002F denominator ))","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:409a9719c105_80":{"__typename":"Paragraph","id":"409a9719c105_80","name":"e6a6","type":"BQ","href":null,"layout":null,"metadata":null,"text":"Modeling : ML Modeling","hasDropCap":null,"dropCapImage":null,"markups":[{"__typename":"Markup","type":"STRONG","start":0,"end":22,"href":null,"anchorType":null,"userId":null,"linkMetadata":null},{"__typename":"Markup","type":"EM","start":0,"end":22,"href":null,"anchorType":null,"userId":null,"linkMetadata":null}],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:409a9719c105_81":{"__typename":"Paragraph","id":"409a9719c105_81","name":"ca21","type":"P","href":null,"layout":null,"metadata":null,"text":"With the prepared data, where we already extracted Page features, we will perform both Machine Learning(ML) Modeling and Deep Learning(DL) Modeling as well.","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:409a9719c105_82":{"__typename":"Paragraph","id":"409a9719c105_82","name":"2444","type":"P","href":null,"layout":null,"metadata":null,"text":"Before proceeding to our modeling, we will perform Train and Cross Validation analysis few of the previous values. This is because the time series is more likely will depend on its previous values and hence, we can select few of the lagged observations to fit the model which can forecast the values for future time stamps.","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:409a9719c105_83":{"__typename":"Paragraph","id":"409a9719c105_83","name":"375f","type":"PRE","href":null,"layout":null,"metadata":null,"text":"lagged_window = [ 7, 30, 90, 365 ]","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:409a9719c105_84":{"__typename":"Paragraph","id":"409a9719c105_84","name":"cdc6","type":"P","href":null,"layout":null,"metadata":null,"text":"Since, page views are real number, and can have any non-zero value, hence, using these values directly in our modeling can create stability issue in modeling. Hence, we will standardize the values by taking log of the original values. Also, in this case, we cannot use natural log as page views can be 0, which can create problem when we will calculate SMAPE, and hence, we will be using log(1+x) for this problem.","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:409a9719c105_85":{"__typename":"Paragraph","id":"409a9719c105_85","name":"b800","type":"P","href":null,"layout":null,"metadata":null,"text":"ML Modeling : Window Mean","hasDropCap":null,"dropCapImage":null,"markups":[{"__typename":"Markup","type":"STRONG","start":0,"end":25,"href":null,"anchorType":null,"userId":null,"linkMetadata":null},{"__typename":"Markup","type":"EM","start":0,"end":25,"href":null,"anchorType":null,"userId":null,"linkMetadata":null}],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:409a9719c105_86":{"__typename":"Paragraph","id":"409a9719c105_86","name":"09db","type":"P","href":null,"layout":null,"metadata":null,"text":"In this modeling, we consider mean of previous values for forecasting. The best lag window can be found out with the performance of model in CV data where we try to predict the page views for each day and later calculate SMAPE for the forecast values.","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:409a9719c105_87":{"__typename":"Paragraph","id":"409a9719c105_87","name":"d173","type":"PRE","href":null,"layout":null,"metadata":null,"text":"X = np.log1p(timeseries_X.iloc[:,-lag:])\nmean_X = X.mean(axis=1)\n#calculating SMAPE and MAPE\ntrain_smape = smoothed_smape(Y, mean_X)\ntrain_mape = mape(Y, mean_X)","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"ImageMetadata:1*HGuChaxB7xUJQZ7hRTxPiw.png":{"__typename":"ImageMetadata","id":"1*HGuChaxB7xUJQZ7hRTxPiw.png","originalHeight":67,"originalWidth":254,"focusPercentX":null,"focusPercentY":null,"alt":null},"Paragraph:409a9719c105_88":{"__typename":"Paragraph","id":"409a9719c105_88","name":"20a8","type":"IMG","href":null,"layout":"INSET_CENTER","metadata":{"__ref":"ImageMetadata:1*HGuChaxB7xUJQZ7hRTxPiw.png"},"text":"","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"ImageMetadata:1*P2UG2fehKYHHu-xy_SS-2A.png":{"__typename":"ImageMetadata","id":"1*P2UG2fehKYHHu-xy_SS-2A.png","originalHeight":374,"originalWidth":914,"focusPercentX":null,"focusPercentY":null,"alt":null},"Paragraph:409a9719c105_89":{"__typename":"Paragraph","id":"409a9719c105_89","name":"1044","type":"IMG","href":null,"layout":"INSET_CENTER","metadata":{"__ref":"ImageMetadata:1*P2UG2fehKYHHu-xy_SS-2A.png"},"text":"","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:409a9719c105_90":{"__typename":"Paragraph","id":"409a9719c105_90","name":"585c","type":"P","href":null,"layout":null,"metadata":null,"text":"Above plot is the mean page views of all page for Cross Validation dataset. We can see the model is under-fit to the given data. Kaggle scorer for this model on test data is found to be 44.92666.","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:409a9719c105_91":{"__typename":"Paragraph","id":"409a9719c105_91","name":"df1e","type":"P","href":null,"layout":null,"metadata":null,"text":"ML Modeling : Linear Regression","hasDropCap":null,"dropCapImage":null,"markups":[{"__typename":"Markup","type":"STRONG","start":0,"end":31,"href":null,"anchorType":null,"userId":null,"linkMetadata":null},{"__typename":"Markup","type":"EM","start":0,"end":31,"href":null,"anchorType":null,"userId":null,"linkMetadata":null}],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:409a9719c105_92":{"__typename":"Paragraph","id":"409a9719c105_92","name":"e3ca","type":"P","href":null,"layout":null,"metadata":null,"text":"Available time series data can be fit to Linear Regressor model, with loss function of Squared Loss and Huber loss. We will fit the model on different lagged windows, so as to find on how many previous time stamps the target page views are dependent.","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:409a9719c105_93":{"__typename":"Paragraph","id":"409a9719c105_93","name":"4762","type":"P","href":null,"layout":null,"metadata":null,"text":"To the lagged windows of the available time series, we will also add extra features that we extracted from Page Name of the given articles.","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:409a9719c105_94":{"__typename":"Paragraph","id":"409a9719c105_94","name":"f11c","type":"P","href":null,"layout":null,"metadata":null,"text":"Therefore, we will be training the model on mentioned losses with data containing Lagged values as well as Page Features.","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:409a9719c105_95":{"__typename":"Paragraph","id":"409a9719c105_95","name":"f50d","type":"ULI","href":null,"layout":null,"metadata":null,"text":"Linear Regression with Squared Loss","hasDropCap":null,"dropCapImage":null,"markups":[{"__typename":"Markup","type":"STRONG","start":0,"end":35,"href":null,"anchorType":null,"userId":null,"linkMetadata":null},{"__typename":"Markup","type":"EM","start":0,"end":35,"href":null,"anchorType":null,"userId":null,"linkMetadata":null}],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:409a9719c105_96":{"__typename":"Paragraph","id":"409a9719c105_96","name":"0f25","type":"PRE","href":null,"layout":null,"metadata":null,"text":"X = np.log1p(history.iloc[:, -best_window:])\n#adding page features to the lagged values\nX = np.hstack((X_pagename, X))\nlog_reg = SGDRegressor(alpha=best_alpha, loss='squared_loss', \\\n          penalty='l2', fit_intercept=True, random_state=45)\nlog_reg.fit(X, Y)","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:409a9719c105_97":{"__typename":"Paragraph","id":"409a9719c105_97","name":"38dd","type":"PRE","href":null,"layout":null,"metadata":null,"text":"#saving the best fit mode\njoblib.dump(log_reg, '.\u002FML_MODEL-linear_regression_squareloss.sav')","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"ImageMetadata:1*rrb-2U8I2TUBIm6LGfSaGQ.png":{"__typename":"ImageMetadata","id":"1*rrb-2U8I2TUBIm6LGfSaGQ.png","originalHeight":386,"originalWidth":914,"focusPercentX":null,"focusPercentY":null,"alt":null},"Paragraph:409a9719c105_98":{"__typename":"Paragraph","id":"409a9719c105_98","name":"7429","type":"IMG","href":null,"layout":"INSET_CENTER","metadata":{"__ref":"ImageMetadata:1*rrb-2U8I2TUBIm6LGfSaGQ.png"},"text":"","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:409a9719c105_99":{"__typename":"Paragraph","id":"409a9719c105_99","name":"17db","type":"ULI","href":null,"layout":null,"metadata":null,"text":"Linear Regression with Huber Loss","hasDropCap":null,"dropCapImage":null,"markups":[{"__typename":"Markup","type":"STRONG","start":0,"end":33,"href":null,"anchorType":null,"userId":null,"linkMetadata":null},{"__typename":"Markup","type":"EM","start":0,"end":33,"href":null,"anchorType":null,"userId":null,"linkMetadata":null}],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:409a9719c105_100":{"__typename":"Paragraph","id":"409a9719c105_100","name":"7015","type":"PRE","href":null,"layout":null,"metadata":null,"text":"X = np.log1p(history.iloc[:, -best_window:])\n#adding page features to the lagged values\nX = np.hstack((X_pagename, X))\nlog_reg = SGDRegressor(alpha=best_alpha, loss='huber', \\\n                     penalty='l2', fit_intercept=True, random_state=45)\nlog_reg.fit(X, Y)\n#saving the best fit mode\njoblib.dump(log_reg, '.\u002FML_MODEL-linear_regression_huberloss.sav')","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"ImageMetadata:1*MCaWcNP0VfSKr2yBzW9G5A.png":{"__typename":"ImageMetadata","id":"1*MCaWcNP0VfSKr2yBzW9G5A.png","originalHeight":388,"originalWidth":924,"focusPercentX":null,"focusPercentY":null,"alt":null},"Paragraph:409a9719c105_101":{"__typename":"Paragraph","id":"409a9719c105_101","name":"790a","type":"IMG","href":null,"layout":"INSET_CENTER","metadata":{"__ref":"ImageMetadata:1*MCaWcNP0VfSKr2yBzW9G5A.png"},"text":"","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:409a9719c105_102":{"__typename":"Paragraph","id":"409a9719c105_102","name":"80eb","type":"P","href":null,"layout":null,"metadata":null,"text":"Compared to square loss, model tried to fit to the existing train data, value started to increase for the dates for which we can see increase in mean page views.","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:409a9719c105_103":{"__typename":"Paragraph","id":"409a9719c105_103","name":"df05","type":"P","href":null,"layout":null,"metadata":null,"text":"Data with limited features, can be best fit using Tree based classifiers and hence, we will be fitting tree based classifiers to check the model performance.","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:409a9719c105_104":{"__typename":"Paragraph","id":"409a9719c105_104","name":"d865","type":"P","href":null,"layout":null,"metadata":null,"text":"ML Modeling : Tree Based Methods","hasDropCap":null,"dropCapImage":null,"markups":[{"__typename":"Markup","type":"STRONG","start":0,"end":32,"href":null,"anchorType":null,"userId":null,"linkMetadata":null},{"__typename":"Markup","type":"EM","start":0,"end":32,"href":null,"anchorType":null,"userId":null,"linkMetadata":null}],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:409a9719c105_105":{"__typename":"Paragraph","id":"409a9719c105_105","name":"f90f","type":"ULI","href":null,"layout":null,"metadata":null,"text":"Decision Tree :","hasDropCap":null,"dropCapImage":null,"markups":[{"__typename":"Markup","type":"STRONG","start":0,"end":15,"href":null,"anchorType":null,"userId":null,"linkMetadata":null},{"__typename":"Markup","type":"EM","start":0,"end":15,"href":null,"anchorType":null,"userId":null,"linkMetadata":null}],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:409a9719c105_106":{"__typename":"Paragraph","id":"409a9719c105_106","name":"1382","type":"P","href":null,"layout":null,"metadata":null,"text":"With Decision Tree being the simplest tree based method, we will fit the model on our data considering selected lag windows.","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:409a9719c105_107":{"__typename":"Paragraph","id":"409a9719c105_107","name":"ad8c","type":"PRE","href":null,"layout":null,"metadata":null,"text":"#preparing data for test run\nX = np.log1p(history.iloc[:, -best_window:])\n#staking it with page features\nX = np.hstack((X_pagename, X))","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:409a9719c105_108":{"__typename":"Paragraph","id":"409a9719c105_108","name":"bc5b","type":"PRE","href":null,"layout":null,"metadata":null,"text":"#fitting a RF Regressor model with best parameters\ndt_regressor = DecisionTreeRegressor(max_depth = best_depth,\n               min_samples_split = best_split, random_state=45)\ndt_regressor.fit(X, Y)","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:409a9719c105_109":{"__typename":"Paragraph","id":"409a9719c105_109","name":"938f","type":"PRE","href":null,"layout":null,"metadata":null,"text":"#saving the model\njoblib.dump(dt_regressor, '.\u002FML_MODEL-decisiontree_regressor.sav')","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"ImageMetadata:1*4VwSBBB3DJQopDjDChnCwA.png":{"__typename":"ImageMetadata","id":"1*4VwSBBB3DJQopDjDChnCwA.png","originalHeight":386,"originalWidth":893,"focusPercentX":null,"focusPercentY":null,"alt":null},"Paragraph:409a9719c105_110":{"__typename":"Paragraph","id":"409a9719c105_110","name":"a5b8","type":"IMG","href":null,"layout":"INSET_CENTER","metadata":{"__ref":"ImageMetadata:1*4VwSBBB3DJQopDjDChnCwA.png"},"text":"","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:409a9719c105_111":{"__typename":"Paragraph","id":"409a9719c105_111","name":"dc84","type":"P","href":null,"layout":null,"metadata":null,"text":"Clearly, we can see that the model performance is far better in Decision Tree compared to that of previous models that we saw.","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:409a9719c105_112":{"__typename":"Paragraph","id":"409a9719c105_112","name":"1384","type":"ULI","href":null,"layout":null,"metadata":null,"text":"AdaBoost Regressor :","hasDropCap":null,"dropCapImage":null,"markups":[{"__typename":"Markup","type":"STRONG","start":0,"end":20,"href":null,"anchorType":null,"userId":null,"linkMetadata":null},{"__typename":"Markup","type":"EM","start":0,"end":20,"href":null,"anchorType":null,"userId":null,"linkMetadata":null}],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:409a9719c105_113":{"__typename":"Paragraph","id":"409a9719c105_113","name":"d604","type":"P","href":null,"layout":null,"metadata":null,"text":"With the best decision tree that we obtain from above technique, we will fit the AdaBoost Regressor which used the decision tree for n number of times so as to reduce variance. Here we minimize square loss.","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:409a9719c105_114":{"__typename":"Paragraph","id":"409a9719c105_114","name":"0ec5","type":"PRE","href":null,"layout":null,"metadata":null,"text":"#preparing data for test run\nX = np.log1p(history.iloc[:, -best_window:])\n#staking it with page features\nX = np.hstack((X_pagename, X))","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:409a9719c105_115":{"__typename":"Paragraph","id":"409a9719c105_115","name":"ee43","type":"PRE","href":null,"layout":null,"metadata":null,"text":"#fitting a RF Regressor model with best parameters\nadaboost = AdaBoostRegressor(base_estimator = best_decision_tree,\n           n_estimators = best_estimators, learning_rate = best_lr,\n           loss='square', random_state=45) \nadaboost.fit(X, Y)","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:409a9719c105_116":{"__typename":"Paragraph","id":"409a9719c105_116","name":"7fb1","type":"PRE","href":null,"layout":null,"metadata":null,"text":"#saving the model\njoblib.dump(adaboost, '.\u002FML_MODEL-adaboost_regressor.sav')","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"ImageMetadata:1*URBkosGwNmcuHoRB3c7Ljw.png":{"__typename":"ImageMetadata","id":"1*URBkosGwNmcuHoRB3c7Ljw.png","originalHeight":389,"originalWidth":914,"focusPercentX":null,"focusPercentY":null,"alt":null},"Paragraph:409a9719c105_117":{"__typename":"Paragraph","id":"409a9719c105_117","name":"564c","type":"IMG","href":null,"layout":"INSET_CENTER","metadata":{"__ref":"ImageMetadata:1*URBkosGwNmcuHoRB3c7Ljw.png"},"text":"","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:409a9719c105_118":{"__typename":"Paragraph","id":"409a9719c105_118","name":"0e9d","type":"P","href":null,"layout":null,"metadata":null,"text":"Performance of AdaBoost is average considering the mean values of the Cross Validation dataset. Compared to Decision Tree, it is comparatively less effective.","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:409a9719c105_119":{"__typename":"Paragraph","id":"409a9719c105_119","name":"4276","type":"P","href":null,"layout":null,"metadata":null,"text":"With Tree based methods are working fine with the data, we can use Ensembles to even further boost the performance.","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:409a9719c105_120":{"__typename":"Paragraph","id":"409a9719c105_120","name":"9026","type":"P","href":null,"layout":null,"metadata":null,"text":"ML Modeling : Ensembles","hasDropCap":null,"dropCapImage":null,"markups":[{"__typename":"Markup","type":"STRONG","start":0,"end":23,"href":null,"anchorType":null,"userId":null,"linkMetadata":null},{"__typename":"Markup","type":"EM","start":0,"end":23,"href":null,"anchorType":null,"userId":null,"linkMetadata":null}],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:409a9719c105_121":{"__typename":"Paragraph","id":"409a9719c105_121","name":"3eeb","type":"ULI","href":null,"layout":null,"metadata":null,"text":"Random Forest (RF)","hasDropCap":null,"dropCapImage":null,"markups":[{"__typename":"Markup","type":"STRONG","start":0,"end":18,"href":null,"anchorType":null,"userId":null,"linkMetadata":null},{"__typename":"Markup","type":"EM","start":0,"end":18,"href":null,"anchorType":null,"userId":null,"linkMetadata":null}],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:409a9719c105_122":{"__typename":"Paragraph","id":"409a9719c105_122","name":"90ee","type":"P","href":null,"layout":null,"metadata":null,"text":"Modeling of Random Forest will be carried out with multiple high variance models so as to reduce overall variance of the model.","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:409a9719c105_123":{"__typename":"Paragraph","id":"409a9719c105_123","name":"87bd","type":"P","href":null,"layout":null,"metadata":null,"text":"We did Randomized search for this modeling, which found the best parameters for the model","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:409a9719c105_124":{"__typename":"Paragraph","id":"409a9719c105_124","name":"e1d1","type":"PRE","href":null,"layout":null,"metadata":null,"text":"#preparing data for test run\nX = np.log1p(history.iloc[:, -best_window:])\n#staking it with page features\nX = np.hstack((X_pagename, X))","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:409a9719c105_125":{"__typename":"Paragraph","id":"409a9719c105_125","name":"3212","type":"PRE","href":null,"layout":null,"metadata":null,"text":"randomforest = RandomForestRegressor(n_estimators = best_estimator,\n               max_depth = best_depth,\n               min_samples_split = best_split,\n               n_jobs=-1, random_state=45)\nrandomforest.fit(X, Y)\n#saving the best fit mode\nimport joblib\njoblib.dump(randomforest, '.\u002FML_MODEL-randomforest_regression.sav')","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"ImageMetadata:1*io1QacBQ7eHEu975CxCB2w.png":{"__typename":"ImageMetadata","id":"1*io1QacBQ7eHEu975CxCB2w.png","originalHeight":382,"originalWidth":915,"focusPercentX":null,"focusPercentY":null,"alt":null},"Paragraph:409a9719c105_126":{"__typename":"Paragraph","id":"409a9719c105_126","name":"3030","type":"IMG","href":null,"layout":"INSET_CENTER","metadata":{"__ref":"ImageMetadata:1*io1QacBQ7eHEu975CxCB2w.png"},"text":"","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:409a9719c105_127":{"__typename":"Paragraph","id":"409a9719c105_127","name":"54af","type":"P","href":null,"layout":null,"metadata":null,"text":"RF model tries to get close to the actual values in the initial run but eventually predicts the page views linearly as seen above.","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:409a9719c105_128":{"__typename":"Paragraph","id":"409a9719c105_128","name":"5981","type":"ULI","href":null,"layout":null,"metadata":null,"text":"XGBoost","hasDropCap":null,"dropCapImage":null,"markups":[{"__typename":"Markup","type":"STRONG","start":0,"end":7,"href":null,"anchorType":null,"userId":null,"linkMetadata":null},{"__typename":"Markup","type":"EM","start":0,"end":7,"href":null,"anchorType":null,"userId":null,"linkMetadata":null}],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:409a9719c105_129":{"__typename":"Paragraph","id":"409a9719c105_129","name":"0ab5","type":"P","href":null,"layout":null,"metadata":null,"text":"Now, we will model with High Bias model with XGBoost Technique.","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:409a9719c105_130":{"__typename":"Paragraph","id":"409a9719c105_130","name":"c75a","type":"PRE","href":null,"layout":null,"metadata":null,"text":"#preparing data for test run\nX = np.log1p(history.iloc[:, -best_window:])\n#staking it with page features\nX = np.hstack((X_pagename, X))","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:409a9719c105_131":{"__typename":"Paragraph","id":"409a9719c105_131","name":"5c75","type":"PRE","href":null,"layout":null,"metadata":null,"text":"xgboost = xgb.XGBRegressor(objective = 'reg:squarederror',\n          n_estimators = best_estimators, \n          max_depth = best_depth, \n          learning_rate = best_learning_rate, \n          colsample_bytree = best_colsample_bytree, \n          n_jobs=-1, random_state=45)\nxgboost.fit(X, Y)\n#saving the best fit mode\njoblib.dump(xgboost, '.\u002FML_MODEL-xgboost_regressor.sav')","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"ImageMetadata:1*X5kcLyP8YWzersIzYg197Q.png":{"__typename":"ImageMetadata","id":"1*X5kcLyP8YWzersIzYg197Q.png","originalHeight":373,"originalWidth":914,"focusPercentX":null,"focusPercentY":null,"alt":null},"Paragraph:409a9719c105_132":{"__typename":"Paragraph","id":"409a9719c105_132","name":"3b9c","type":"IMG","href":null,"layout":"INSET_CENTER","metadata":{"__ref":"ImageMetadata:1*X5kcLyP8YWzersIzYg197Q.png"},"text":"","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:409a9719c105_133":{"__typename":"Paragraph","id":"409a9719c105_133","name":"21d8","type":"P","href":null,"layout":null,"metadata":null,"text":"Over forecasting can be easily seen on the CV data with XGBoost Modeling. Also, the mean values of page views are also predicted to be very high but comparing these values with the mean page view distribution, the nature of the actual observations are maintained in this.","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:409a9719c105_134":{"__typename":"Paragraph","id":"409a9719c105_134","name":"13b6","type":"ULI","href":null,"layout":null,"metadata":null,"text":"ML Modeling : Overall Models Performances","hasDropCap":null,"dropCapImage":null,"markups":[{"__typename":"Markup","type":"STRONG","start":0,"end":41,"href":null,"anchorType":null,"userId":null,"linkMetadata":null},{"__typename":"Markup","type":"EM","start":0,"end":41,"href":null,"anchorType":null,"userId":null,"linkMetadata":null}],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:409a9719c105_135":{"__typename":"Paragraph","id":"409a9719c105_135","name":"ee36","type":"P","href":null,"layout":null,"metadata":null,"text":"Tabulating the performance of each of ML model on Cross Validation data as well on actual Test data. Kaggle score for the Test data is also added.","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"ImageMetadata:1*z5EtWLEBU_JeMKlfE63sbw.png":{"__typename":"ImageMetadata","id":"1*z5EtWLEBU_JeMKlfE63sbw.png","originalHeight":204,"originalWidth":737,"focusPercentX":null,"focusPercentY":null,"alt":null},"Paragraph:409a9719c105_136":{"__typename":"Paragraph","id":"409a9719c105_136","name":"556c","type":"IMG","href":null,"layout":"INSET_CENTER","metadata":{"__ref":"ImageMetadata:1*z5EtWLEBU_JeMKlfE63sbw.png"},"text":"","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:409a9719c105_137":{"__typename":"Paragraph","id":"409a9719c105_137","name":"106f","type":"BQ","href":null,"layout":null,"metadata":null,"text":"Modeling : DL Modeling","hasDropCap":null,"dropCapImage":null,"markups":[{"__typename":"Markup","type":"STRONG","start":0,"end":22,"href":null,"anchorType":null,"userId":null,"linkMetadata":null},{"__typename":"Markup","type":"EM","start":0,"end":22,"href":null,"anchorType":null,"userId":null,"linkMetadata":null}],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:409a9719c105_138":{"__typename":"Paragraph","id":"409a9719c105_138","name":"a20f","type":"P","href":null,"layout":null,"metadata":null,"text":"With the trending Deep Learning modeling, we can try to find the best solution possible for this time series problem. As time series is a data comprising of series of dependent values, we can make use concept of RNNs to build the modeling. Also, treating this as 1-Dimensional array, we can also build the CNN modeling for the data.","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:409a9719c105_139":{"__typename":"Paragraph","id":"409a9719c105_139","name":"a0fb","type":"ULI","href":null,"layout":null,"metadata":null,"text":"DL Modeling : Simple DNN","hasDropCap":null,"dropCapImage":null,"markups":[{"__typename":"Markup","type":"STRONG","start":0,"end":24,"href":null,"anchorType":null,"userId":null,"linkMetadata":null},{"__typename":"Markup","type":"EM","start":0,"end":24,"href":null,"anchorType":null,"userId":null,"linkMetadata":null}],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:409a9719c105_140":{"__typename":"Paragraph","id":"409a9719c105_140","name":"c4db","type":"PRE","href":null,"layout":null,"metadata":null,"text":"#simple DNN model\ndef dense_model(shape, print_summary=False):\n  model = Sequential()\n  model.add(Dense(512, activation='tanh', input_shape=(shape, )))\n  model.add(Dense(128, activation='tanh'))\n  model.add(Dense(64, activation='tanh'))\n  model.add(Dense(8, activation='tanh'))\n  model.add(Dense(1))\n  model.compile(loss='mean_squared_error', \n                optimizer='adam', metrics=[tf_smape])\n  return model","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:409a9719c105_141":{"__typename":"Paragraph","id":"409a9719c105_141","name":"d89f","type":"PRE","href":null,"layout":null,"metadata":null,"text":"#making the train data\nX = np.log1p(X_timeseries.iloc[:,-best_window-1:-1])\nY = np.log1p(X_timeseries.iloc[:,-1])\n \n#fitting model with best parameters\nmodel = dense_model(best_window, print_summary=True)\nmodel.fit(X, Y, batch_size=batch, epochs=epoch, verbose=1)\n \n#save the model weights\nmy_model = model.to_json()\nwith open(\"dnn_model.json\", \"w\") as json_file:\n  json_file.write(my_model)\nmodel.save_weights(\"dnn_model_weights.h5\")","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:409a9719c105_142":{"__typename":"Paragraph","id":"409a9719c105_142","name":"0622","type":"P","href":null,"layout":null,"metadata":null,"text":"With the best lagged window, we can train the simple DNN model.","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"ImageMetadata:1*m7mYl1i3xPsM4bANgevKmg.png":{"__typename":"ImageMetadata","id":"1*m7mYl1i3xPsM4bANgevKmg.png","originalHeight":576,"originalWidth":639,"focusPercentX":null,"focusPercentY":null,"alt":null},"Paragraph:409a9719c105_143":{"__typename":"Paragraph","id":"409a9719c105_143","name":"f481","type":"IMG","href":null,"layout":"INSET_CENTER","metadata":{"__ref":"ImageMetadata:1*m7mYl1i3xPsM4bANgevKmg.png"},"text":"Fitting DNN model with train data","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"ImageMetadata:1*JDoQTEYxN3eqkLuDoSfM8g.png":{"__typename":"ImageMetadata","id":"1*JDoQTEYxN3eqkLuDoSfM8g.png","originalHeight":389,"originalWidth":916,"focusPercentX":null,"focusPercentY":null,"alt":null},"Paragraph:409a9719c105_144":{"__typename":"Paragraph","id":"409a9719c105_144","name":"cb2d","type":"IMG","href":null,"layout":"INSET_CENTER","metadata":{"__ref":"ImageMetadata:1*JDoQTEYxN3eqkLuDoSfM8g.png"},"text":"","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:409a9719c105_145":{"__typename":"Paragraph","id":"409a9719c105_145","name":"f652","type":"P","href":null,"layout":null,"metadata":null,"text":"Model seems to be over-fitting to the training data. This over-fitting can be minimized with the help of hyper-parameter tuning of each of the layers of the model.","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:409a9719c105_146":{"__typename":"Paragraph","id":"409a9719c105_146","name":"f835","type":"ULI","href":null,"layout":null,"metadata":null,"text":"DL Modeling : Modeling with LSTMs","hasDropCap":null,"dropCapImage":null,"markups":[{"__typename":"Markup","type":"STRONG","start":0,"end":33,"href":null,"anchorType":null,"userId":null,"linkMetadata":null},{"__typename":"Markup","type":"EM","start":0,"end":33,"href":null,"anchorType":null,"userId":null,"linkMetadata":null}],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:409a9719c105_147":{"__typename":"Paragraph","id":"409a9719c105_147","name":"d8b4","type":"P","href":null,"layout":null,"metadata":null,"text":"Long Short Term Memory (LSTMs) are the Deep Neural Network blocks where the sequence information can be preserved for that instance. Here, page views for article being the time dependent values, we can make use of LSTMs for our modeling.","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:409a9719c105_148":{"__typename":"Paragraph","id":"409a9719c105_148","name":"f725","type":"ULI","href":null,"layout":null,"metadata":null,"text":"One Layered LSTM model","hasDropCap":null,"dropCapImage":null,"markups":[{"__typename":"Markup","type":"EM","start":0,"end":22,"href":null,"anchorType":null,"userId":null,"linkMetadata":null}],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:409a9719c105_149":{"__typename":"Paragraph","id":"409a9719c105_149","name":"7d4b","type":"PRE","href":null,"layout":null,"metadata":null,"text":"def lstm(shape, print_summary=False):\n    model = Sequential()\n    model.add(LSTM(64, activation='tanh', \n              return_sequences=True, input_shape=(shape, 1)))\n    model.add(LSTM(64, activation='tanh'))\n    model.add(Dropout(0.5))\n    #model.add(Flatten())\n    model.add(Dense(1))\n    model.compile(loss='mean_squared_error', \n                  optimizer='adam', metrics=[tf_smape])\n    return model","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:409a9719c105_150":{"__typename":"Paragraph","id":"409a9719c105_150","name":"ec45","type":"PRE","href":null,"layout":null,"metadata":null,"text":"#fiting model with best parameters\nX = np.log1p(X_timeseries.iloc[:,-best_window-1:-1])\nr, c = X.shape\nX = np.array(X).reshape((r, c, 1))\nY = np.log1p(X_timeseries.iloc[:,-1])\n \n#fitting model wth best parameters\nclear_session()\nmodel = lstm(best_window, print_summary=True)\nmodel.fit(X, Y, batch_size=batch, epochs=epoch, verbose=1)\n \n#save the model weights\nmy_model = model.to_json()\nwith open(\"lstm_model.json\", \"w\") as json_file:\n  json_file.write(my_model)\nmodel.save_weights(\"lstm_model_weights.h5\")","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:409a9719c105_151":{"__typename":"Paragraph","id":"409a9719c105_151","name":"0c5b","type":"P","href":null,"layout":null,"metadata":null,"text":"Fitting the model with best lagged data, to test the performance on CV data.","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"ImageMetadata:1*szT2Dz4xT2LC0E9aLYjlpA.png":{"__typename":"ImageMetadata","id":"1*szT2Dz4xT2LC0E9aLYjlpA.png","originalHeight":579,"originalWidth":668,"focusPercentX":null,"focusPercentY":null,"alt":null},"Paragraph:409a9719c105_152":{"__typename":"Paragraph","id":"409a9719c105_152","name":"f3bf","type":"IMG","href":null,"layout":"INSET_CENTER","metadata":{"__ref":"ImageMetadata:1*szT2Dz4xT2LC0E9aLYjlpA.png"},"text":"","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"ImageMetadata:1*Q0BAKsL4euEsremHNmW9OA.png":{"__typename":"ImageMetadata","id":"1*Q0BAKsL4euEsremHNmW9OA.png","originalHeight":395,"originalWidth":918,"focusPercentX":null,"focusPercentY":null,"alt":null},"Paragraph:409a9719c105_153":{"__typename":"Paragraph","id":"409a9719c105_153","name":"5595","type":"IMG","href":null,"layout":"INSET_CENTER","metadata":{"__ref":"ImageMetadata:1*Q0BAKsL4euEsremHNmW9OA.png"},"text":"","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:409a9719c105_154":{"__typename":"Paragraph","id":"409a9719c105_154","name":"f381","type":"P","href":null,"layout":null,"metadata":null,"text":"The data was under-fitting for the initial time stamps, but later was able to match up with the page view distribution. Let us understand how the same LSTMs work when we increase the LSTM layer in the model,","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:409a9719c105_155":{"__typename":"Paragraph","id":"409a9719c105_155","name":"5256","type":"ULI","href":null,"layout":null,"metadata":null,"text":"Two Layered LSTM Model","hasDropCap":null,"dropCapImage":null,"markups":[{"__typename":"Markup","type":"EM","start":0,"end":22,"href":null,"anchorType":null,"userId":null,"linkMetadata":null}],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:409a9719c105_156":{"__typename":"Paragraph","id":"409a9719c105_156","name":"f4fc","type":"P","href":null,"layout":null,"metadata":null,"text":"we will be using early stopping for these models by increasing the epochs for which the model is going to repeat itself.","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:409a9719c105_157":{"__typename":"Paragraph","id":"409a9719c105_157","name":"f359","type":"PRE","href":null,"layout":null,"metadata":null,"text":"from tensorflow.keras.callbacks import EarlyStopping\ndl_stopping = EarlyStopping(monitor='tf_smape', patience=3)","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:409a9719c105_158":{"__typename":"Paragraph","id":"409a9719c105_158","name":"897a","type":"PRE","href":null,"layout":null,"metadata":null,"text":"def complex_lstm(shape, print_summary=False):\n    model = Sequential()\n    model.add(LSTM(64, activation='tanh', \n              return_sequences=True, input_shape=(shape, 1)))\n    model.add(LSTM(64, activation='tanh', return_sequences=True))\n    model.add(Dropout(0.5))\n    model.add(LSTM(8, activation='tanh'))\n    model.add(Dropout(0.5))\n    model.add(Dense(1))\n    model.compile(loss='mean_squared_error', \n                  optimizer='adam', metrics=[tf_smape])\n    return model","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:409a9719c105_159":{"__typename":"Paragraph","id":"409a9719c105_159","name":"737a","type":"PRE","href":null,"layout":null,"metadata":null,"text":"#fiting model with best parameters\nX = np.log1p(X_timeseries.iloc[:,-best_window-1:-1])\nr, c = X.shape\nX = np.array(X).reshape((r, c, 1))\nY = np.log1p(X_timeseries.iloc[:,-1])\n \n#fitting model wth best parameters\nmodel = complex_lstm(best_window, print_summary=True)\nmodel.fit(X, Y, batch_size=batch, epochs=deep_epoch, \\\n          verbose=1, callbacks=[dl_stopping])\n \n#save the model weights\nmy_model = model.to_json()\nwith open(\"complex_lstm_model.json\", \"w\") as json_file:\n  json_file.write(my_model)\nmodel.save_weights(\"complex_lstm_model_weights.h5\")","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"ImageMetadata:1*UoYgFVdI7PbjIZ0GU48Sdw.png":{"__typename":"ImageMetadata","id":"1*UoYgFVdI7PbjIZ0GU48Sdw.png","originalHeight":434,"originalWidth":647,"focusPercentX":null,"focusPercentY":null,"alt":null},"Paragraph:409a9719c105_160":{"__typename":"Paragraph","id":"409a9719c105_160","name":"546a","type":"IMG","href":null,"layout":"INSET_CENTER","metadata":{"__ref":"ImageMetadata:1*UoYgFVdI7PbjIZ0GU48Sdw.png"},"text":"","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"ImageMetadata:1*KnZHH2TrzWw-XBzTIx9bnw.png":{"__typename":"ImageMetadata","id":"1*KnZHH2TrzWw-XBzTIx9bnw.png","originalHeight":384,"originalWidth":912,"focusPercentX":null,"focusPercentY":null,"alt":null},"Paragraph:409a9719c105_161":{"__typename":"Paragraph","id":"409a9719c105_161","name":"4769","type":"IMG","href":null,"layout":"INSET_CENTER","metadata":{"__ref":"ImageMetadata:1*KnZHH2TrzWw-XBzTIx9bnw.png"},"text":"","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:409a9719c105_162":{"__typename":"Paragraph","id":"409a9719c105_162","name":"c743","type":"P","href":null,"layout":null,"metadata":null,"text":"Under-fit model performance can be seen from forecasting for CV data.","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:409a9719c105_163":{"__typename":"Paragraph","id":"409a9719c105_163","name":"84f0","type":"ULI","href":null,"layout":null,"metadata":null,"text":"DL Modeling : Modeling with CNNs","hasDropCap":null,"dropCapImage":null,"markups":[{"__typename":"Markup","type":"STRONG","start":0,"end":32,"href":null,"anchorType":null,"userId":null,"linkMetadata":null},{"__typename":"Markup","type":"EM","start":0,"end":32,"href":null,"anchorType":null,"userId":null,"linkMetadata":null}],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:409a9719c105_164":{"__typename":"Paragraph","id":"409a9719c105_164","name":"b363","type":"P","href":null,"layout":null,"metadata":null,"text":"Considering time series data as a 1 dimensional block of array, we can apply Convolution filter so as to extract the features to pass it to the dense layer of CNN model.","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:409a9719c105_165":{"__typename":"Paragraph","id":"409a9719c105_165","name":"8096","type":"PRE","href":null,"layout":null,"metadata":null,"text":"def complex_cnn_model(shape, print_summary=False):\n  model = Sequential()\n  model.add(Conv1D(filters=32, kernel_size=2, padding='same', \\\n                   activation='relu', \n                   kernel_initializer = 'he_uniform',\n                   input_shape=(shape, 1)))\n  model.add(Conv1D(filters=32, kernel_size=2, padding='same', \\\n                   activation='relu', \n                   kernel_initializer = 'he_uniform'))\n  model.add(MaxPooling1D(pool_size=2))\n  model.add(Conv1D(filters=32, kernel_size=2, padding='same', \\\n                   activation='relu', \n                   kernel_initializer = 'he_uniform'))\n  model.add(Conv1D(filters=32, kernel_size=2, \\\n                   activation='relu', \n                   kernel_initializer = 'he_uniform'))\n  model.add(MaxPooling1D(pool_size=2))\n  model.add(Flatten())\n  model.add(Dense(32, activation='relu'))\n  model.add(Dense(1))\n  model.compile(loss='mean_squared_error', \n                optimizer='adam', metrics=[tf_smape])\n  return model","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"ImageMetadata:1*66IW_jKGq4mQmnlGdKFwJA.png":{"__typename":"ImageMetadata","id":"1*66IW_jKGq4mQmnlGdKFwJA.png","originalHeight":1377,"originalWidth":745,"focusPercentX":null,"focusPercentY":null,"alt":null},"Paragraph:409a9719c105_166":{"__typename":"Paragraph","id":"409a9719c105_166","name":"ce4a","type":"IMG","href":null,"layout":"INSET_CENTER","metadata":{"__ref":"ImageMetadata:1*66IW_jKGq4mQmnlGdKFwJA.png"},"text":"","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"ImageMetadata:1*AioQV6rMnuUCovVX6Qls0Q.png":{"__typename":"ImageMetadata","id":"1*AioQV6rMnuUCovVX6Qls0Q.png","originalHeight":398,"originalWidth":906,"focusPercentX":null,"focusPercentY":null,"alt":null},"Paragraph:409a9719c105_167":{"__typename":"Paragraph","id":"409a9719c105_167","name":"a822","type":"IMG","href":null,"layout":"INSET_CENTER","metadata":{"__ref":"ImageMetadata:1*AioQV6rMnuUCovVX6Qls0Q.png"},"text":"","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:409a9719c105_168":{"__typename":"Paragraph","id":"409a9719c105_168","name":"b557","type":"P","href":null,"layout":null,"metadata":null,"text":"Let us merge the two modeling techniques, which is CNN and LSTM to make a new model which can preserve the previous values and also extract the features with convolution filter.","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:409a9719c105_169":{"__typename":"Paragraph","id":"409a9719c105_169","name":"8297","type":"ULI","href":null,"layout":null,"metadata":null,"text":"DL Modeling : CNN LSTM Model","hasDropCap":null,"dropCapImage":null,"markups":[{"__typename":"Markup","type":"STRONG","start":0,"end":28,"href":null,"anchorType":null,"userId":null,"linkMetadata":null},{"__typename":"Markup","type":"EM","start":0,"end":28,"href":null,"anchorType":null,"userId":null,"linkMetadata":null}],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:409a9719c105_170":{"__typename":"Paragraph","id":"409a9719c105_170","name":"8f1a","type":"PRE","href":null,"layout":null,"metadata":null,"text":"def cnn_lstm_model(shape, print_summary=False):\n    model = Sequential()\n    model.add(Conv1D(filters=128, kernel_size=2, activation='tanh',\n              kernel_initializer = 'he_uniform', \n              input_shape=(shape, 1)))\n    model.add(Conv1D(filters=128, kernel_size=2, activation='tanh',\n              kernel_initializer = 'he_uniform'))\n    model.add(MaxPooling1D(pool_size=3))\n    model.add(LSTM(128, activation='tanh', return_sequences=True))\n    model.add(LSTM(128, activation='tanh'))\n    model.add(Dense(64, activation='relu'))\n    model.add(Dropout(0.5))\n    model.add(Dense(8, activation='relu'))\n    model.add(Dropout(0.5))\n    model.add(Dense(1))\n    model.compile(loss='mean_squared_error', \n                  optimizer='adam', metrics=[tf_smape])\n    return model","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:409a9719c105_171":{"__typename":"Paragraph","id":"409a9719c105_171","name":"f9a9","type":"PRE","href":null,"layout":null,"metadata":null,"text":"X = np.log1p(X_timeseries.iloc[:,-best_window-1:-1])\nr, c = X.shape\nX = np.array(X).reshape((r, c, 1))\nY = np.log1p(X_timeseries.iloc[:,-1])\n \n#fitting model wth best parameters\nmodel = cnn_lstm_model(best_window, print_summary=True)\nmodel.fit(X, Y, batch_size=batch, epochs=epoch, verbose=1)\n \n#save the model weights\nmy_model = model.to_json()\nwith open(\"cnn_lstm_model.json\", \"w\") as json_file:\n  json_file.write(my_model)\nmodel.save_weights(\"cnn_lstm_model_weights.h5\")","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"ImageMetadata:1*_WJYYp4LORJiDw-ngASNcg.png":{"__typename":"ImageMetadata","id":"1*_WJYYp4LORJiDw-ngASNcg.png","originalHeight":574,"originalWidth":658,"focusPercentX":null,"focusPercentY":null,"alt":null},"Paragraph:409a9719c105_172":{"__typename":"Paragraph","id":"409a9719c105_172","name":"5fcd","type":"IMG","href":null,"layout":"INSET_CENTER","metadata":{"__ref":"ImageMetadata:1*_WJYYp4LORJiDw-ngASNcg.png"},"text":"","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"ImageMetadata:1*7dfd8IxqwaEzVbityFJmgg.png":{"__typename":"ImageMetadata","id":"1*7dfd8IxqwaEzVbityFJmgg.png","originalHeight":379,"originalWidth":913,"focusPercentX":null,"focusPercentY":null,"alt":null},"Paragraph:409a9719c105_173":{"__typename":"Paragraph","id":"409a9719c105_173","name":"c96a","type":"IMG","href":null,"layout":"INSET_CENTER","metadata":{"__ref":"ImageMetadata:1*7dfd8IxqwaEzVbityFJmgg.png"},"text":"","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:409a9719c105_174":{"__typename":"Paragraph","id":"409a9719c105_174","name":"8eb3","type":"P","href":null,"layout":null,"metadata":null,"text":"Model performance deteriorates as the test time stamps increases.","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:409a9719c105_175":{"__typename":"Paragraph","id":"409a9719c105_175","name":"8e7e","type":"ULI","href":null,"layout":null,"metadata":null,"text":"DL Modeling : Overall Model performances","hasDropCap":null,"dropCapImage":null,"markups":[{"__typename":"Markup","type":"STRONG","start":0,"end":40,"href":null,"anchorType":null,"userId":null,"linkMetadata":null},{"__typename":"Markup","type":"EM","start":0,"end":40,"href":null,"anchorType":null,"userId":null,"linkMetadata":null}],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:409a9719c105_176":{"__typename":"Paragraph","id":"409a9719c105_176","name":"abd2","type":"P","href":null,"layout":null,"metadata":null,"text":"Tabulating overall results of each of the DL models, where each of them was tested on cross validation dataset to find the best parameters so as to run the same on actual test data. Test score from Kaggle for few of the models also included in this.","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"ImageMetadata:1*wJtdiY1wp5uv0u3StRJlZw.png":{"__typename":"ImageMetadata","id":"1*wJtdiY1wp5uv0u3StRJlZw.png","originalHeight":176,"originalWidth":570,"focusPercentX":null,"focusPercentY":null,"alt":null},"Paragraph:409a9719c105_177":{"__typename":"Paragraph","id":"409a9719c105_177","name":"b565","type":"IMG","href":null,"layout":"INSET_CENTER","metadata":{"__ref":"ImageMetadata:1*wJtdiY1wp5uv0u3StRJlZw.png"},"text":"","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:409a9719c105_178":{"__typename":"Paragraph","id":"409a9719c105_178","name":"4a39","type":"BQ","href":null,"layout":null,"metadata":null,"text":"Conclusion and Areas of Improvement :","hasDropCap":null,"dropCapImage":null,"markups":[{"__typename":"Markup","type":"STRONG","start":0,"end":37,"href":null,"anchorType":null,"userId":null,"linkMetadata":null}],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:409a9719c105_179":{"__typename":"Paragraph","id":"409a9719c105_179","name":"0bce","type":"P","href":null,"layout":null,"metadata":null,"text":"Concluding the complete analysis done on this problem, we can say that, both ML and DL modeling with basic feature engineering give us considerably better results. Adding features extracted from Page Name, can certainly gave a good boost to ML modeling.","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:409a9719c105_180":{"__typename":"Paragraph","id":"409a9719c105_180","name":"af6b","type":"P","href":null,"layout":null,"metadata":null,"text":"All above models, can be improved with intensive hyper-parameter search keeping in mind the impact of Over-fitting and Under-fitting. For DL Models, we can also do hyper-parameter search for each of the layer parameters. Also, regularization techniques can be implemented so as to to keep the weights optimal for better performance of the model.","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:409a9719c105_181":{"__typename":"Paragraph","id":"409a9719c105_181","name":"cf42","type":"P","href":null,"layout":null,"metadata":null,"text":"For further improvement, we can also add new features like, day of the week, seasonal holidays etc.","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:409a9719c105_182":{"__typename":"Paragraph","id":"409a9719c105_182","name":"fdaa","type":"BQ","href":null,"layout":null,"metadata":null,"text":"References :","hasDropCap":null,"dropCapImage":null,"markups":[{"__typename":"Markup","type":"STRONG","start":0,"end":12,"href":null,"anchorType":null,"userId":null,"linkMetadata":null},{"__typename":"Markup","type":"EM","start":0,"end":12,"href":null,"anchorType":null,"userId":null,"linkMetadata":null}],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:409a9719c105_183":{"__typename":"Paragraph","id":"409a9719c105_183","name":"0bbd","type":"MIXTAPE_EMBED","href":null,"layout":null,"metadata":null,"text":"Web Traffic Time Series Forecasting\nForecast future traffic to Wikipedia pageswww.kaggle.com","hasDropCap":null,"dropCapImage":null,"markups":[{"__typename":"Markup","type":"A","start":0,"end":92,"href":"https:\u002F\u002Fwww.kaggle.com\u002Fc\u002Fweb-traffic-time-series-forecasting\u002Foverview","anchorType":"LINK","userId":null,"linkMetadata":null},{"__typename":"Markup","type":"STRONG","start":0,"end":35,"href":null,"anchorType":null,"userId":null,"linkMetadata":null},{"__typename":"Markup","type":"EM","start":36,"end":78,"href":null,"anchorType":null,"userId":null,"linkMetadata":null}],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":{"__typename":"MixtapeMetadata","href":"https:\u002F\u002Fwww.kaggle.com\u002Fc\u002Fweb-traffic-time-series-forecasting\u002Foverview","mediaResource":{"__typename":"MediaResource","mediumCatalog":null},"thumbnailImageId":"0*W2cKggfngKC2vS6w"}},"UserViewerEdge:userId:e45ee5b3577e-viewerId:15c623089445":{"__typename":"UserViewerEdge","id":"userId:e45ee5b3577e-viewerId:15c623089445","isMuting":false},"PostViewerEdge:postId:6c916c7f5d85-viewerId:15c623089445":{"__typename":"PostViewerEdge","shouldIndexPostForExternalSearch":true,"id":"postId:6c916c7f5d85-viewerId:15c623089445"},"Tag:machine-learning":{"__typename":"Tag","id":"machine-learning","displayTitle":"Machine Learning","normalizedTagSlug":"machine-learning"},"Tag:time-series-forecasting":{"__typename":"Tag","id":"time-series-forecasting","displayTitle":"Time Series Forecasting","normalizedTagSlug":"time-series-forecasting"},"Tag:kaggle-competition":{"__typename":"Tag","id":"kaggle-competition","displayTitle":"Kaggle Competition","normalizedTagSlug":"kaggle-competition"},"Tag:python3":{"__typename":"Tag","id":"python3","displayTitle":"Python3","normalizedTagSlug":"python3"},"Tag:deep-learning":{"__typename":"Tag","id":"deep-learning","displayTitle":"Deep Learning","normalizedTagSlug":"deep-learning"},"Post:6c916c7f5d85":{"__typename":"Post","id":"6c916c7f5d85","collection":null,"content({\"postMeteringOptions\":{\"referrer\":\"https:\u002F\u002Fwww.google.com\u002F\"}})":{"__typename":"PostContent","isLockedPreviewOnly":false,"bodyModel":{"__typename":"RichText","sections":[{"__typename":"Section","name":"e371","startIndex":0,"textLayout":null,"imageLayout"