ushiklade27.medium.com"}},"hasSubdomain":true,"verifications":{"__typename":"VerifiedInfo","isBookAuthor":false},"socialStats":{"__typename":"SocialStats","followerCount":36,"followingCount":5,"collectionFollowingCount":0},"bio":"Data Scientist Engineer. ML\u002FAI Enthusiastic.","membership":null,"allowNotes":true,"viewerEdge":{"__ref":"UserViewerEdge:userId:e45ee5b3577e-viewerId:15c623089445"},"twitterScreenName":""},"Paragraph:409a9719c105_0":{"__typename":"Paragraph","id":"409a9719c105_0","name":"6c54","type":"H3","href":null,"layout":null,"metadata":null,"text":"Web Traffic Time Series Forecasting","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"ImageMetadata:1*Q70XIppoaFSSmAKkSTmq-w.png":{"__typename":"ImageMetadata","id":"1*Q70XIppoaFSSmAKkSTmq-w.png","originalHeight":1350,"originalWidth":2160,"focusPercentX":null,"focusPercentY":null,"alt":null},"Paragraph:409a9719c105_1":{"__typename":"Paragraph","id":"409a9719c105_1","name":"a041","type":"IMG","href":null,"layout":"FULL_WIDTH","metadata":{"__ref":"ImageMetadata:1*Q70XIppoaFSSmAKkSTmq-w.png"},"text":"","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:409a9719c105_2":{"__typename":"Paragraph","id":"409a9719c105_2","name":"678f","type":"BQ","href":null,"layout":null,"metadata":null,"text":"Introduction and Overview of the Problem","hasDropCap":null,"dropCapImage":null,"markups":[{"__typename":"Markup","type":"STRONG","start":0,"end":40,"href":null,"anchorType":null,"userId":null,"linkMetadata":null}],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:409a9719c105_3":{"__typename":"Paragraph","id":"409a9719c105_3","name":"b8ec","type":"P","href":null,"layout":null,"metadata":null,"text":"Web Traffic Forecasting is a problem of forecasting the future page views that we can receive for given Wikipedia articles. The prediction to be carried out based on the available time series data. The data for this problem can be downloaded from here.","hasDropCap":null,"dropCapImage":null,"markups":[{"__typename":"Markup","type":"A","start":247,"end":251,"href":"https:\u002F\u002Fwww.kaggle.com\u002Fc\u002Fweb-traffic-time-series-forecasting\u002Fdata","anchorType":"LINK","userId":null,"linkMetadata":null}],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"ImageMetadata:1*ZFJjARAbXLKKC7Kjv8q9wQ.jpeg":{"__typename":"ImageMetadata","id":"1*ZFJjARAbXLKKC7Kjv8q9wQ.jpeg","originalHeight":216,"originalWidth":327,"focusPercentX":null,"focusPercentY":null,"alt":null},"Paragraph:409a9719c105_4":{"__typename":"Paragraph","id":"409a9719c105_4","name":"4634","type":"IMG","href":null,"layout":"INSET_CENTER","metadata":{"__ref":"ImageMetadata:1*ZFJjARAbXLKKC7Kjv8q9wQ.jpeg"},"text":"Forecasting Page Views of articles","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:409a9719c105_5":{"__typename":"Paragraph","id":"409a9719c105_5","name":"0a20","type":"P","href":null,"layout":null,"metadata":null,"text":"In this problem, we are provided with Page Views of approx. 145k Wikipedia articles. Our goal is to forecast the Page Views for these articles for future timestamps. Let’s understand about the data from Exploratory Data Analysis (EDA).","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:409a9719c105_6":{"__typename":"Paragraph","id":"409a9719c105_6","name":"b869","type":"BQ","href":null,"layout":null,"metadata":null,"text":"Exploratory Data Analysis (EDA) :","hasDropCap":null,"dropCapImage":null,"markups":[{"__typename":"Markup","type":"STRONG","start":0,"end":33,"href":null,"anchorType":null,"userId":null,"linkMetadata":null},{"__typename":"Markup","type":"EM","start":0,"end":33,"href":null,"anchorType":null,"userId":null,"linkMetadata":null}],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:409a9719c105_7":{"__typename":"Paragraph","id":"409a9719c105_7","name":"7335","type":"P","href":null,"layout":null,"metadata":null,"text":"With Train_*.csv being the base file in this problem, we are given information about Page Name and it’s Page View for given dates.","hasDropCap":null,"dropCapImage":null,"markups":[{"__typename":"Markup","type":"STRONG","start":5,"end":16,"href":null,"anchorType":null,"userId":null,"linkMetadata":null},{"__typename":"Markup","type":"EM","start":5,"end":16,"href":null,"anchorType":null,"userId":null,"linkMetadata":null}],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"ImageMetadata:1*S05PDbGcWJguyW3EGw_mMw.png":{"__typename":"ImageMetadata","id":"1*S05PDbGcWJguyW3EGw_mMw.png","originalHeight":224,"originalWidth":605,"focusPercentX":null,"focusPercentY":null,"alt":null},"Paragraph:409a9719c105_8":{"__typename":"Paragraph","id":"409a9719c105_8","name":"446d","type":"IMG","href":null,"layout":"INSET_CENTER","metadata":{"__ref":"ImageMetadata:1*S05PDbGcWJguyW3EGw_mMw.png"},"text":"Train data with Page Name and it’s respective page views for mentioned date","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:409a9719c105_9":{"__typename":"Paragraph","id":"409a9719c105_9","name":"f462","type":"P","href":null,"layout":null,"metadata":null,"text":"From above, we can see that the Page Name can become important feature in understanding the data distribution, as page name contains ;","hasDropCap":null,"dropCapImage":null,"markups":[],"codeBlockMetadata":null,"iframe":null,"mixtapeMetadata":null},"Paragraph:409a9719c105_10":{"__typename":"Paragraph","id":"409a9719c105_10","name":"d134","type":"ULI","href":null,"layout":null,"metadata":null,"text":"Source Web Site of that Page along with the Language information (e.g. es.wikipedia.org)","hasDropCap":null,"dropCapImage":null,"markups":[{"__typename":"Markup","type":"S